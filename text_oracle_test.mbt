      None,
      [
        "<text 'hyphen-ated-words-are-not-split-on-hyphe' [] ''>", "<text 'ns' [] ''>",
      ],
    ),
  ]
  for case in cases {
    let (markup, width, justify, overflow, expected) = case
    let text = @rich.Text::from_markup(markup)
    let lines = text.wrap(oracle_console(), width, justify?, overflow?)
    let actual = lines.lines.map(l => l.repr())
    if actual != expected {
      fail(
        "\{markup} width=\{width} \{justify.map(j => j.to_string()).unwrap_or("None")} \{overflow.map(o => o.to_string()).unwrap_or("None")}:\n\{actual.join("\n")}\n\{expected.join("\n")}",
      )
    }
  }
}

