name = "bobzhang/rich"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/bobzhang/rich.mbt"

license = "MIT"

keywords = [ "terminal", "rich", "ansi", "tui", "console" ]

description = "A port of Rich (rich text and beautiful formatting in the terminal) to MoonBit"

preferred_target = "native"

import {
  "bobzhang/pygments@0.2.3",
  "moonbit-community/cmark@0.4.10",
  "moonbitlang/async@0.22.4",
}
