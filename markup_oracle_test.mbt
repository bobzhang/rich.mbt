    ("[a=b=c]x[/a]", "<text 'x' [Span(0, 1, 'a b=c')] ''>"),
    ("[]x", "<text '[]x' [] ''>"),
    (
      "[1]x[/1]", "MarkupError: closing tag '[/1]' at position 4 doesn't match any open tag",
    ),
    (
      "[/ ]x", "MarkupError: closing tag '[/]' at position 0 has nothing to close",
    ),
    (
