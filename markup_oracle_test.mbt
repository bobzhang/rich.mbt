    ),
    ("[red]a\\[b\\]c[/red]", "<text 'a[b\\\\]c' [Span(0, 6, 'red')] ''>"),
    ("[red]\\\\[/red]", "<text '\\\\' [Span(0, 1, 'red')] ''>"),
    ("[red]a\\\\\\[/red]b", "<text 'a\\\\[/red]b' [Span(0, 9, 'red')] ''>"),
    ("no tags \\[at all]", "<text 'no tags [at all]' [] ''>"),
