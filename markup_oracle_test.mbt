    ),
    ("[not bold]x[/not bold]", "<text 'x' [Span(0, 1, 'not bold')] ''>"),
    ("[foo-bar]x[/foo-bar]", "<text 'x' [Span(0, 1, 'foo-bar')] ''>"),
