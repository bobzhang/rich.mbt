///|
test "escape oracle cases" {
  let cases : Array[(String, String, String)] = [
    ("foo[bar]", "foo\\[bar]", "foo[bar]"),
    ("a\\", "a\\\\", "a\\\\"),
    ("a\\\\", "a\\\\", "a\\\\"),
    ("[x][y]", "\\[x]\\[y]", "[x][y]"),
    ("[[a]]", "[\\[a]]", "[[a]]"),
    ("\\[a]", "\\\\\\[a]", "\\[a]"),
    ("[@x]", "\\[@x]", "[@x]"),
    ("[#ab]", "\\[#ab]", "[#ab]"),
    ("C:\\path\\", "C:\\path\\\\", "C:\\path\\\\"),
    ("[a] [/b] [c=d]", "\\[a] \\[/b] \\[c=d]", "[a] [/b] [c=d]"),
    ("[5]", "[5]", "[5]"),
    ("x[1]y", "x[1]y", "x[1]y"),
    ("[A]", "[A]", "[A]"),
    ("[a b]", "\\[a b]", "[a b]"),
    ("\\\\[a]", "\\\\\\\\\\[a]", "\\\\[a]"),
    ("[a", "[a", "[a"),
  ]
  for case in cases {
    assert_eq(@rich.escape(case.0), case.1)
    assert_eq(@rich.render_markup(case.1).plain(), case.2)
  }
}
