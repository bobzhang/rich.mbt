            \n\u{1b}[1;31m              \u{1b}[0m                                                                                      \n\u{1b}[1;31m \u{1b}[0m\u{1b}[1;31m  Markdown  \u{1b}[0m\u{1b}[1;31m \u{1b}[0m\u{1b}[36m# Markdown\u{1b}[0m                                                  \u{1b}[1;4mMarkdown\u{1b}[0m                  \n\u{1b}[1;31m              \u{1b}[0m                                                                                      \n\u{1b}[1;31m              \u{1b}[0m\u{1b}[36mSupports much of the *markdown* \u{1b}[0m            Supports much of the \u{1b}[3mmarkdown\u{1b}[0m \u{1b}[1msyntax\u{1b}[0m!     \n\u{1b}[1;31m              \u{1b}[0m\u{1b}[36m__syntax__!\u{1b}[0m                                                                           \n\u{1b}[1;31m              \u{1b}[0m                                            \u{1b}[1m • \u{1b}[0mHeaders                                \n\u{1b}[1;31m              \u{1b}[0m\u{1b}[36m- Headers\u{1b}[0m                                   \u{1b}[1m • \u{1b}[0mBasic formatting: \u{1b}[1mbold\u{1b}[0m, \u{1b}[3mitalic\u{1b}[0m, \u{1b}[1;36;40mcode\u{1b}[0m   \n\u{1b}[1;31m              \u{1b}[0m\u{1b}[36m- Basic formatting: **bold**, *italic*, \u{1b}[0m    \u{1b}[1m • \u{1b}[0mBlock quotes                           \n\u{1b}[1;31m              \u{1b}[0m\u{1b}[36m`code`\u{1b}[0m                                      \u{1b}[1m • \u{1b}[0mLists, and more...                     \n\u{1b}[1;31m              \u{1b}[0m\u{1b}[36m- Block quotes\u{1b}[0m                                                                        \n\u{1b}[1;31m              \u{1b}[0m\u{1b}[36m- Lists, and more...\u{1b}[0m                                                                  \n\u{1b}[1;31m              \u{1b}[0m\u{1b}[36m    \u{1b}[0m                                                                                  \n\u{1b}[1;31m              \u{1b}[0m                                                                                      \n\u{1b}[1;31m \u{1b}[0m\u{1b}[1;31m   +more!   \u{1b}[0m\u{1b}[1;31m \u{1b}[0mProgress bars, columns, styled logging handler, tracebacks, etc...                    \n\u{1b}[1;31m              \u{1b}[0m                                                                                      \n"

///|
test "card render" {
  let card = @demo.make_test_card()
  let result = render(card)
  let result_lines = result.split("\n").map(l => l.to_owned()).collect()
  let expected_lines = expected.split("\n").map(l => l.to_owned()).collect()
  for i, line in expected_lines {
    if i < result_lines.length() && result_lines[i] != line {
      fail("line \{i} differs:\n\{result_lines[i].escape()}\n\{line.escape()}")
    }
  }
  assert_eq(result, expected)
}
