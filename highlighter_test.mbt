// Port of tests/test_highlighter.py (the parametrized tables are in
// highlighter_upstream_test.mbt, generated by scripts/gen_highlighter_tests.py).

///|
priv enum HighlighterKind {
  Repr
  JSON
  ISO8601
}

///|
/// Highlight `s` and return the spans as `(start, end, style)`.
fn highlight_spans(
  kind : HighlighterKind,
  s : String,
) -> Array[(Int, Int, String)] raise {
  let text = @rich.Text::new(text=s)
  let highlighter : &@rich.Highlighter = match kind {
    Repr => (@rich.ReprHighlighter::new() : &@rich.Highlighter)
    JSON => (@rich.JSONHighlighter::new() : &@rich.Highlighter)
    ISO8601 => (@rich.ISO8601Highlighter::new() : &@rich.Highlighter)
  }
  highlighter.highlight(text)
  text.spans().map(span => (span.start, span.end, span.style.to_string()))
}

///|
test "null highlighter" {
  let highlighter : &@rich.Highlighter = @rich.NullHighlighter::new()
  let text = highlighter.apply("foo 1")
  inspect(text.plain(), content="foo 1")
  inspect(text.spans().length(), content="0")
}

///|
test "apply copies text" {
  let original = @rich.Text::new(text="1 2")
  let highlighter : &@rich.Highlighter = @rich.ReprHighlighter::new()
  let highlighted = highlighter.apply(original)
  inspect(original.spans().length(), content="0")
  inspect(highlighted.spans().length(), content="2")
}

///|
test "highlight_json_with_indent" {
  let json_string =
    #|{
    #|    "name": "apple",
    #|    "count": 1
    #|}
  assert_eq(highlight_spans(JSON, json_string), [
    (0, 1, "json.brace"),
    (6, 12, "json.str"),
    (14, 21, "json.str"),
    (27, 34, "json.str"),
    (36, 37, "json.number"),
    (38, 39, "json.brace"),
    (6, 12, "json.key"),
    (27, 34, "json.key"),
  ])
}

///|
test "highlight_json_string_only" {
  assert_eq(highlight_spans(JSON, "\"abc\""), [(0, 5, "json.str")])
}

///|
test "highlight_json_empty_string_only" {
  assert_eq(highlight_spans(JSON, "\"\""), [(0, 2, "json.str")])
}

///|
test "highlight_json_no_indent" {
  let json_string = "{\"name\": \"apple\", \"count\": 1}"
  assert_eq(highlight_spans(JSON, json_string), [
    (0, 1, "json.brace"),
    (1, 7, "json.str"),
    (9, 16, "json.str"),
    (18, 25, "json.str"),
    (27, 28, "json.number"),
    (28, 29, "json.brace"),
    (1, 7, "json.key"),
    (18, 25, "json.key"),
  ])
}
