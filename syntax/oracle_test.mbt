  )
  let expected : String = "\u{1b}[91;107m#\u{1b}[0m\u{1b}[91;107minclude\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[37;107m<stdio.h>\u{1b}[0m\u{1b}[107m                                                              \u{1b}[0m\n" +
    "\u{1b}[107m                                                                                \u{1b}[0m\n" +
    "\u{1b}[33;107mint\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[36;107mmain\u{1b}[0m\u{1b}[90;107m(\u{1b}[0m\u{1b}[33;107mint\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[90;107margc\u{1b}[0m\u{1b}[90;107m,\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[33;107mchar\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[37;107m*\u{1b}[0m\u{1b}[37;107m*\u{1b}[0m\u{1b}[90;107margv\u{1b}[0m\u{1b}[90;107m)\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[90;107m{\u{1b}[0m\u{1b}[107m                                               \u{1b}[0m\n" +
    "\u{1b}[2;3;37;107m│   \u{1b}[0m\u{1b}[90;107mprintf\u{1b}[0m\u{1b}[90;107m(\u{1b}[0m\u{1b}[36;107m\"\u{1b}[0m\u{1b}[36;107mhello %d\u{1b}[0m\u{1b}[36;107m\\n\u{1b}[0m\u{1b}[36;107m\"\u{1b}[0m\u{1b}[90;107m,\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[90;107margc\u{1b}[0m\u{1b}[90;107m)\u{1b}[0m\u{1b}[90;107m;\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[3;37;107m/* block */\u{1b}[0m\u{1b}[107m                                     \u{1b}[0m\n" +
    "\u{1b}[2;3;37;107m│   \u{1b}[0m\u{1b}[33;107mreturn\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[36;107m0\u{1b}[0m\u{1b}[90;107m;\u{1b}[0m\u{1b}[107m                                                                   \u{1b}[0m\n" +
    "\u{1b}[90;107m}\u{1b}[0m\u{1b}[107m                                                                               \u{1b}[0m\n" +
    "\u{1b}[107m                                                                                \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=80, color_system=Some("standard")),
    expected,
  )
}

