test "oracle 18: rust one-dark {'line_numbers': True, 'highlight_lines': [1, 3], 'start_line': 98} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_rust,
    "rust",
    theme="one-dark",
    line_numbers=true,
    highlight_lines=[1, 3],
    start_line=98,
  )
  let expected : String = "   98 use std::collections::HashMap;              \n" +
    "   99                                             \n" +
    "  100 /// Doc comment                             \n" +
    "  101 fn main() {                                 \n" +
    "  102     let mut map: HashMap<&str, i32> = HashMa\n" +
    "  103     map.insert(\"one\", 1);                   \n" +
    "  104     for (k, v) in &map {                    \n" +
    "  105         println!(\"{}: {}\", k, v);           \n" +
    "  106     }                                       \n" +
    "  107 }                                           \n" +
    "  108                                             \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

