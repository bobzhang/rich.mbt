    "\u{1b}[38;2;187;187;187;48;2;248;248;248m  \u{1b}[0m\u{1b}[48;2;248;248;248m-\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;186;33;33;48;2;248;248;248m\"\u{1b}[0m\u{1b}[38;2;186;33;33;48;2;248;248;248mtwo\u{1b}[0m\u{1b}[38;2;186;33;33;48;2;248;248;248m\"\u{1b}[0m\u{1b}[48;2;248;248;248m           \u{1b}[0m\n" +
    "\u{1b}[1;38;2;0;128;0;48;2;248;248;248mnested\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m:\u{1b}[0m\u{1b}[48;2;248;248;248m             \u{1b}[0m\n" +
    "\u{1b}[38;2;187;187;187;48;2;248;248;248m  \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mnumber\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m:\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[48;2;248;248;248m42\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m  \u{1b}[0m\u{1b}[3;38;2;61;123;123;48;2;248;248;248m# comm\u{1b}[0m\n" +
    "\u{1b}[48;2;248;248;248m                    \u{1b}[0m\n"
