    "\u{1b}[38;5;188;48;5;23m  \u{1b}[0m\u{1b}[38;5;109;48;5;23m\"ok\"\u{1b}[0m\u{1b}[38;5;231;48;5;23m:\u{1b}[0m\u{1b}[38;5;188;48;5;23m \u{1b}[0m\u{1b}[1;38;5;109;48;5;23mtrue\u{1b}[0m\u{1b}[38;5;231;48;5;23m,\u{1b}[0m\u{1b}[48;5;23m                                \u{1b}[0m\n" +
    "\u{1b}[38;5;188;48;5;23m  \u{1b}[0m\u{1b}[38;5;109;48;5;23m\"none\"\u{1b}[0m\u{1b}[38;5;231;48;5;23m:\u{1b}[0m\u{1b}[38;5;188;48;5;23m \u{1b}[0m\u{1b}[1;38;5;109;48;5;23mnull\u{1b}[0m\u{1b}[48;5;23m                               \u{1b}[0m\n" +
