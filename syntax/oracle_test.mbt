    "\u{1b}[100m  \u{1b}[0m\u{1b}[2;100m 99 \u{1b}[0m\u{1b}[1;37;100mWHERE\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[97;100mage\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[1;37;100m>\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[37;100m21\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[1;37;100mAND\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[97;100mname\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[1;37;100mLIKE\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[37;100m'A%'\u{1b}[0m\u{1b}[100m                                         \u{1b}[0m\n" +
    "\u{1b}[100m  \u{1b}[0m\u{1b}[2;100m100 \u{1b}[0m\u{1b}[1;37;100mORDER\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[1;37;100mBY\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[97;100mname\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[1;37;100mDESC\u{1b}[0m\u{1b}[97;100m;\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[3;90;100m-- comment\u{1b}[0m\u{1b}[100m                                            \u{1b}[0m\n" +
    "\u{1b}[100m  \u{1b}[0m\u{1b}[2;100m101 \u{1b}[0m\u{1b}[100m                                                                          \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=80, color_system=Some("standard")),
    expected,
  )
}

