test "oracle 124: go ansi_dark {'indent_guides': True, 'line_numbers': True, 'line_range': (2, 6)} {'width': 80, 'color_system': 'standard'}" {
  let syntax = @syntax.Syntax::new(
    sample_go,
    "go",
    theme="ansi_dark",
    indent_guides=true,
    line_numbers=true,
    line_range=(Some(2), Some(6)),
  )
  let expected : String = "  \u{1b}[2m2 \u{1b}[0m\n" +
    "  \u{1b}[2m3 \u{1b}[0m\u{1b}[94mimport\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[33m\"fmt\"\u{1b}[0m\n" +
    "  \u{1b}[2m4 \u{1b}[0m\n" +
    "  \u{1b}[2m5 \u{1b}[0m\u{1b}[94mfunc\u{1b}[0m\u{1b}[90m \u{1b}[0mmain()\u{1b}[90m \u{1b}[0m{\n" +
    "  \u{1b}[2m6 \u{1b}[0m\u{1b}[2;90m│   \u{1b}[0mch\u{1b}[90m \u{1b}[0m:=\u{1b}[90m \u{1b}[0m\u{1b}[96mmake\u{1b}[0m(\u{1b}[96mchan\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[96mint\u{1b}[0m,\u{1b}[90m \u{1b}[0m\u{1b}[94m3\u{1b}[0m)\n"
  assert_eq(
    oracle_render(syntax, width=80, color_system=Some("standard")),
    expected,
  )
}

///|
test "oracle 125: go ansi_light {'line_range': (3, None), 'highlight_lines': [4]} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_go,
    "go",
    theme="ansi_light",
    line_range=(Some(3), None),
    highlight_lines=[4],
  )
  let expected : String = "import \"fmt\"\n" +
    "\n" +
    "func main() {\n" +
    "    ch := make(chan int, 3)\n" +
    "    fmt.Println(\"hi\", len(ch))\n" +
    "}\n" +
    "\n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

