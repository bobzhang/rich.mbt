test "oracle 21: rust default {'dedent': True, 'line_numbers': True, 'line_range': (None, 4)} {'width': 80, 'color_system': 'standard'}" {
  let syntax = @syntax.Syntax::new(
    sample_rust,
    "rust",
    theme="default",
    dedent=true,
    line_numbers=true,
    line_range=(None, Some(4)),
  )
  let expected : String = "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m 1 \u{1b}[0m\u{1b}[1;32;107muse\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107mstd\u{1b}[0m\u{1b}[30;107m::\u{1b}[0m\u{1b}[30;107mcollections\u{1b}[0m\u{1b}[30;107m::\u{1b}[0m\u{1b}[30;107mHashMap\u{1b}[0m\u{1b}[30;107m;\u{1b}[0m\u{1b}[107m                                             \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m 2 \u{1b}[0m\u{1b}[107m                                                                           \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m 3 \u{1b}[0m\u{1b}[3;31;107m/// Doc comment\u{1b}[0m\u{1b}[107m                                                            \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m 4 \u{1b}[0m\u{1b}[1;32;107mfn\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[34;107mmain\u{1b}[0m\u{1b}[30;107m(\u{1b}[0m\u{1b}[30;107m)\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107m{\u{1b}[0m\u{1b}[107m                                                                \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=80, color_system=Some("standard")),
