    "\u{1b}[48;2;32;48;64m  \u{1b}[0m\u{1b}[38;2;110;118;129;48;2;32;48;64m  \u{1b}[0m\u{1b}[38;2;126;231;135;48;2;32;48;64m\"version\"\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;32;48;64m:\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;32;48;64m \u{1b}[0m\u{1b}[38;2;230;237;243;48;2;32;48;64m[\u{1b}[0m\u{1b}[38;2;165;214;255;48;2;32;48;64m1\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;32;48;64m,\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;32;48;64m \u{1b}[0m\u{1b}[38;2;165;214;255;48;2;32;48;64m2.5\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;32;48;64m,\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;32;48;64m \u{1b}[0m\u{1b}[38;2;165;214;255;48;2;32;48;64m-3e10\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;32;48;64m],\u{1b}[0m\u{1b}[48;2;32;48;64m                           \u{1b}[0m\u{1b}[48;2;32;48;64m  \u{1b}[0m\n" +
    "\u{1b}[48;2;32;48;64m  \u{1b}[0m\u{1b}[38;2;110;118;129;48;2;32;48;64m  \u{1b}[0m\u{1b}[38;2;126;231;135;48;2;32;48;64m\"ok\"\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;32;48;64m:\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;32;48;64m \u{1b}[0m\u{1b}[38;2;121;192;255;48;2;32;48;64mtrue\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;32;48;64m,\u{1b}[0m\u{1b}[48;2;32;48;64m                                           \u{1b}[0m\u{1b}[48;2;32;48;64m  \u{1b}[0m\n" +
    "\u{1b}[48;2;32;48;64m  \u{1b}[0m\u{1b}[38;2;110;118;129;48;2;32;48;64m  \u{1b}[0m\u{1b}[38;2;126;231;135;48;2;32;48;64m\"none\"\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;32;48;64m:\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;32;48;64m \u{1b}[0m\u{1b}[38;2;121;192;255;48;2;32;48;64mnull\u{1b}[0m\u{1b}[48;2;32;48;64m                                          \u{1b}[0m\u{1b}[48;2;32;48;64m  \u{1b}[0m\n" +
    "\u{1b}[48;2;32;48;64m  \u{1b}[0m\u{1b}[38;2;230;237;243;48;2;32;48;64m}\u{1b}[0m\u{1b}[48;2;32;48;64m                                                       \u{1b}[0m\u{1b}[48;2;32;48;64m  \u{1b}[0m\n" +
    "\u{1b}[48;2;32;48;64m  \u{1b}[0m\u{1b}[48;2;32;48;64m                                                        \u{1b}[0m\u{1b}[48;2;32;48;64m  \u{1b}[0m\n" +
    "\u{1b}[48;2;32;48;64m                                                            \u{1b}[0m\n"
