}

///|
test "oracle 29: javascript ansi_dark {'line_range': (3, None), 'highlight_lines': [4]} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_javascript,
    "javascript",
    theme="ansi_dark",
    line_range=(Some(3), None),
    highlight_lines=[4],
  )
  let expected : String = "class Point {\n" +
    "  constructor(x, y) { this.x = x; this.y = y; }\n" +
    "}\n" +
    "console.log(`sum: ${add(1, 2)}`, /re+gex/g, null);\n" +
    "\n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

