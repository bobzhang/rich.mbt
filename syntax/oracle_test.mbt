  )
  let expected : String = "\u{1b}[1;38;2;208;215;221;48;2;13;17;23m  \u{1b}[0m\u{1b}[38;2;78;83;89;48;2;13;17;23m1 \u{1b}[0m\u{1b}[38;2;126;231;135;48;2;13;17;23mkey\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;13;17;23m:\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;13;17;23m \u{1b}[0m\u{1b}[48;2;13;17;23mvalue                    \u{1b}[0m\n" +
    "\u{1b}[1;38;2;208;215;221;48;2;13;17;23m  \u{1b}[0m\u{1b}[38;2;78;83;89;48;2;13;17;23m2 \u{1b}[0m\u{1b}[38;2;126;231;135;48;2;13;17;23mlist\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;13;17;23m:\u{1b}[0m\u{1b}[48;2;13;17;23m                         \u{1b}[0m\n" +
    "\u{1b}[1;38;2;208;215;221;48;2;13;17;23m  \u{1b}[0m\u{1b}[38;2;78;83;89;48;2;13;17;23m3 \u{1b}[0m\u{1b}[38;2;110;118;129;48;2;13;17;23m  \u{1b}[0m\u{1b}[48;2;13;17;23m-\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;13;17;23m \u{1b}[0m\u{1b}[48;2;13;17;23mone                       \u{1b}[0m\n" +
    "\u{1b}[1;38;2;208;215;221;48;2;13;17;23m  \u{1b}[0m\u{1b}[38;2;78;83;89;48;2;13;17;23m4 \u{1b}[0m\u{1b}[38;2;110;118;129;48;2;13;17;23m  \u{1b}[0m\u{1b}[48;2;13;17;23m-\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;13;17;23m \u{1b}[0m\u{1b}[38;2;165;214;255;48;2;13;17;23m\"\u{1b}[0m\u{1b}[38;2;165;214;255;48;2;13;17;23mtwo\u{1b}[0m\u{1b}[38;2;165;214;255;48;2;13;17;23m\"\u{1b}[0m\u{1b}[48;2;13;17;23m                     \u{1b}[0m\n" +
    "\u{1b}[1;38;2;208;215;221;48;2;13;17;23m  \u{1b}[0m\u{1b}[38;2;78;83;89;48;2;13;17;23m5 \u{1b}[0m\u{1b}[38;2;126;231;135;48;2;13;17;23mnested\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;13;17;23m:\u{1b}[0m\u{1b}[48;2;13;17;23m                       \u{1b}[0m\n" +
    "\u{1b}[1;38;2;208;215;221;48;2;13;17;23m  \u{1b}[0m\u{1b}[38;2;78;83;89;48;2;13;17;23m6 \u{1b}[0m\u{1b}[38;2;110;118;129;48;2;13;17;23m  \u{1b}[0m\u{1b}[38;2;126;231;135;48;2;13;17;23mnumber\u{1b}[0m\u{1b}[38;2;230;237;243;48;2;13;17;23m:\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;13;17;23m \u{1b}[0m\u{1b}[48;2;13;17;23m42\u{1b}[0m\u{1b}[38;2;110;118;129;48;2;13;17;23m  \u{1b}[0m\u{1b}[3;38;2;139;148;158;48;2;13;17;23m# comment\u{1b}[0m\u{1b}[48;2;13;17;23m       \u{1b}[0m\n" +
    "\u{1b}[1;38;2;208;215;221;48;2;13;17;23m  \u{1b}[0m\u{1b}[38;2;78;83;89;48;2;13;17;23m7 \u{1b}[0m\u{1b}[48;2;13;17;23m                              \u{1b}[0m\n"
  assert_eq(
