    "\u{1b}[48;5;255m \u{1b}[0m\u{1b}[1;38;5;233;48;5;255m  \u{1b}[0m\u{1b}[38;5;248;48;5;255m2 \u{1b}[0m\u{1b}[1;38;5;129;48;5;255mconst\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255madd\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;241;48;5;255m=\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255m(\u{1b}[0m\u{1b}[38;5;16;48;5;255ma\u{1b}[0m\u{1b}[38;5;16;48;5;255m,\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255mb\u{1b}[0m\u{1b}[38;5;16;48;5;255m)\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255m=>\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255ma\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;241;48;5;255m+\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255mb\u{1b}[0m\u{1b}[38;5;16;48;5;255m;\u{1b}[0m\u{1b}[48;5;255m           \u{1b}[0m\u{1b}[48;5;255m \u{1b}[0m\n" +
    "\u{1b}[48;5;255m \u{1b}[0m\u{1b}[1;38;5;233;48;5;255m  \u{1b}[0m\u{1b}[38;5;248;48;5;255m3 \u{1b}[0m\u{1b}[1;38;5;129;48;5;255mclass\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255mPoint\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255m{\u{1b}[0m\u{1b}[48;5;255m                          \u{1b}[0m\u{1b}[48;5;255m \u{1b}[0m\n" +
    "\u{1b}[48;5;255m \u{1b}[0m\u{1b}[1;38;5;233;48;5;255m  \u{1b}[0m\u{1b}[38;5;248;48;5;255m4 \u{1b}[0m\u{1b}[38;5;249;48;5;255m  \u{1b}[0m\u{1b}[1;38;5;129;48;5;255mconstructor\u{1b}[0m\u{1b}[38;5;16;48;5;255m(\u{1b}[0m\u{1b}[38;5;16;48;5;255mx\u{1b}[0m\u{1b}[38;5;16;48;5;255m,\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255my\u{1b}[0m\u{1b}[38;5;16;48;5;255m)\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255m{\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[1;38;5;129;48;5;255mthis\u{1b}[0m\u{1b}[38;5;16;48;5;255m.\u{1b}[0m\u{1b}[38;5;16;48;5;255mx\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;241;48;5;255m=\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255mx\u{1b}[0m\u{1b}[38;5;16;48;5;255m;\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[48;5;255m     \u{1b}[0m\u{1b}[48;5;255m \u{1b}[0m\n" +
    "\u{1b}[48;5;255m \u{1b}[0m\u{1b}[48;5;255m    \u{1b}[0m\u{1b}[1;38;5;129;48;5;255mthis\u{1b}[0m\u{1b}[38;5;16;48;5;255m.\u{1b}[0m\u{1b}[38;5;16;48;5;255my\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;241;48;5;255m=\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255my\u{1b}[0m\u{1b}[38;5;16;48;5;255m;\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255m}\u{1b}[0m\u{1b}[48;5;255m                          \u{1b}[0m\u{1b}[48;5;255m \u{1b}[0m\n" +
    "\u{1b}[48;5;255m \u{1b}[0m\u{1b}[1;38;5;233;48;5;255m  \u{1b}[0m\u{1b}[38;5;248;48;5;255m5 \u{1b}[0m\u{1b}[38;5;16;48;5;255m}\u{1b}[0m\u{1b}[48;5;255m                                      \u{1b}[0m\u{1b}[48;5;255m \u{1b}[0m\n" +
    "\u{1b}[48;5;255m \u{1b}[0m\u{1b}[1;38;5;233;48;5;255m  \u{1b}[0m\u{1b}[38;5;248;48;5;255m6 \u{1b}[0m\u{1b}[38;5;16;48;5;255mconsole\u{1b}[0m\u{1b}[38;5;16;48;5;255m.\u{1b}[0m\u{1b}[38;5;16;48;5;255mlog\u{1b}[0m\u{1b}[38;5;16;48;5;255m(\u{1b}[0m\u{1b}[38;5;131;48;5;255m`\u{1b}[0m\u{1b}[38;5;131;48;5;255msum: \u{1b}[0m\u{1b}[1;38;5;132;48;5;255m${\u{1b}[0m\u{1b}[38;5;16;48;5;255madd\u{1b}[0m\u{1b}[38;5;16;48;5;255m(\u{1b}[0m\u{1b}[38;5;241;48;5;255m1\u{1b}[0m\u{1b}[38;5;16;48;5;255m,\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;241;48;5;255m2\u{1b}[0m\u{1b}[38;5;16;48;5;255m)\u{1b}[0m\u{1b}[1;38;5;132;48;5;255m}\u{1b}[0m\u{1b}[38;5;131;48;5;255m`\u{1b}[0m\u{1b}[38;5;16;48;5;255m,\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[48;5;255m      \u{1b}[0m\u{1b}[48;5;255m \u{1b}[0m\n" +
    "\u{1b}[48;5;255m \u{1b}[0m\u{1b}[48;5;255m    \u{1b}[0m\u{1b}[38;5;132;48;5;255m/re+gex/g\u{1b}[0m\u{1b}[38;5;16;48;5;255m,\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[1;38;5;129;48;5;255mnull\u{1b}[0m\u{1b}[38;5;16;48;5;255m)\u{1b}[0m\u{1b}[38;5;16;48;5;255m;\u{1b}[0m\u{1b}[48;5;255m                      \u{1b}[0m\u{1b}[48;5;255m \u{1b}[0m\n" +
    "\u{1b}[48;5;255m \u{1b}[0m\u{1b}[1;38;5;233;48;5;255m  \u{1b}[0m\u{1b}[38;5;248;48;5;255m7 \u{1b}[0m\u{1b}[48;5;255m                                       \u{1b}[0m\u{1b}[48;5;255m \u{1b}[0m\n" +
    "\u{1b}[48;5;255m                                             \u{1b}[0m\n"
  assert_eq(oracle_render(syntax, width=45, color_system=Some("256")), expected)
}

///|
test "oracle 36: c ansi_dark {} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(sample_c, "c", theme="ansi_dark")
  let expected : String = "#include <stdio.h>\n" +
    "\n" +
    "int main(int argc, char **argv) {\n" +
    "    printf(\"hello %d\\n\", argc); /* block */\n" +
    "    return 0;\n" +
    "}\n" +
    "\n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

///|
test "oracle 37: c ansi_light {'line_numbers': True} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_c,
    "c",
    theme="ansi_light",
    line_numbers=true,
  )
  let expected : String = "  \u{1b}[2m1 \u{1b}[0m\u{1b}[36m#\u{1b}[0m\u{1b}[36minclude\u{1b}[0m\u{1b}[37m \u{1b}[0m\u{1b}[2m<stdio.h>\u{1b}[0m\n" +
    "  \u{1b}[2m2 \u{1b}[0m\n" +
    "  \u{1b}[2m3 \u{1b}[0m\u{1b}[36mint\u{1b}[0m\u{1b}[37m \u{1b}[0m\u{1b}[32mmain\u{1b}[0m(\u{1b}[36mint\u{1b}[0m\u{1b}[37m \u{1b}[0margc,\u{1b}[37m \u{1b}[0m\u{1b}[36mchar\u{1b}[0m\u{1b}[37m \u{1b}[0m**argv)\u{1b}[37m \u{1b}[0m{\n" +
    "  \u{1b}[2m4 \u{1b}[0m\u{1b}[37m    \u{1b}[0mprintf(\u{1b}[33m\"\u{1b}[0m\u{1b}[33mhello %d\u{1b}[0m\u{1b}[33m\\n\u{1b}[0m\u{1b}[33m\"\u{1b}[0m,\u{1b}[37m \u{1b}[0margc);\u{1b}[37m \u{1b}[0m\u{1b}[2m/* block */\u{1b}[0m\n" +
    "  \u{1b}[2m5 \u{1b}[0m\u{1b}[37m    \u{1b}[0m\u{1b}[34mreturn\u{1b}[0m\u{1b}[37m \u{1b}[0m\u{1b}[34m0\u{1b}[0m;\n" +
    "  \u{1b}[2m6 \u{1b}[0m}\n" +
    "  \u{1b}[2m7 \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

