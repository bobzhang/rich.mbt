///|
test "oracle 69: json emacs {'dedent': True, 'line_numbers': True, 'line_range': (None, 4)} {'width': 80, 'color_system': 'standard'}" {
  let syntax = @syntax.Syntax::new(
    sample_json,
    "json",
    theme="emacs",
    dedent=true,
    line_numbers=true,
    line_range=(None, Some(4)),
  )
  let expected : String = "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m1 \u{1b}[0m\u{1b}[30;107m{\u{1b}[0m\u{1b}[107m                                                                           \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m2 \u{1b}[0m\u{1b}[37;107m  \u{1b}[0m\u{1b}[1;32;107m\"name\"\u{1b}[0m\u{1b}[30;107m:\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[33;107m\"rich\"\u{1b}[0m\u{1b}[30;107m,\u{1b}[0m\u{1b}[107m                                                           \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m3 \u{1b}[0m\u{1b}[37;107m  \u{1b}[0m\u{1b}[1;32;107m\"version\"\u{1b}[0m\u{1b}[30;107m:\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107m[\u{1b}[0m\u{1b}[90;107m1\u{1b}[0m\u{1b}[30;107m,\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[90;107m2.5\u{1b}[0m\u{1b}[30;107m,\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[90;107m-3e10\u{1b}[0m\u{1b}[30;107m],\u{1b}[0m\u{1b}[107m                                               \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m4 \u{1b}[0m\u{1b}[37;107m  \u{1b}[0m\u{1b}[1;32;107m\"ok\"\u{1b}[0m\u{1b}[30;107m:\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[1;35;107mtrue\u{1b}[0m\u{1b}[30;107m,\u{1b}[0m\u{1b}[107m                                                               \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=80, color_system=Some("standard")),
    expected,
  )
}

///|
test "oracle 70: json vim {'code_width': 20} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_json,
    "json",
    theme="vim",
    code_width=20,
  )
  let expected : String = "{                   \n" +
    "  \"name\": \"rich\",   \n" +
    "  \"version\": [1, 2.5\n" +
    "  \"ok\": true,       \n" +
    "  \"none\": null      \n" +
    "}                   \n" +
    "                    \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

