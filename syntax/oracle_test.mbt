    "\u{1b}[1;38;5;249;48;5;16m  \u{1b}[0m\u{1b}[38;5;237;48;5;16m 4 \u{1b}[0m\u{1b}[38;5;184;48;5;16mfn\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;251;48;5;16mmain\u{1b}[0m\u{1b}[38;5;251;48;5;16m(\u{1b}[0m\u{1b}[38;5;251;48;5;16m)\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;251;48;5;16m{\u{1b}[0m\u{1b}[48;5;16m                             \u{1b}[0m\n" +
    "\u{1b}[1;38;5;249;48;5;16m  \u{1b}[0m\u{1b}[38;5;237;48;5;16m 5 \u{1b}[0m\u{1b}[2;38;5;18;48;5;16m│   \u{1b}[0m\u{1b}[38;5;40;48;5;16mlet\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;184;48;5;16mmut\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;251;48;5;16mmap\u{1b}[0m\u{1b}[38;5;251;48;5;16m:\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;44;48;5;16mHashMap\u{1b}[0m\u{1b}[38;5;68;48;5;16m<\u{1b}[0m\u{1b}[38;5;68;48;5;16m&\u{1b}[0m\u{1b}[38;5;40;48;5;16mstr\u{1b}[0m\u{1b}[38;5;251;48;5;16m,\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;40;48;5;16mi32\u{1b}[0m\u{1b}[38;5;68;48;5;16m>\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;68;48;5;16m=\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;251;48;5;16mHa\u{1b}[0m\n" +
