test "oracle 14: rust nord {'line_numbers': True, 'word_wrap': True, 'code_width': 30} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_rust,
    "rust",
    theme="nord",
    line_numbers=true,
    word_wrap=true,
    code_width=30,
  )
  let expected : String = "   1 use std::collections::HashMap;\n" +
    "   2                               \n" +
    "   3 /// Doc comment               \n" +
    "   4 fn main() {                   \n" +
    "   5     let mut map: HashMap<&str,\n" +
    "     i32> = HashMap::new();        \n" +
    "   6     map.insert(\"one\", 1);     \n" +
    "   7     for (k, v) in &map {      \n" +
    "   8         println!(\"{}: {}\", k, \n" +
    "     v);                           \n" +
    "   9     }                         \n" +
    "  10 }                             \n" +
    "  11                               \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

