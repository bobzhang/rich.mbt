test "oracle 50: html vim {'line_numbers': True, 'word_wrap': True, 'code_width': 30} {'width': 80, 'color_system': 'standard'}" {
  let syntax = @syntax.Syntax::new(
    sample_html,
    "html",
    theme="vim",
    line_numbers=true,
    word_wrap=true,
    code_width=30,
  )
  let expected : String = "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m1 \u{1b}[0m\u{1b}[34;40m<!DOCTYPE html>\u{1b}[0m\u{1b}[40m               \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m2 \u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40mhtml\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[40m                        \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m3 \u{1b}[0m\u{1b}[37;40m  \u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40mbody\u{1b}[0m\u{1b}[37;40m \u{1b}[0m\u{1b}[37;40mclass\u{1b}[0m\u{1b}[36;40m=\u{1b}[0m\u{1b}[31;40m\"main\"\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[40m         \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m4 \u{1b}[0m\u{1b}[37;40m    \u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40mp\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[37;40mHello \u{1b}[0m\u{1b}[37;40m&amp;\u{1b}[0m\u{1b}[37;40m \u{1b}[0m\u{1b}[40m           \u{1b}[0m\n" +
    "\u{1b}[40m    \u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40mb\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[37;40mworld\u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40m/\u{1b}[0m\u{1b}[37;40mb\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40m/\u{1b}[0m\u{1b}[37;40mp\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[40m              \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m5 \u{1b}[0m\u{1b}[37;40m    \u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40mscript\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[32;40mvar\u{1b}[0m\u{1b}[37;40m \u{1b}[0m\u{1b}[37;40mx\u{1b}[0m\u{1b}[37;40m \u{1b}[0m\u{1b}[36;40m=\u{1b}[0m\u{1b}[37;40m \u{1b}[0m\u{1b}[40m          \u{1b}[0m\n" +
    "\u{1b}[40m    \u{1b}[0m\u{1b}[35;40m1\u{1b}[0m\u{1b}[37;40m;\u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40m/\u{1b}[0m\u{1b}[37;40mscript\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[40m                   \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m6 \u{1b}[0m\u{1b}[37;40m  \u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40m/\u{1b}[0m\u{1b}[37;40mbody\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[40m                     \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m7 \u{1b}[0m\u{1b}[37;40m<\u{1b}[0m\u{1b}[37;40m/\u{1b}[0m\u{1b}[37;40mhtml\u{1b}[0m\u{1b}[37;40m>\u{1b}[0m\u{1b}[40m                       \u{1b}[0m\n" +
