  let syntax = @syntax.Syntax::new(
    sample_rust,
    "rust",
    theme="ansi_light",
    padding=[1],
    word_wrap=true,
    line_numbers=true,
  )
  let expected : String = "                                                            \n" +
    "   \u{1b}[2m 1 \u{1b}[0m\u{1b}[34muse\u{1b}[0m\u{1b}[37m \u{1b}[0mstd::collections::HashMap;                        \n" +
    "   \u{1b}[2m 2 \u{1b}[0m                                                      \n" +
    "   \u{1b}[2m 3 \u{1b}[0m\u{1b}[33m/// Doc comment\u{1b}[0m                                       \n" +
    "   \u{1b}[2m 4 \u{1b}[0m\u{1b}[34mfn\u{1b}[0m\u{1b}[37m \u{1b}[0m\u{1b}[32mmain\u{1b}[0m()\u{1b}[37m \u{1b}[0m{                                           \n" +
    "   \u{1b}[2m 5 \u{1b}[0m\u{1b}[37m    \u{1b}[0m\u{1b}[34mlet\u{1b}[0m\u{1b}[37m \u{1b}[0m\u{1b}[34mmut\u{1b}[0m\u{1b}[37m \u{1b}[0mmap:\u{1b}[37m \u{1b}[0m\u{1b}[4;32mHashMap\u{1b}[0m<&\u{1b}[36mstr\u{1b}[0m,\u{1b}[37m \u{1b}[0m\u{1b}[36mi32\u{1b}[0m>\u{1b}[37m \u{1b}[0m=\u{1b}[37m \u{1b}[0mHashMap::new(); \n" +
    "   \u{1b}[2m 6 \u{1b}[0m\u{1b}[37m    \u{1b}[0mmap.insert(\u{1b}[33m\"\u{1b}[0m\u{1b}[33mone\u{1b}[0m\u{1b}[33m\"\u{1b}[0m,\u{1b}[37m \u{1b}[0m\u{1b}[34m1\u{1b}[0m);                             \n" +
    "   \u{1b}[2m 7 \u{1b}[0m\u{1b}[37m    \u{1b}[0m\u{1b}[34mfor\u{1b}[0m\u{1b}[37m \u{1b}[0m(k,\u{1b}[37m \u{1b}[0mv)\u{1b}[37m \u{1b}[0m\u{1b}[34min\u{1b}[0m\u{1b}[37m \u{1b}[0m&map\u{1b}[37m \u{1b}[0m{                              \n" +
    "   \u{1b}[2m 8 \u{1b}[0m\u{1b}[37m        \u{1b}[0m\u{1b}[32mprintln!\u{1b}[0m(\u{1b}[33m\"\u{1b}[0m\u{1b}[33m{}: {}\u{1b}[0m\u{1b}[33m\"\u{1b}[0m,\u{1b}[37m \u{1b}[0mk,\u{1b}[37m \u{1b}[0mv);                     \n" +
    "   \u{1b}[2m 9 \u{1b}[0m\u{1b}[37m    \u{1b}[0m}                                                 \n" +
    "   \u{1b}[2m10 \u{1b}[0m}                                                     \n" +
    "   \u{1b}[2m11 \u{1b}[0m                                                      \n" +
    "                                                            \n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

