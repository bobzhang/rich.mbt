test "oracle 9: python vim {'dedent': True, 'line_numbers': True, 'line_range': (None, 4)} {'width': 45, 'color_system': '256'}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="vim",
    dedent=true,
    line_numbers=true,
    line_range=(None, Some(4)),
  )
  let expected : String = "\u{1b}[1;38;5;249;48;5;16m  \u{1b}[0m\u{1b}[38;5;237;48;5;16m 1 \u{1b}[0m\u{1b}[38;5;164;48;5;16mimport\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;251;48;5;16mos\u{1b}[0m\u{1b}[48;5;16m                               \u{1b}[0m\n" +
    "\u{1b}[1;38;5;249;48;5;16m  \u{1b}[0m\u{1b}[38;5;237;48;5;16m 2 \u{1b}[0m\u{1b}[48;5;16m                                        \u{1b}[0m\n" +
    "\u{1b}[1;38;5;249;48;5;16m  \u{1b}[0m\u{1b}[38;5;237;48;5;16m 3 \u{1b}[0m\u{1b}[38;5;251;48;5;16m@decorator\u{1b}[0m\u{1b}[48;5;16m                              \u{1b}[0m\n" +
    "\u{1b}[1;38;5;249;48;5;16m  \u{1b}[0m\u{1b}[38;5;237;48;5;16m 4 \u{1b}[0m\u{1b}[38;5;184;48;5;16mclass\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;44;48;5;16mFoo\u{1b}[0m\u{1b}[38;5;251;48;5;16m(\u{1b}[0m\u{1b}[38;5;251;48;5;16mBase\u{1b}[0m\u{1b}[38;5;251;48;5;16m)\u{1b}[0m\u{1b}[38;5;251;48;5;16m:\u{1b}[0m\u{1b}[48;5;16m                        \u{1b}[0m\n"
  assert_eq(oracle_render(syntax, width=45, color_system=Some("256")), expected)
}

