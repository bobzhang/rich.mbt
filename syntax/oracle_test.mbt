    "\u{1b}[40m \u{1b}[0m\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m1 \u{1b}[0m\u{1b}[37;40m#\u{1b}[0m\u{1b}[37;40minclude\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40m<stdio.h>\u{1b}[0m\u{1b}[40m                                                        \u{1b}[0m\u{1b}[40m \u{1b}[0m\n" +
    "\u{1b}[40m \u{1b}[0m\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m2 \u{1b}[0m\u{1b}[40m                                                                          \u{1b}[0m\u{1b}[40m \u{1b}[0m\n" +
    "\u{1b}[40m \u{1b}[0m\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m3 \u{1b}[0m\u{1b}[96;40mint\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[92;40mmain\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[96;40mint\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40margc\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[96;40mchar\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[91;40m*\u{1b}[0m\u{1b}[91;40m*\u{1b}[0m\u{1b}[97;40margv\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m{\u{1b}[0m\u{1b}[40m                                         \u{1b}[0m\u{1b}[40m \u{1b}[0m\n" +
    "\u{1b}[40m \u{1b}[0m\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m4 \u{1b}[0m\u{1b}[97;40m    \u{1b}[0m\u{1b}[97;40mprintf\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[93;40m\"\u{1b}[0m\u{1b}[93;40mhello %d\u{1b}[0m\u{1b}[37;40m\\n\u{1b}[0m\u{1b}[93;40m\"\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40margc\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[97;40m;\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40m/* block */\u{1b}[0m\u{1b}[40m                               \u{1b}[0m\u{1b}[40m \u{1b}[0m\n" +
    "\u{1b}[40m \u{1b}[0m\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m5 \u{1b}[0m\u{1b}[97;40m    \u{1b}[0m\u{1b}[96;40mreturn\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40m0\u{1b}[0m\u{1b}[97;40m;\u{1b}[0m\u{1b}[40m                                                             \u{1b}[0m\u{1b}[40m \u{1b}[0m\n" +
    "\u{1b}[40m \u{1b}[0m\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m6 \u{1b}[0m\u{1b}[97;40m}\u{1b}[0m\u{1b}[40m                                                                         \u{1b}[0m\u{1b}[40m \u{1b}[0m\n" +
    "\u{1b}[40m \u{1b}[0m\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m7 \u{1b}[0m\u{1b}[40m                                                                          \u{1b}[0m\u{1b}[40m \u{1b}[0m\n" +
    "\u{1b}[40m                                                                                \u{1b}[0m\n"
  assert_eq(
