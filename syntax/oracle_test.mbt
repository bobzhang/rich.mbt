test "oracle 73: yaml solarized-light {'line_numbers': True} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_yaml,
    "yaml",
    theme="solarized-light",
    line_numbers=true,
  )
  let expected : String = "  1 key: value                                    \n" +
    "  2 list:                                         \n" +
    "  3   - one                                       \n" +
    "  4   - \"two\"                                     \n" +
    "  5 nested:                                       \n" +
    "  6   number: 42  # comment                       \n" +
    "  7                                               \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

