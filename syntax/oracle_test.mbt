    "\u{1b}[100m  \u{1b}[0m\u{1b}[2;100m2 \u{1b}[0m\u{1b}[37;100m+++ b/file.txt\u{1b}[0m\u{1b}[100m                                                              \u{1b}[0m\n" +
    "\u{1b}[100m  \u{1b}[0m\u{1b}[2;100m3 \u{1b}[0m\u{1b}[1;37;100m@@ -1,3 +1,3 @@\u{1b}[0m\u{1b}[100m                                                             \u{1b}[0m\n" +
    "\u{1b}[100m  \u{1b}[0m\u{1b}[2;100m4 \u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[97;100mcontext\u{1b}[0m\u{1b}[100m                                                                    \u{1b}[0m\n" +
    "\u{1b}[100m  \u{1b}[0m\u{1b}[2;100m5 \u{1b}[0m\u{1b}[91;100m-removed line\u{1b}[0m\u{1b}[100m                                                               \u{1b}[0m\n" +
    "\u{1b}[100m  \u{1b}[0m\u{1b}[2;100m6 \u{1b}[0m\u{1b}[37;100m+added line\u{1b}[0m\u{1b}[100m                                                                 \u{1b}[0m\n" +
