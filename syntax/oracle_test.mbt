    "\u{1b}[48;5;16m \u{1b}[0m\u{1b}[1;38;5;249;48;5;16m  \u{1b}[0m\u{1b}[38;5;237;48;5;16m6 \u{1b}[0m\u{1b}[38;5;251;48;5;16m    \u{1b}[0m\u{1b}[38;5;251;48;5;16mch\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;68;48;5;16m:=\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;164;48;5;16mmake\u{1b}[0m\u{1b}[38;5;251;48;5;16m(\u{1b}[0m\u{1b}[38;5;40;48;5;16mchan\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;40;48;5;16mint\u{1b}[0m\u{1b}[38;5;251;48;5;16m,\u{1b}[0m\u{1b}[38;5;251;48;5;16m \u{1b}[0m\u{1b}[38;5;164;48;5;16m3\u{1b}[0m\u{1b}[38;5;251;48;5;16m)\u{1b}[0m\u{1b}[48;5;16m            \u{1b}[0m\u{1b}[48;5;16m \u{1b}[0m\n" +
