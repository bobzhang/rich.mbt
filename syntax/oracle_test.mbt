    word_wrap=true,
    code_width=30,
  )
  let expected : String = "  1 --- a/file.txt                \n" +
    "  2 +++ b/file.txt                \n" +
    "  3 @@ -1,3 +1,3 @@               \n" +
    "  4  context                      \n" +
    "  5 -removed line                 \n" +
    "  6 +added line                   \n" +
    "  7                               \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

