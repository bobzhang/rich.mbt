    sample_c,
    "c",
    theme="nord",
    line_range=(Some(3), None),
    highlight_lines=[4],
  )
  let expected : String = "\u{1b}[38;2;129;161;193;48;2;46;52;64mint\u{1b}[0m\u{1b}[38;2;216;222;233;48;2;46;52;64m \u{1b}[0m\u{1b}[38;2;136;192;208;48;2;46;52;64mmain\u{1b}[0m\u{1b}[38;2;236;239;244;48;2;46;52;64m(\u{1b}[0m\u{1b}[38;2;129;161;193;48;2;46;52;64mint\u{1b}[0m\u{1b}[38;2;216;222;233;48;2;46;52;64m \u{1b}[0m\u{1b}[38;2;216;222;233;48;2;46;52;64margc\u{1b}[0m\u{1b}[38;2;236;239;244;48;2;46;52;64m,\u{1b}[0m\u{1b}[38;2;216;222;233;48;2;46;52;64m \u{1b}[0m\u{1b}[38;2;129;161;193;48;2;46;52;64mchar\u{1b}[0m\u{1b}[38;2;216;222;233;48;2;46;52;64m \u{1b}[0m\u{1b}[1;38;2;129;161;193;48;2;46;52;64m*\u{1b}[0m\u{1b}[1;38;2;129;161;193;48;2;46;52;64m*\u{1b}[0m\u{1b}[38;2;216;222;233;48;2;46;52;64margv\u{1b}[0m\u{1b}[38;2;236;239;244;48;2;46;52;64m)\u{1b}[0m\u{1b}[38;2;216;222;233;48;2;46;52;64m \u{1b}[0m\u{1b}[38;2;236;239;244;48;2;46;52;64m{\u{1b}[0m\u{1b}[48;2;46;52;64m                           \u{1b}[0m\n" +
