    "\u{1b}[1;38;5;251;48;5;235m  \u{1b}[0m\u{1b}[38;5;240;48;5;235m3 \u{1b}[0m\u{1b}[38;5;203;48;5;235mORDER\u{1b}[0m\u{1b}[38;5;253;48;5;235m \u{1b}[0m\u{1b}[38;5;203;48;5;235mBY\u{1b}[0m\u{1b}[38;5;253;48;5;235m \u{1b}[0m\u{1b}[38;5;253;48;5;235mname\u{1b}[0m\u{1b}[38;5;253;48;5;235m \u{1b}[0m\u{1b}[38;5;203;48;5;235mDESC\u{1b}[0m\u{1b}[38;5;253;48;5;235m;\u{1b}[0m\u{1b}[38;5;253;48;5;235m \u{1b}[0m\u{1b}[3;38;5;244;48;5;235m-- comment\u{1b}[0m\u{1b}[48;5;235m           \u{1b}[0m\n" +
