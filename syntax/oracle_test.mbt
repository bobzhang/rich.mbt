test "oracle 12: rust solarized-light {} {'width': 45, 'color_system': '256'}" {
  let syntax = @syntax.Syntax::new(sample_rust, "rust", theme="solarized-light")
  let expected : String = "\u{1b}[38;5;100;48;5;230muse\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230mstd\u{1b}[0m\u{1b}[38;5;242;48;5;230m::\u{1b}[0m\u{1b}[38;5;242;48;5;230mcollections\u{1b}[0m\u{1b}[38;5;242;48;5;230m::\u{1b}[0m\u{1b}[38;5;242;48;5;230mHashMap\u{1b}[0m\u{1b}[38;5;242;48;5;230m;\u{1b}[0m\u{1b}[48;5;230m               \u{1b}[0m\n" +
    "\u{1b}[48;5;230m                                             \u{1b}[0m\n" +
    "\u{1b}[38;5;246;48;5;230m/// Doc comment\u{1b}[0m\u{1b}[48;5;230m                              \u{1b}[0m\n" +
    "\u{1b}[38;5;100;48;5;230mfn\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;32;48;5;230mmain\u{1b}[0m\u{1b}[38;5;242;48;5;230m(\u{1b}[0m\u{1b}[38;5;242;48;5;230m)\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230m{\u{1b}[0m\u{1b}[48;5;230m                                  \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m    \u{1b}[0m\u{1b}[38;5;36;48;5;230mlet\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;100;48;5;230mmut\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230mmap\u{1b}[0m\u{1b}[38;5;242;48;5;230m:\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;32;48;5;230mHashMap\u{1b}[0m\u{1b}[38;5;246;48;5;230m<\u{1b}[0m\u{1b}[38;5;246;48;5;230m&\u{1b}[0m\u{1b}[38;5;136;48;5;230mstr\u{1b}[0m\u{1b}[38;5;242;48;5;230m,\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;136;48;5;230mi32\u{1b}[0m\u{1b}[38;5;246;48;5;230m>\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;246;48;5;230m=\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230mHashMap\u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m    \u{1b}[0m\u{1b}[38;5;242;48;5;230mmap\u{1b}[0m\u{1b}[38;5;242;48;5;230m.\u{1b}[0m\u{1b}[38;5;242;48;5;230minsert\u{1b}[0m\u{1b}[38;5;242;48;5;230m(\u{1b}[0m\u{1b}[38;5;36;48;5;230m\"\u{1b}[0m\u{1b}[38;5;36;48;5;230mone\u{1b}[0m\u{1b}[38;5;36;48;5;230m\"\u{1b}[0m\u{1b}[38;5;242;48;5;230m,\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;36;48;5;230m1\u{1b}[0m\u{1b}[38;5;242;48;5;230m)\u{1b}[0m\u{1b}[38;5;242;48;5;230m;\u{1b}[0m\u{1b}[48;5;230m                    \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m    \u{1b}[0m\u{1b}[38;5;100;48;5;230mfor\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230m(\u{1b}[0m\u{1b}[38;5;242;48;5;230mk\u{1b}[0m\u{1b}[38;5;242;48;5;230m,\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230mv\u{1b}[0m\u{1b}[38;5;242;48;5;230m)\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;100;48;5;230min\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;246;48;5;230m&\u{1b}[0m\u{1b}[38;5;242;48;5;230mmap\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230m{\u{1b}[0m\u{1b}[48;5;230m                     \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m        \u{1b}[0m\u{1b}[38;5;32;48;5;230mprintln!\u{1b}[0m\u{1b}[38;5;242;48;5;230m(\u{1b}[0m\u{1b}[38;5;36;48;5;230m\"\u{1b}[0m\u{1b}[38;5;36;48;5;230m{}: {}\u{1b}[0m\u{1b}[38;5;36;48;5;230m\"\u{1b}[0m\u{1b}[38;5;242;48;5;230m,\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230mk\u{1b}[0m\u{1b}[38;5;242;48;5;230m,\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230mv\u{1b}[0m\u{1b}[38;5;242;48;5;230m)\u{1b}[0m\u{1b}[38;5;242;48;5;230m;\u{1b}[0m\u{1b}[48;5;230m            \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m    \u{1b}[0m\u{1b}[38;5;242;48;5;230m}\u{1b}[0m\u{1b}[48;5;230m                                        \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m}\u{1b}[0m\u{1b}[48;5;230m                                            \u{1b}[0m\n" +
    "\u{1b}[48;5;230m                                             \u{1b}[0m\n"
  assert_eq(oracle_render(syntax, width=45, color_system=Some("256")), expected)
}

///|
test "oracle 13: rust github-dark {'line_numbers': True} {'width': 80, 'color_system': 'standard'}" {
  let syntax = @syntax.Syntax::new(
    sample_rust,
    "rust",
    theme="github-dark",
    line_numbers=true,
  )
  let expected : String = "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m 1 \u{1b}[0m\u{1b}[91;40muse\u{1b}[0m\u{1b}[90;40m \u{1b}[0m\u{1b}[97;40mstd\u{1b}[0m\u{1b}[97;40m::\u{1b}[0m\u{1b}[97;40mcollections\u{1b}[0m\u{1b}[97;40m::\u{1b}[0m\u{1b}[97;40mHashMap\u{1b}[0m\u{1b}[97;40m;\u{1b}[0m\u{1b}[40m                                             \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m 2 \u{1b}[0m\u{1b}[40m                                                                           \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m 3 \u{1b}[0m\u{1b}[96;40m/// Doc comment\u{1b}[0m\u{1b}[40m                                                            \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m 4 \u{1b}[0m\u{1b}[91;40mfn\u{1b}[0m\u{1b}[90;40m \u{1b}[0m\u{1b}[1;37;40mmain\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[90;40m \u{1b}[0m\u{1b}[97;40m{\u{1b}[0m\u{1b}[40m                                                                \u{1b}[0m\n" +
