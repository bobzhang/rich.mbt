    "\u{1b}[1;38;5;253;48;5;236m  \u{1b}[0m\u{1b}[38;5;241;48;5;236m4 \u{1b}[0m\u{1b}[38;5;231;48;5;236m    \u{1b}[0m\u{1b}[38;5;231;48;5;236mprintf\u{1b}[0m\u{1b}[38;5;231;48;5;236m(\u{1b}[0m\u{1b}[38;5;141;48;5;236m\"\u{1b}[0m\u{1b}[38;5;141;48;5;236mhello %d\u{1b}[0m\u{1b}[38;5;141;48;5;236m\\n\u{1b}[0m\u{1b}[38;5;141;48;5;236m\"\u{1b}[0m\u{1b}[38;5;231;48;5;236m,\u{1b}[0m\u{1b}[38;5;231;48;5;236m \u{1b}[0m\u{1b}[48;5;236m     \u{1b}[0m\n" +
    "\u{1b}[48;5;236m    \u{1b}[0m\u{1b}[38;5;231;48;5;236margc\u{1b}[0m\u{1b}[38;5;231;48;5;236m)\u{1b}[0m\u{1b}[38;5;231;48;5;236m;\u{1b}[0m\u{1b}[38;5;231;48;5;236m \u{1b}[0m\u{1b}[38;5;61;48;5;236m/* block */\u{1b}[0m\u{1b}[48;5;236m            \u{1b}[0m\n" +
