    "\u{1b}[48;2;39;40;34m                                                            \u{1b}[0m\n" +
    "\u{1b}[38;2;248;248;242;48;2;39;40;34m    \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mdef\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34mmethod\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34mself\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m,\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mx\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m:\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34mint\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m=\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;174;129;255;48;2;39;40;34m0x1F\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m-\u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m>\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34mstr\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m:\u{1b}[0m\u{1b}[48;2;39;40;34m                 \u{1b}[0m\n" +
    "\u{1b}[38;2;248;248;242;48;2;39;40;34m  \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m      \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mif\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mx\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m>\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;174;129;255;48;2;39;40;34m10\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mand\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mnot\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mNone\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m:\u{1b}[0m\u{1b}[48;2;39;40;34m                             \u{1b}[0m\n" +
    "\u{1b}[4;38;2;248;248;242;48;2;39;40;34m        \u{1b}[0m\u{1b}[4;38;2;102;217;239;48;2;39;40;34mreturn\u{1b}[0m\u{1b}[4;38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[4;38;2;230;219;116;48;2;39;40;34mf\u{1b}[0m\u{1b}[4;38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[4;38;2;230;219;116;48;2;39;40;34mvalue \u{1b}[0m\u{1b}[4;38;2;230;219;116;48;2;39;40;34m{\u{1b}[0m\u{1b}[4;38;2;248;248;242;48;2;39;40;34mx\u{1b}[0m\u{1b}[4;38;2;230;219;116;48;2;39;40;34m!r}\u{1b}[0m\u{1b}[4;38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[4;38;2;248;248;242;48;2;39;40;34m  \u{1b}[0m\u{1b}[4;38;2;149;144;119;48;2;39;40;34m# comment\u{1b}[0m\u{1b}[48;2;39;40;34m                    \u{1b}[0m\n" +
    "\u{1b}[38;2;248;248;242;48;2;39;40;34m        \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mreturn\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m'\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mcafé 中文\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m'\u{1b}[0m\u{1b}[48;2;39;40;34m                                  \u{1b}[0m\n" +
    "\u{1b}[48;2;39;40;34m                                                            \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

///|
test "oracle 147: rust ansi_dark {'line_numbers': True, 'word_wrap': True} {'width': 40, 'color_system': 'standard'}" {
  let syntax = @syntax.Syntax::new(
    sample_rust,
    "rust",
    theme="ansi_dark",
    line_numbers=true,
    word_wrap=true,
  )
  syntax.stylize_range("reverse", (4, 4), (4, 7), style_before=false)
  let expected : String = "  \u{1b}[2m 1 \u{1b}[0m\u{1b}[94muse\u{1b}[0m\u{1b}[90m \u{1b}[0mstd::collections::HashMap;\n" +
    "  \u{1b}[2m 2 \u{1b}[0m\n" +
    "  \u{1b}[2m 3 \u{1b}[0m\u{1b}[33m/// Doc comment\u{1b}[0m\n" +
    "  \u{1b}[2m 4 \u{1b}[0m\u{1b}[94mfn\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[92mm\u{1b}[0m\u{1b}[7;92main\u{1b}[0m()\u{1b}[90m \u{1b}[0m{\n" +
    "  \u{1b}[2m 5 \u{1b}[0m\u{1b}[90m    \u{1b}[0m\u{1b}[94mlet\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[94mmut\u{1b}[0m\u{1b}[90m \u{1b}[0mmap:\u{1b}[90m \u{1b}[0m\u{1b}[4;92mHashMap\u{1b}[0m<&\u{1b}[96mstr\u{1b}[0m,\u{1b}[90m \u{1b}[0m\u{1b}[96mi32\u{1b}[0m>\n" +
    "     =\u{1b}[90m \u{1b}[0mHashMap::new();\n" +
    "  \u{1b}[2m 6 \u{1b}[0m\u{1b}[90m    \u{1b}[0mmap.insert(\u{1b}[33m\"\u{1b}[0m\u{1b}[33mone\u{1b}[0m\u{1b}[33m\"\u{1b}[0m,\u{1b}[90m \u{1b}[0m\u{1b}[94m1\u{1b}[0m);\n" +
    "  \u{1b}[2m 7 \u{1b}[0m\u{1b}[90m    \u{1b}[0m\u{1b}[94mfor\u{1b}[0m\u{1b}[90m \u{1b}[0m(k,\u{1b}[90m \u{1b}[0mv)\u{1b}[90m \u{1b}[0m\u{1b}[94min\u{1b}[0m\u{1b}[90m \u{1b}[0m&map\u{1b}[90m \u{1b}[0m{\n" +
    "  \u{1b}[2m 8 \u{1b}[0m\u{1b}[90m        \u{1b}[0m\u{1b}[92mprintln!\u{1b}[0m(\u{1b}[33m\"\u{1b}[0m\u{1b}[33m{}: {}\u{1b}[0m\u{1b}[33m\"\u{1b}[0m,\u{1b}[90m \u{1b}[0mk,\u{1b}[90m \u{1b}[0mv);\n" +
    "  \u{1b}[2m 9 \u{1b}[0m\u{1b}[90m    \u{1b}[0m}\n" +
    "  \u{1b}[2m10 \u{1b}[0m}\n" +
    "  \u{1b}[2m11 \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=40, color_system=Some("standard")),
    expected,
  )
}
