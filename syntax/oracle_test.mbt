  )
  let expected : String = "\u{1b}[38;5;244;48;5;235m// A comment\u{1b}[0m\u{1b}[48;5;235m                                 \u{1b}[0m\n" +
    "\u{1b}[38;5;81;48;5;235mconst\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;148;48;5;235madd\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;204;48;5;235m=\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;231;48;5;235m(\u{1b}[0m\u{1b}[38;5;148;48;5;235ma\u{1b}[0m\u{1b}[38;5;231;48;5;235m,\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;148;48;5;235mb\u{1b}[0m\u{1b}[38;5;231;48;5;235m)\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;231;48;5;235m=>\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;148;48;5;235ma\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;204;48;5;235m+\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;148;48;5;235mb\u{1b}[0m\u{1b}[38;5;231;48;5;235m;\u{1b}[0m\u{1b}[48;5;235m                 \u{1b}[0m\n" +
    "\u{1b}[38;5;81;48;5;235mclass\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;148;48;5;235mPoint\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;231;48;5;235m{\u{1b}[0m\u{1b}[48;5;235m                                \u{1b}[0m\n" +
    "\u{1b}[2;38;5;244;48;5;235m  \u{1b}[0m\u{1b}[38;5;81;48;5;235mconstructor\u{1b}[0m\u{1b}[38;5;231;48;5;235m(\u{1b}[0m\u{1b}[38;5;148;48;5;235mx\u{1b}[0m\u{1b}[38;5;231;48;5;235m,\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;148;48;5;235my\u{1b}[0m\u{1b}[38;5;231;48;5;235m)\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;231;48;5;235m{\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;81;48;5;235mthis\u{1b}[0m\u{1b}[38;5;231;48;5;235m.\u{1b}[0m\u{1b}[38;5;148;48;5;235mx\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;204;48;5;235m=\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;148;48;5;235mx\u{1b}[0m\u{1b}[38;5;231;48;5;235m;\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;81;48;5;235mthis\u{1b}[0m\u{1b}[38;5;231;48;5;235m.\u{1b}[0m\u{1b}[38;5;148;48;5;235my\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;204;48;5;235m=\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;148;48;5;235my\u{1b}[0m\u{1b}[38;5;231;48;5;235m;\u{1b}[0m\n" +
    "\u{1b}[38;5;231;48;5;235m}\u{1b}[0m\u{1b}[48;5;235m                                            \u{1b}[0m\n" +
    "\u{1b}[38;5;148;48;5;235mconsole\u{1b}[0m\u{1b}[38;5;231;48;5;235m.\u{1b}[0m\u{1b}[38;5;148;48;5;235mlog\u{1b}[0m\u{1b}[38;5;231;48;5;235m(\u{1b}[0m\u{1b}[38;5;186;48;5;235m`\u{1b}[0m\u{1b}[38;5;186;48;5;235msum: \u{1b}[0m\u{1b}[38;5;186;48;5;235m${\u{1b}[0m\u{1b}[38;5;148;48;5;235madd\u{1b}[0m\u{1b}[38;5;231;48;5;235m(\u{1b}[0m\u{1b}[38;5;141;48;5;235m1\u{1b}[0m\u{1b}[38;5;231;48;5;235m,\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;141;48;5;235m2\u{1b}[0m\u{1b}[38;5;231;48;5;235m)\u{1b}[0m\u{1b}[38;5;186;48;5;235m}\u{1b}[0m\u{1b}[38;5;186;48;5;235m`\u{1b}[0m\u{1b}[38;5;231;48;5;235m,\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;186;48;5;235m/re+gex/g\u{1b}[0m\u{1b}[38;5;231;48;5;235m,\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;81;48;5;235mn\u{1b}[0m\n" +
    "\u{1b}[48;5;235m                                             \u{1b}[0m\n"
  assert_eq(oracle_render(syntax, width=45, color_system=Some("256")), expected)
