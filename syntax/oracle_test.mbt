  let expected : String = "\u{1b}[38;5;16;48;5;255m{\u{1b}[0m\u{1b}[48;5;255m                                            \u{1b}[0m\n" +
    "\u{1b}[38;5;249;48;5;255m  \u{1b}[0m\u{1b}[1;38;5;28;48;5;255m\"name\"\u{1b}[0m\u{1b}[38;5;16;48;5;255m:\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;124;48;5;255m\"rich\"\u{1b}[0m\u{1b}[38;5;16;48;5;255m,\u{1b}[0m\u{1b}[48;5;255m                            \u{1b}[0m\n" +
    "\u{1b}[38;5;249;48;5;255m  \u{1b}[0m\u{1b}[1;38;5;28;48;5;255m\"version\"\u{1b}[0m\u{1b}[38;5;16;48;5;255m:\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;16;48;5;255m[\u{1b}[0m\u{1b}[38;5;241;48;5;255m1\u{1b}[0m\u{1b}[38;5;16;48;5;255m,\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;241;48;5;255m2.5\u{1b}[0m\u{1b}[38;5;16;48;5;255m,\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[38;5;241;48;5;255m-3e10\u{1b}[0m\u{1b}[38;5;16;48;5;255m],\u{1b}[0m\u{1b}[48;5;255m                \u{1b}[0m\n" +
    "\u{1b}[38;5;249;48;5;255m  \u{1b}[0m\u{1b}[1;38;5;28;48;5;255m\"ok\"\u{1b}[0m\u{1b}[38;5;16;48;5;255m:\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[1;38;5;28;48;5;255mtrue\u{1b}[0m\u{1b}[38;5;16;48;5;255m,\u{1b}[0m\u{1b}[48;5;255m                                \u{1b}[0m\n" +
    "\u{1b}[38;5;249;48;5;255m  \u{1b}[0m\u{1b}[1;38;5;28;48;5;255m\"none\"\u{1b}[0m\u{1b}[38;5;16;48;5;255m:\u{1b}[0m\u{1b}[38;5;249;48;5;255m \u{1b}[0m\u{1b}[1;38;5;28;48;5;255mnull\u{1b}[0m\u{1b}[48;5;255m                               \u{1b}[0m\n" +
    "\u{1b}[38;5;16;48;5;255m}\u{1b}[0m\u{1b}[48;5;255m                                            \u{1b}[0m\n" +
    "\u{1b}[48;5;255m                                             \u{1b}[0m\n"
  assert_eq(oracle_render(syntax, width=45, color_system=Some("256")), expected)
}

