test "oracle 55: html default {'padding': (1, 2), 'background_color': '#203040'} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_html,
    "html",
    theme="default",
    padding=[1, 2],
    background_color="#203040",
  )
  let expected : String = "                                                  \n" +
    "  <!DOCTYPE html>                                 \n" +
    "  <html>                                          \n" +
    "    <body class=\"main\">                           \n" +
    "      <p>Hello &amp; <b>world</b></p>             \n" +
    "      <script>var x = 1;</script>                 \n" +
    "    </body>                                       \n" +
    "  </html>                                         \n" +
    "                                                  \n" +
    "                                                  \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

///|
test "oracle 56: html ansi_dark {'tab_size': 8, 'word_wrap': True} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_html,
    "html",
    theme="ansi_dark",
    tab_size=8,
    word_wrap=true,
  )
  let expected : String = "\u{1b}[96m<!DOCTYPE html>\u{1b}[0m\n" +
    "<\u{1b}[94mhtml\u{1b}[0m>\n" +
    "  <\u{1b}[94mbody\u{1b}[0m \u{1b}[96mclass\u{1b}[0m=\u{1b}[33m\"main\"\u{1b}[0m>\n" +
    "    <\u{1b}[94mp\u{1b}[0m>Hello &amp; <\u{1b}[94mb\u{1b}[0m>world</\u{1b}[94mb\u{1b}[0m></\u{1b}[94mp\u{1b}[0m>\n" +
    "    <\u{1b}[94mscript\u{1b}[0m>\u{1b}[94mvar\u{1b}[0m\u{1b}[90m \u{1b}[0mx\u{1b}[90m \u{1b}[0m=\u{1b}[90m \u{1b}[0m\u{1b}[94m1\u{1b}[0m;</\u{1b}[94mscript\u{1b}[0m>\n" +
    "  </\u{1b}[94mbody\u{1b}[0m>\n" +
    "</\u{1b}[94mhtml\u{1b}[0m>\n" +
    "\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

