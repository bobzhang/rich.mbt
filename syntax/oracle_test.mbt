///|
test "oracle 3: python ansi_light {'indent_guides': True} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="ansi_light",
    indent_guides=true,
  )
  let expected : String = "import os\n" +
    "\n" +
    "@decorator\n" +
    "class Foo(Base):\n" +
    "│   \"\"\"Docstring with a very long line that is goi\n" +
    "│   \n" +
    "│   def method(self, x: int = 0x1F) -> str:\n" +
    "│   │   if x > 10 and not None:\n" +
    "│   │   return f\"value {x!r}\"  # comment\n" +
    "│   │   return 'café 中文'\n" +
    "\n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

///|
test "oracle 4: python dracula {'indent_guides': True, 'line_numbers': True, 'line_range': (2, 6)} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="dracula",
    indent_guides=true,
    line_numbers=true,
    line_range=(Some(2), Some(6)),
  )
  let expected : String = "\u{1b}[1;38;2;227;227;223;48;2;40;42;54m  \u{1b}[0m\u{1b}[38;2;102;103;110;48;2;40;42;54m 2 \u{1b}[0m\u{1b}[48;2;40;42;54m                                                       \u{1b}[0m\n" +
    "\u{1b}[1;38;2;227;227;223;48;2;40;42;54m  \u{1b}[0m\u{1b}[38;2;102;103;110;48;2;40;42;54m 3 \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;40;42;54m@decorator\u{1b}[0m\u{1b}[48;2;40;42;54m                                             \u{1b}[0m\n" +
    "\u{1b}[1;38;2;227;227;223;48;2;40;42;54m  \u{1b}[0m\u{1b}[38;2;102;103;110;48;2;40;42;54m 4 \u{1b}[0m\u{1b}[38;2;255;121;198;48;2;40;42;54mclass\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;40;42;54m \u{1b}[0m\u{1b}[38;2;80;250;123;48;2;40;42;54mFoo\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;40;42;54m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;40;42;54mBase\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;40;42;54m)\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;40;42;54m:\u{1b}[0m\u{1b}[48;2;40;42;54m                                       \u{1b}[0m\n" +
    "\u{1b}[1;38;2;227;227;223;48;2;40;42;54m  \u{1b}[0m\u{1b}[38;2;102;103;110;48;2;40;42;54m 5 \u{1b}[0m\u{1b}[2;38;2;98;114;164;48;2;40;42;54m│   \u{1b}[0m\u{1b}[38;2;189;147;249;48;2;40;42;54m\"\"\"Docstring with a very long line that is going to\u{1b}[0m\n" +
    "\u{1b}[1;38;2;227;227;223;48;2;40;42;54m  \u{1b}[0m\u{1b}[38;2;102;103;110;48;2;40;42;54m 6 \u{1b}[0m\u{1b}[48;2;40;42;54m                                                       \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

///|
test "oracle 5: python solarized-light {'line_range': (3, None), 'highlight_lines': [4]} {'width': 45, 'color_system': '256'}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="solarized-light",
    line_range=(Some(3), None),
    highlight_lines=[4],
  )
  let expected : String = "\u{1b}[38;5;32;48;5;230m@decorator\u{1b}[0m\u{1b}[48;5;230m                                   \u{1b}[0m\n" +
    "\u{1b}[38;5;100;48;5;230mclass\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;32;48;5;230mFoo\u{1b}[0m\u{1b}[38;5;242;48;5;230m(\u{1b}[0m\u{1b}[38;5;242;48;5;230mBase\u{1b}[0m\u{1b}[38;5;242;48;5;230m)\u{1b}[0m\u{1b}[38;5;242;48;5;230m:\u{1b}[0m\u{1b}[48;5;230m                             \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m    \u{1b}[0m\u{1b}[38;5;246;48;5;230m\"\"\"Docstring with a very long line that i\u{1b}[0m\n" +
    "\u{1b}[48;5;230m                                             \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m    \u{1b}[0m\u{1b}[38;5;100;48;5;230mdef\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;32;48;5;230mmethod\u{1b}[0m\u{1b}[38;5;242;48;5;230m(\u{1b}[0m\u{1b}[38;5;32;48;5;230mself\u{1b}[0m\u{1b}[38;5;242;48;5;230m,\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230mx\u{1b}[0m\u{1b}[38;5;242;48;5;230m:\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;32;48;5;230mint\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;246;48;5;230m=\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;36;48;5;230m0x1F\u{1b}[0m\u{1b}[38;5;242;48;5;230m)\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;246;48;5;230m-\u{1b}[0m\u{1b}[38;5;246;48;5;230m>\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;32;48;5;230mstr\u{1b}[0m\u{1b}[38;5;242;48;5;230m:\u{1b}[0m\u{1b}[48;5;230m  \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m        \u{1b}[0m\u{1b}[38;5;100;48;5;230mif\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;242;48;5;230mx\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;246;48;5;230m>\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;36;48;5;230m10\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;100;48;5;230mand\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;100;48;5;230mnot\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;36;48;5;230mNone\u{1b}[0m\u{1b}[38;5;242;48;5;230m:\u{1b}[0m\u{1b}[48;5;230m              \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m        \u{1b}[0m\u{1b}[38;5;100;48;5;230mreturn\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;36;48;5;230mf\u{1b}[0m\u{1b}[38;5;36;48;5;230m\"\u{1b}[0m\u{1b}[38;5;36;48;5;230mvalue \u{1b}[0m\u{1b}[38;5;36;48;5;230m{\u{1b}[0m\u{1b}[38;5;242;48;5;230mx\u{1b}[0m\u{1b}[38;5;36;48;5;230m!r}\u{1b}[0m\u{1b}[38;5;36;48;5;230m\"\u{1b}[0m\u{1b}[38;5;242;48;5;230m  \u{1b}[0m\u{1b}[3;38;5;246;48;5;230m# comment\u{1b}[0m\u{1b}[48;5;230m     \u{1b}[0m\n" +
    "\u{1b}[38;5;242;48;5;230m        \u{1b}[0m\u{1b}[38;5;100;48;5;230mreturn\u{1b}[0m\u{1b}[38;5;242;48;5;230m \u{1b}[0m\u{1b}[38;5;36;48;5;230m'\u{1b}[0m\u{1b}[38;5;36;48;5;230mcafé 中文\u{1b}[0m\u{1b}[38;5;36;48;5;230m'\u{1b}[0m\u{1b}[48;5;230m                   \u{1b}[0m\n" +
    "\u{1b}[48;5;230m                                             \u{1b}[0m\n"
  assert_eq(oracle_render(syntax, width=45, color_system=Some("256")), expected)
}

///|
test "oracle 6: python github-dark {'line_numbers': True, 'highlight_lines': [1, 3], 'start_line': 98} {'width': 80, 'color_system': 'standard'}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="github-dark",
    line_numbers=true,
    highlight_lines=[1, 3],
    start_line=98,
  )
  let expected : String = "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m 98 \u{1b}[0m\u{1b}[91;40mimport\u{1b}[0m\u{1b}[90;40m \u{1b}[0m\u{1b}[91;40mos\u{1b}[0m\u{1b}[40m                                                                 \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m 99 \u{1b}[0m\u{1b}[40m                                                                          \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m100 \u{1b}[0m\u{1b}[1;37;40m@decorator\u{1b}[0m\u{1b}[40m                                                                \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m101 \u{1b}[0m\u{1b}[91;40mclass\u{1b}[0m\u{1b}[90;40m \u{1b}[0m\u{1b}[1;91;40mFoo\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[97;40mBase\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[97;40m:\u{1b}[0m\u{1b}[40m                                                          \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m102 \u{1b}[0m\u{1b}[90;40m    \u{1b}[0m\u{1b}[96;40m\"\"\"Docstring with a very long line that is going to need wrapping when\u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m103 \u{1b}[0m\u{1b}[40m                                                                          \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m104 \u{1b}[0m\u{1b}[97;40m    \u{1b}[0m\u{1b}[91;40mdef\u{1b}[0m\u{1b}[90;40m \u{1b}[0m\u{1b}[1;37;40mmethod\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[97;40mself\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40mx\u{1b}[0m\u{1b}[97;40m:\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40mint\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[1;91;40m=\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[96;40m0x1F\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[1;91;40m-\u{1b}[0m\u{1b}[1;91;40m>\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40mstr\u{1b}[0m\u{1b}[97;40m:\u{1b}[0m\u{1b}[40m                               \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m105 \u{1b}[0m\u{1b}[97;40m        \u{1b}[0m\u{1b}[91;40mif\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40mx\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[1;91;40m>\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[96;40m10\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[1;91;40mand\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[1;91;40mnot\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[96;40mNone\u{1b}[0m\u{1b}[97;40m:\u{1b}[0m\u{1b}[40m                                           \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m106 \u{1b}[0m\u{1b}[97;40m        \u{1b}[0m\u{1b}[91;40mreturn\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[96;40mf\u{1b}[0m\u{1b}[96;40m\"\u{1b}[0m\u{1b}[96;40mvalue \u{1b}[0m\u{1b}[96;40m{\u{1b}[0m\u{1b}[97;40mx\u{1b}[0m\u{1b}[96;40m!r}\u{1b}[0m\u{1b}[96;40m\"\u{1b}[0m\u{1b}[97;40m  \u{1b}[0m\u{1b}[3;37;40m# comment\u{1b}[0m\u{1b}[40m                                  \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m107 \u{1b}[0m\u{1b}[97;40m        \u{1b}[0m\u{1b}[91;40mreturn\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[96;40m'\u{1b}[0m\u{1b}[96;40mcafé 中文\u{1b}[0m\u{1b}[96;40m'\u{1b}[0m\u{1b}[40m                                                \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m108 \u{1b}[0m\u{1b}[40m                                                                          \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=80, color_system=Some("standard")),
    expected,
  )
}

///|
test "oracle 7: python nord {'padding': (1, 2), 'background_color': '#203040'} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="nord",
    padding=[1, 2],
    background_color="#203040",
  )
  let expected : String = "                                                  \n" +
    "  import os                                       \n" +
    "                                                  \n" +
    "  @decorator                                      \n" +
    "  class Foo(Base):                                \n" +
    "      \"\"\"Docstring with a very long line that is  \n" +
    "                                                  \n" +
    "      def method(self, x: int = 0x1F) -> str:     \n" +
    "          if x > 10 and not None:                 \n" +
    "          return f\"value {x!r}\"  # comment        \n" +
    "          return 'café 中文'                      \n" +
    "                                                  \n" +
    "                                                  \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

///|
test "oracle 8: python emacs {'tab_size': 8, 'word_wrap': True} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="emacs",
    tab_size=8,
    word_wrap=true,
  )
  let expected : String = "\u{1b}[1;38;2;170;34;255;48;2;248;248;248mimport\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;0;0;255;48;2;248;248;248mos\u{1b}[0m\u{1b}[48;2;248;248;248m                                                   \u{1b}[0m\n" +
    "\u{1b}[48;2;248;248;248m                                                            \u{1b}[0m\n" +
    "\u{1b}[38;2;170;34;255;48;2;248;248;248m@decorator\u{1b}[0m\u{1b}[48;2;248;248;248m                                                  \u{1b}[0m\n" +
    "\u{1b}[1;38;2;170;34;255;48;2;248;248;248mclass\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;255;48;2;248;248;248mFoo\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m(\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mBase\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m)\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m:\u{1b}[0m\u{1b}[48;2;248;248;248m                                            \u{1b}[0m\n" +
    "\u{1b}[38;2;187;187;187;48;2;248;248;248m    \u{1b}[0m\u{1b}[3;38;2;187;68;68;48;2;248;248;248m\"\"\"Docstring with a very long line that is going to need\u{1b}[0m\n" +
    "\u{1b}[3;38;2;187;68;68;48;2;248;248;248mwrapping when the width is small.\"\"\"\u{1b}[0m\u{1b}[48;2;248;248;248m                        \u{1b}[0m\n" +
    "\u{1b}[48;2;248;248;248m                                                            \u{1b}[0m\n" +
    "\u{1b}[38;2;0;0;0;48;2;248;248;248m    \u{1b}[0m\u{1b}[1;38;2;170;34;255;48;2;248;248;248mdef\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;160;0;48;2;248;248;248mmethod\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m(\u{1b}[0m\u{1b}[38;2;170;34;255;48;2;248;248;248mself\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m,\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mx\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m:\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;170;34;255;48;2;248;248;248mint\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m=\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m0x1F\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m)\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m-\u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m>\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;170;34;255;48;2;248;248;248mstr\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m:\u{1b}[0m\u{1b}[48;2;248;248;248m                 \u{1b}[0m\n" +
    "\u{1b}[38;2;0;0;0;48;2;248;248;248m        \u{1b}[0m\u{1b}[1;38;2;170;34;255;48;2;248;248;248mif\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mx\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m>\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m10\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;170;34;255;48;2;248;248;248mand\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;170;34;255;48;2;248;248;248mnot\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;170;34;255;48;2;248;248;248mNone\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m:\u{1b}[0m\u{1b}[48;2;248;248;248m                             \u{1b}[0m\n" +
    "\u{1b}[38;2;0;0;0;48;2;248;248;248m                \u{1b}[0m\u{1b}[1;38;2;170;34;255;48;2;248;248;248mreturn\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;187;68;68;48;2;248;248;248mf\u{1b}[0m\u{1b}[38;2;187;68;68;48;2;248;248;248m\"\u{1b}[0m\u{1b}[38;2;187;68;68;48;2;248;248;248mvalue \u{1b}[0m\u{1b}[1;38;2;187;102;136;48;2;248;248;248m{\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mx\u{1b}[0m\u{1b}[1;38;2;187;102;136;48;2;248;248;248m!r}\u{1b}[0m\u{1b}[38;2;187;68;68;48;2;248;248;248m\"\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m  \u{1b}[0m\u{1b}[3;38;2;0;136;0;48;2;248;248;248m# comment\u{1b}[0m\u{1b}[48;2;248;248;248m            \u{1b}[0m\n" +
    "\u{1b}[38;2;0;0;0;48;2;248;248;248m        \u{1b}[0m\u{1b}[1;38;2;170;34;255;48;2;248;248;248mreturn\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;187;68;68;48;2;248;248;248m'\u{1b}[0m\u{1b}[38;2;187;68;68;48;2;248;248;248mcafé 中文\u{1b}[0m\u{1b}[38;2;187;68;68;48;2;248;248;248m'\u{1b}[0m\u{1b}[48;2;248;248;248m                                  \u{1b}[0m\n" +
    "\u{1b}[48;2;248;248;248m                                                            \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

