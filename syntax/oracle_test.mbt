    "\u{1b}[2;90m  \u{1b}[0m\u{1b}[94m\"name\"\u{1b}[0m:\u{1b}[90m \u{1b}[0m\u{1b}[33m\"rich\"\u{1b}[0m,\n" +
    "\u{1b}[2;90m  \u{1b}[0m\u{1b}[94m\"version\"\u{1b}[0m:\u{1b}[90m \u{1b}[0m[\u{1b}[94m1\u{1b}[0m,\u{1b}[90m \u{1b}[0m\u{1b}[94m2.5\u{1b}[0m,\u{1b}[90m \u{1b}[0m\u{1b}[94m-3e10\u{1b}[0m],\n" +
    "\u{1b}[2;90m  \u{1b}[0m\u{1b}[94m\"ok\"\u{1b}[0m:\u{1b}[90m \u{1b}[0m\u{1b}[94mtrue\u{1b}[0m,\n" +
    "\u{1b}[2;90m  \u{1b}[0m\u{1b}[94m\"none\"\u{1b}[0m:\u{1b}[90m \u{1b}[0m\u{1b}[94mnull\u{1b}[0m\n" +
    "}\n" +
    "\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

