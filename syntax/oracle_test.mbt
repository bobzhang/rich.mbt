///|
test "oracle 77: yaml vim {'line_range': (3, None), 'highlight_lines': [4]} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_yaml,
    "yaml",
    theme="vim",
    line_range=(Some(3), None),
    highlight_lines=[4],
  )
  let expected : String = "  - one                                           \n" +
    "  - \"two\"                                         \n" +
    "nested:                                           \n" +
    "  number: 42  # comment                           \n" +
    "                                                  \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

