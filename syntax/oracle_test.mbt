  )
  let expected : String = "\u{1b}[1;38;2;116;135;140;48;2;253;246;227m  \u{1b}[0m\u{1b}[38;2;207;209;198;48;2;253;246;227m2 \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227mWHERE\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227mage\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;147;161;161;48;2;253;246;227m>\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;42;161;152;48;2;253;246;227m21\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227mAND\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227mname\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227mLIKE\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;42;161;152;48;2;253;246;227m'A%'\u{1b}[0m\u{1b}[48;2;253;246;227m                       \u{1b}[0m\n" +
    "\u{1b}[1;38;2;116;135;140;48;2;253;246;227m  \u{1b}[0m\u{1b}[38;2;207;209;198;48;2;253;246;227m3 \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227mORDER\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227mBY\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227mname\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227mDESC\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m;\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[3;38;2;147;161;161;48;2;253;246;227m-- comment\u{1b}[0m\u{1b}[48;2;253;246;227m                          \u{1b}[0m\n" +
    "\u{1b}[1;38;2;116;135;140;48;2;253;246;227m  \u{1b}[0m\u{1b}[38;2;207;209;198;48;2;253;246;227m4 \u{1b}[0m\u{1b}[48;2;253;246;227m                                                        \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

