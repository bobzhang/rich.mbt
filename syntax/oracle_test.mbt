    "\u{1b}[38;2;205;205;0;48;2;0;0;0mWHERE\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0mage\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;51;153;204;48;2;0;0;0m>\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;205;0;205;48;2;0;0;0m21\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;205;205;0;48;2;0;0;0mAND\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0mname\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;205;205;0;48;2;0;0;0mLIKE\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;205;0;0;48;2;0;0;0m'A%'\u{1b}[0m\u{1b}[48;2;0;0;0m                           \u{1b}[0m\n" +
    "\u{1b}[38;2;205;205;0;48;2;0;0;0mORDER\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;205;205;0;48;2;0;0;0mBY\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0mname\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;205;205;0;48;2;0;0;0mDESC\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m;\u{1b}[0m\u{1b}[38;2;204;204;204;48;2;0;0;0m \u{1b}[0m\u{1b}[38;2;0;0;128;48;2;0;0;0m-- comment\u{1b}[0m\u{1b}[48;2;0;0;0m                              \u{1b}[0m\n" +
    "\u{1b}[48;2;0;0;0m                                                            \u{1b}[0m\n"
  assert_eq(
