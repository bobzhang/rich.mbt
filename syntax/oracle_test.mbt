///|
test "oracle 51: html gruvbox-dark {'indent_guides': True} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_html,
    "html",
    theme="gruvbox-dark",
    indent_guides=true,
  )
  let expected : String = "<!DOCTYPE html>                                   \n" +
    "<html>                                            \n" +
    "  <body class=\"main\">                             \n" +
    "│   <p>Hello &amp; <b>world</b></p>               \n" +
    "│   <script>var x = 1;</script>                   \n" +
    "  </body>                                         \n" +
    "</html>                                           \n" +
    "                                                  \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

///|
test "oracle 52: html one-dark {'indent_guides': True, 'line_numbers': True, 'line_range': (2, 6)} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_html,
    "html",
    theme="one-dark",
    indent_guides=true,
    line_numbers=true,
