test "oracle 30: javascript ansi_light {'line_numbers': True, 'highlight_lines': [1, 3], 'start_line': 98} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_javascript,
    "javascript",
    theme="ansi_light",
    line_numbers=true,
    highlight_lines=[1, 3],
    start_line=98,
  )
  let expected : String = "  \u{1b}[2m 98 \u{1b}[0m\u{1b}[2m// A comment\u{1b}[0m\n" +
    "  \u{1b}[2m 99 \u{1b}[0m\u{1b}[34mconst\u{1b}[0m\u{1b}[37m \u{1b}[0madd\u{1b}[37m \u{1b}[0m=\u{1b}[37m \u{1b}[0m(a,\u{1b}[37m \u{1b}[0mb)\u{1b}[37m \u{1b}[0m=>\u{1b}[37m \u{1b}[0ma\u{1b}[37m \u{1b}[0m+\u{1b}[37m \u{1b}[0mb;\n" +
    "  \u{1b}[2m100 \u{1b}[0m\u{1b}[34mclass\u{1b}[0m\u{1b}[37m \u{1b}[0mPoint\u{1b}[37m \u{1b}[0m{\n" +
    "  \u{1b}[2m101 \u{1b}[0m\u{1b}[37m  \u{1b}[0m\u{1b}[34mconstructor\u{1b}[0m(x,\u{1b}[37m \u{1b}[0my)\u{1b}[37m \u{1b}[0m{\u{1b}[37m \u{1b}[0m\u{1b}[34mthis\u{1b}[0m.x\u{1b}[37m \u{1b}[0m=\u{1b}[37m \u{1b}[0mx;\u{1b}[37m \u{1b}[0m\u{1b}[34mthis\u{1b}[0m.y\u{1b}[37m \u{1b}[0m=\u{1b}[37m \u{1b}[0my;\u{1b}[37m \u{1b}[0m}\n" +
    "  \u{1b}[2m102 \u{1b}[0m}\n" +
    "  \u{1b}[2m103 \u{1b}[0mconsole.log(\u{1b}[33m`\u{1b}[0m\u{1b}[33msum: \u{1b}[0m\u{1b}[33m${\u{1b}[0madd(\u{1b}[34m1\u{1b}[0m,\u{1b}[37m \u{1b}[0m\u{1b}[34m2\u{1b}[0m)\u{1b}[33m}\u{1b}[0m\u{1b}[33m`\u{1b}[0m,\u{1b}[37m \u{1b}[0m\u{1b}[33m/re+gex/g\u{1b}[0m,\u{1b}[37m \u{1b}[0m\u{1b}[34mnull\u{1b}[0m);\n" +
    "  \u{1b}[2m104 \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

