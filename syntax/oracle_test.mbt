test "oracle 132: python monokai {'line_numbers': True} {'width': 70, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="monokai",
    line_numbers=true,
  )
  let expected : String = "\u{1b}[1;38;2;227;227;221;48;2;39;40;34m  \u{1b}[0m\u{1b}[38;2;101;102;96;48;2;39;40;34m 1 \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mos\u{1b}[0m\u{1b}[48;2;39;40;34m                                                        \u{1b}[0m\n" +
    "\u{1b}[1;38;2;227;227;221;48;2;39;40;34m  \u{1b}[0m\u{1b}[38;2;101;102;96;48;2;39;40;34m 2 \u{1b}[0m\u{1b}[48;2;39;40;34m                                                                 \u{1b}[0m\n" +
    "\u{1b}[1;38;2;227;227;221;48;2;39;40;34m  \u{1b}[0m\u{1b}[38;2;101;102;96;48;2;39;40;34m 3 \u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34m@decorator\u{1b}[0m\u{1b}[48;2;39;40;34m                                                       \u{1b}[0m\n" +
    "\u{1b}[1;38;2;227;227;221;48;2;39;40;34m  \u{1b}[0m\u{1b}[38;2;101;102;96;48;2;39;40;34m 4 \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mclass\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34mFoo\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mBase\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m:\u{1b}[0m\u{1b}[48;2;39;40;34m                                                 \u{1b}[0m\n" +
