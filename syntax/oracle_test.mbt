test "oracle 96: sql default {} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(sample_sql, "sql", theme="default")
  let expected : String = "\u{1b}[1;38;2;0;128;0;48;2;248;248;248mSELECT\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mid\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m,\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mname\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mFROM\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248musers\u{1b}[0m\u{1b}[48;2;248;248;248m                                  \u{1b}[0m\n" +
    "\u{1b}[1;38;2;0;128;0;48;2;248;248;248mWHERE\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mage\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m>\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m21\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mAND\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mname\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mLIKE\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;186;33;33;48;2;248;248;248m'A%'\u{1b}[0m\u{1b}[48;2;248;248;248m                           \u{1b}[0m\n" +
    "\u{1b}[1;38;2;0;128;0;48;2;248;248;248mORDER\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mBY\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mname\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mDESC\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m;\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[3;38;2;61;123;123;48;2;248;248;248m-- comment\u{1b}[0m\u{1b}[48;2;248;248;248m                              \u{1b}[0m\n" +
    "\u{1b}[48;2;248;248;248m                                                            \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

