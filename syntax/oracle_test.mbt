test "oracle 85: bash gruvbox-dark {'line_numbers': True} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_bash,
    "bash",
    theme="gruvbox-dark",
    line_numbers=true,
  )
  let expected : String = "\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m1 \u{1b}[0m\u{1b}[3;38;2;146;131;116;48;2;40;40;40m#!/bin/bash\u{1b}[0m\u{1b}[48;2;40;40;40m                                             \u{1b}[0m\n" +
    "\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m2 \u{1b}[0m\u{1b}[38;2;251;73;52;48;2;40;40;40mfor\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40mf\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;251;73;52;48;2;40;40;40min\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m*.txt\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m;\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;251;73;52;48;2;40;40;40mdo\u{1b}[0m\u{1b}[48;2;40;40;40m                                      \u{1b}[0m\n" +
    "\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m3 \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;254;128;25;48;2;40;40;40mecho\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;184;187;38;48;2;40;40;40m\"\u{1b}[0m\u{1b}[38;2;184;187;38;48;2;40;40;40mfile: \u{1b}[0m\u{1b}[38;2;131;165;152;48;2;40;40;40m$f\u{1b}[0m\u{1b}[38;2;184;187;38;48;2;40;40;40m\"\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m|\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40mgrep\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m-v\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;184;187;38;48;2;40;40;40m'^#'\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m>\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m/dev/null\u{1b}[0m\u{1b}[48;2;40;40;40m            \u{1b}[0m\n" +
    "\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m4 \u{1b}[0m\u{1b}[38;2;251;73;52;48;2;40;40;40mdone\u{1b}[0m\u{1b}[48;2;40;40;40m                                                    \u{1b}[0m\n" +
    "\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m5 \u{1b}[0m\u{1b}[38;2;254;128;25;48;2;40;40;40mexport\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;131;165;152;48;2;40;40;40mX\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m=\u{1b}[0m\u{1b}[38;2;184;187;38;48;2;40;40;40m${\u{1b}[0m\u{1b}[38;2;131;165;152;48;2;40;40;40mHOME\u{1b}[0m\u{1b}[38;2;251;73;52;48;2;40;40;40m:-\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m/tmp\u{1b}[0m\u{1b}[38;2;184;187;38;48;2;40;40;40m}\u{1b}[0m\u{1b}[48;2;40;40;40m                                  \u{1b}[0m\n" +
    "\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m6 \u{1b}[0m\u{1b}[48;2;40;40;40m                                                        \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=60, color_system=Some("truecolor")),
    expected,
  )
}

