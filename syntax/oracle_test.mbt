    sample_json,
    "json",
    theme="monokai",
    line_numbers=true,
  )
  let expected : String = "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m1 \u{1b}[0m\u{1b}[97;40m{\u{1b}[0m\u{1b}[40m                                                                           \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m2 \u{1b}[0m\u{1b}[97;40m  \u{1b}[0m\u{1b}[91;40m\"name\"\u{1b}[0m\u{1b}[97;40m:\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[93;40m\"rich\"\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[40m                                                           \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m3 \u{1b}[0m\u{1b}[97;40m  \u{1b}[0m\u{1b}[91;40m\"version\"\u{1b}[0m\u{1b}[97;40m:\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m[\u{1b}[0m\u{1b}[37;40m1\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40m2.5\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40m-3e10\u{1b}[0m\u{1b}[97;40m],\u{1b}[0m\u{1b}[40m                                               \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m4 \u{1b}[0m\u{1b}[97;40m  \u{1b}[0m\u{1b}[91;40m\"ok\"\u{1b}[0m\u{1b}[97;40m:\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[96;40mtrue\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[40m                                                               \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m5 \u{1b}[0m\u{1b}[97;40m  \u{1b}[0m\u{1b}[91;40m\"none\"\u{1b}[0m\u{1b}[97;40m:\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[96;40mnull\u{1b}[0m\u{1b}[40m                                                              \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m6 \u{1b}[0m\u{1b}[97;40m}\u{1b}[0m\u{1b}[40m                                                                           \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m7 \u{1b}[0m\u{1b}[40m                                                                            \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=80, color_system=Some("standard")),
    expected,
  )
}

