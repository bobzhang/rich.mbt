    "\u{1b}[91;40mconst\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40madd\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m=\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[97;40ma\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40mb\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m=>\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40ma\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m+\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40mb\u{1b}[0m\u{1b}[97;40m;\u{1b}[0m\u{1b}[40m                                                    \u{1b}[0m\n" +
    "\u{1b}[91;40mclass\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40mPoint\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m{\u{1b}[0m\u{1b}[40m                                                                   \u{1b}[0m\n" +
    "\u{1b}[97;40m  \u{1b}[0m\u{1b}[91;40mconstructor\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[97;40mx\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40my\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m{\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[91;40mthis\u{1b}[0m\u{1b}[97;40m.\u{1b}[0m\u{1b}[97;40mx\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m=\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40mx\u{1b}[0m\u{1b}[97;40m;\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[91;40mthis\u{1b}[0m\u{1b}[97;40m.\u{1b}[0m\u{1b}[97;40my\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m=\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40my\u{1b}[0m\u{1b}[97;40m;\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m}\u{1b}[0m\u{1b}[40m                                 \u{1b}[0m\n" +
    "\u{1b}[97;40m}\u{1b}[0m\u{1b}[40m                                                                               \u{1b}[0m\n" +
    "\u{1b}[97;40mconsole\u{1b}[0m\u{1b}[97;40m.\u{1b}[0m\u{1b}[97;40mlog\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[93;40m`\u{1b}[0m\u{1b}[93;40msum: \u{1b}[0m\u{1b}[93;40m${\u{1b}[0m\u{1b}[97;40madd\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[37;40m1\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40m2\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[93;40m}\u{1b}[0m\u{1b}[93;40m`\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[93;40m/re+gex/g\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[91;40mnull\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[97;40m;\u{1b}[0m\u{1b}[40m                              \u{1b}[0m\n" +
    "\u{1b}[40m                                                                                \u{1b}[0m\n"
  assert_eq(
