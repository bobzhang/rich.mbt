    "\u{1b}[1;38;5;253;48;5;236m  \u{1b}[0m\u{1b}[38;5;241;48;5;236m3 \u{1b}[0m\u{1b}[38;5;117;48;5;236mint\u{1b}[0m\u{1b}[38;5;231;48;5;236m \u{1b}[0m\u{1b}[38;5;84;48;5;236mmain\u{1b}[0m\u{1b}[38;5;231;48;5;236m(\u{1b}[0m\u{1b}[38;5;117;48;5;236mint\u{1b}[0m\u{1b}[38;5;231;48;5;236m \u{1b}[0m\u{1b}[38;5;231;48;5;236margc\u{1b}[0m\u{1b}[38;5;231;48;5;236m,\u{1b}[0m\u{1b}[38;5;231;48;5;236m \u{1b}[0m\u{1b}[38;5;117;48;5;236mchar\u{1b}[0m\u{1b}[38;5;231;48;5;236m \u{1b}[0m\u{1b}[48;5;236m      \u{1b}[0m\n" +
