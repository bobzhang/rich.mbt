  let syntax = @syntax.Syntax::new(
    sample_javascript,
    "javascript",
    theme="one-dark",
    line_numbers=true,
  )
  let expected : String = "  1 // A comment                                  \n" +
    "  2 const add = (a, b) => a + b;                  \n" +
    "  3 class Point {                                 \n" +
    "  4   constructor(x, y) { this.x = x; this.y = y; \n" +
    "  5 }                                             \n" +
    "  6 console.log(`sum: ${add(1, 2)}`, /re+gex/g, nu\n" +
    "  7                                               \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

///|
test "oracle 26: javascript no-such-theme {'line_numbers': True, 'word_wrap': True, 'code_width': 30} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_javascript,
    "javascript",
    theme="no-such-theme",
    line_numbers=true,
    word_wrap=true,
    code_width=30,
  )
  let expected : String = "\u{1b}[1;38;2;24;24;24;48;2;248;248;248m  \u{1b}[0m\u{1b}[38;2;173;173;173;48;2;248;248;248m1 \u{1b}[0m\u{1b}[3;38;2;61;123;123;48;2;248;248;248m// A comment\u{1b}[0m\u{1b}[48;2;248;248;248m                  \u{1b}[0m\n" +
    "\u{1b}[1;38;2;24;24;24;48;2;248;248;248m  \u{1b}[0m\u{1b}[38;2;173;173;173;48;2;248;248;248m2 \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mconst\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248madd\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m=\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m(\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248ma\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m,\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mb\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m)\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m=>\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248ma\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m+\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mb\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m;\u{1b}[0m\u{1b}[48;2;248;248;248m  \u{1b}[0m\n" +
    "\u{1b}[1;38;2;24;24;24;48;2;248;248;248m  \u{1b}[0m\u{1b}[38;2;173;173;173;48;2;248;248;248m3 \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mclass\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mPoint\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m{\u{1b}[0m\u{1b}[48;2;248;248;248m                 \u{1b}[0m\n" +
    "\u{1b}[1;38;2;24;24;24;48;2;248;248;248m  \u{1b}[0m\u{1b}[38;2;173;173;173;48;2;248;248;248m4 \u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m  \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mconstructor\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m(\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mx\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m,\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248my\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m)\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m{\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mthis\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m.\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mx\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m=\u{1b}[0m\n" +
    "\u{1b}[48;2;248;248;248m    \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mx\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m;\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mthis\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m.\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248my\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m=\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248my\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m;\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m}\u{1b}[0m\u{1b}[48;2;248;248;248m              \u{1b}[0m\n" +
    "\u{1b}[1;38;2;24;24;24;48;2;248;248;248m  \u{1b}[0m\u{1b}[38;2;173;173;173;48;2;248;248;248m5 \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m}\u{1b}[0m\u{1b}[48;2;248;248;248m                             \u{1b}[0m\n" +
    "\u{1b}[1;38;2;24;24;24;48;2;248;248;248m  \u{1b}[0m\u{1b}[38;2;173;173;173;48;2;248;248;248m6 \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mconsole\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m.\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248mlog\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m(\u{1b}[0m\u{1b}[38;2;186;33;33;48;2;248;248;248m`\u{1b}[0m\u{1b}[38;2;186;33;33;48;2;248;248;248msum: \u{1b}[0m\u{1b}[1;38;2;164;90;119;48;2;248;248;248m${\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248madd\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m(\u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m1\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m,\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[48;2;248;248;248m   \u{1b}[0m\n" +
    "\u{1b}[48;2;248;248;248m    \u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m2\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m)\u{1b}[0m\u{1b}[1;38;2;164;90;119;48;2;248;248;248m}\u{1b}[0m\u{1b}[38;2;186;33;33;48;2;248;248;248m`\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m,\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;164;90;119;48;2;248;248;248m/re+gex/g\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m,\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248mnull\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m)\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m;\u{1b}[0m\u{1b}[48;2;248;248;248m       \u{1b}[0m\n" +
    "\u{1b}[1;38;2;24;24;24;48;2;248;248;248m  \u{1b}[0m\u{1b}[38;2;173;173;173;48;2;248;248;248m7 \u{1b}[0m\u{1b}[48;2;248;248;248m                              \u{1b}[0m\n"
  assert_eq(
