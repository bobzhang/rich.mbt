///|
test "oracle 108: diff github-dark {} {'width': 45, 'color_system': '256'}" {
  let syntax = @syntax.Syntax::new(sample_diff, "diff", theme="github-dark")
  let expected : String = "\u{1b}[38;5;216;48;5;52m--- a/file.txt\u{1b}[0m\u{1b}[48;5;16m                               \u{1b}[0m\n" +
    "\u{1b}[38;5;77;48;5;22m+++ b/file.txt\u{1b}[0m\u{1b}[48;5;16m                               \u{1b}[0m\n" +
    "\u{1b}[38;5;111;48;5;16m@@ -1,3 +1,3 @@\u{1b}[0m\u{1b}[48;5;16m                              \u{1b}[0m\n" +
    "\u{1b}[38;5;243;48;5;16m \u{1b}[0m\u{1b}[38;5;195;48;5;16mcontext\u{1b}[0m\u{1b}[48;5;16m                                     \u{1b}[0m\n" +
    "\u{1b}[38;5;216;48;5;52m-removed line\u{1b}[0m\u{1b}[48;5;16m                                \u{1b}[0m\n" +
    "\u{1b}[38;5;77;48;5;22m+added line\u{1b}[0m\u{1b}[48;5;16m                                  \u{1b}[0m\n" +
    "\u{1b}[48;5;16m                                             \u{1b}[0m\n"
  assert_eq(oracle_render(syntax, width=45, color_system=Some("256")), expected)
}

