  )
  let expected : String = "\u{1b}[1;38;2;157;164;177;48;2;40;44;52m  \u{1b}[0m\u{1b}[38;2;79;84;93;48;2;40;44;52m2 \u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m<\u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mhtml\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m>\u{1b}[0m\u{1b}[48;2;40;44;52m                                                  \u{1b}[0m\n" +
    "\u{1b}[1;38;2;157;164;177;48;2;40;44;52m  \u{1b}[0m\u{1b}[38;2;79;84;93;48;2;40;44;52m3 \u{1b}[0m\u{1b}[2;38;2;127;132;142;48;2;40;44;52m  \u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m<\u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mbody\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m \u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mclass\u{1b}[0m\u{1b}[38;2;86;182;194;48;2;40;44;52m=\u{1b}[0m\u{1b}[38;2;152;195;121;48;2;40;44;52m\"main\"\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m>\u{1b}[0m\u{1b}[48;2;40;44;52m                                   \u{1b}[0m\n" +
    "\u{1b}[1;38;2;157;164;177;48;2;40;44;52m  \u{1b}[0m\u{1b}[38;2;79;84;93;48;2;40;44;52m4 \u{1b}[0m\u{1b}[2;38;2;127;132;142;48;2;40;44;52m│   \u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m<\u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mp\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m>\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52mHello \u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52m&amp;\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m \u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m<\u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mb\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m>\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52mworld\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m<\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m/\u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mb\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m>\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m<\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m/\u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mp\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m>\u{1b}[0m\u{1b}[48;2;40;44;52m                     \u{1b}[0m\n" +
    "\u{1b}[1;38;2;157;164;177;48;2;40;44;52m  \u{1b}[0m\u{1b}[38;2;79;84;93;48;2;40;44;52m5 \u{1b}[0m\u{1b}[2;38;2;127;132;142;48;2;40;44;52m│   \u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m<\u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mscript\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m>\u{1b}[0m\u{1b}[38;2;198;120;221;48;2;40;44;52mvar\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m \u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mx\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m \u{1b}[0m\u{1b}[38;2;86;182;194;48;2;40;44;52m=\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m \u{1b}[0m\u{1b}[38;2;209;154;102;48;2;40;44;52m1\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m;\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m<\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m/\u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mscript\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m>\u{1b}[0m\u{1b}[48;2;40;44;52m                         \u{1b}[0m\n" +
    "\u{1b}[1;38;2;157;164;177;48;2;40;44;52m  \u{1b}[0m\u{1b}[38;2;79;84;93;48;2;40;44;52m6 \u{1b}[0m\u{1b}[2;38;2;127;132;142;48;2;40;44;52m  \u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m<\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m/\u{1b}[0m\u{1b}[38;2;224;108;117;48;2;40;44;52mbody\u{1b}[0m\u{1b}[38;2;171;178;191;48;2;40;44;52m>\u{1b}[0m\u{1b}[48;2;40;44;52m                                               \u{1b}[0m\n"
