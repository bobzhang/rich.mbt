    line_range=(None, Some(4)),
  )
  let expected : String = "\u{1b}[1;38;2;116;135;140;48;2;253;246;227m  \u{1b}[0m\u{1b}[38;2;207;209;198;48;2;253;246;227m1 \u{1b}[0m\u{1b}[3;38;2;147;161;161;48;2;253;246;227m#!/bin/bash\u{1b}[0m\u{1b}[48;2;253;246;227m                                             \u{1b}[0m\n" +
    "\u{1b}[1;38;2;116;135;140;48;2;253;246;227m  \u{1b}[0m\u{1b}[38;2;207;209;198;48;2;253;246;227m2 \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227mfor\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227mf\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227min\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m*.txt\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m;\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227mdo\u{1b}[0m\u{1b}[48;2;253;246;227m                                      \u{1b}[0m\n" +
    "\u{1b}[1;38;2;116;135;140;48;2;253;246;227m  \u{1b}[0m\u{1b}[38;2;207;209;198;48;2;253;246;227m3 \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m  \u{1b}[0m\u{1b}[38;2;38;139;210;48;2;253;246;227mecho\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;42;161;152;48;2;253;246;227m\"\u{1b}[0m\u{1b}[38;2;42;161;152;48;2;253;246;227mfile: \u{1b}[0m\u{1b}[38;2;38;139;210;48;2;253;246;227m$f\u{1b}[0m\u{1b}[38;2;42;161;152;48;2;253;246;227m\"\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m|\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227mgrep\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m-v\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;42;161;152;48;2;253;246;227m'^#'\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m>\u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m \u{1b}[0m\u{1b}[38;2;101;123;131;48;2;253;246;227m/dev/null\u{1b}[0m\u{1b}[48;2;253;246;227m            \u{1b}[0m\n" +
    "\u{1b}[1;38;2;116;135;140;48;2;253;246;227m  \u{1b}[0m\u{1b}[38;2;207;209;198;48;2;253;246;227m4 \u{1b}[0m\u{1b}[38;2;133;153;0;48;2;253;246;227mdone\u{1b}[0m\u{1b}[48;2;253;246;227m                                                    \u{1b}[0m\n"
