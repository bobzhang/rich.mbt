test "oracle 134: python ansi_dark {'line_numbers': True} {'width': 70, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="ansi_dark",
    line_numbers=true,
  )
  let expected : String = "  \u{1b}[2m 1 \u{1b}[0m\u{1b}[94mimport\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[4;96mos\u{1b}[0m\n" +
    "  \u{1b}[2m 2 \u{1b}[0m\n" +
    "  \u{1b}[2m 3 \u{1b}[0m\u{1b}[1;95m@decorator\u{1b}[0m\n" +
    "  \u{1b}[2m 4 \u{1b}[0m\u{1b}[94mclass\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[4;92mFoo\u{1b}[0m(Base):\n" +
    "  \u{1b}[2m 5 \u{1b}[0m\u{1b}[90m    \u{1b}[0m\u{1b}[33m\"\"\"Docstring with a very long line that is going to need wrap\u{1b}[0m\n" +
    "  \u{1b}[2m 6 \u{1b}[0m\n" +
    "  \u{1b}[2m 7 \u{1b}[0m    \u{1b}[94mdef\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[92mmethod\u{1b}[0m(\u{1b}[96mself\u{1b}[0m, x: \u{1b}[96mint\u{1b}[0m = \u{1b}[94m0x1F\u{1b}[0m) -> \u{1b}[96mstr\u{1b}[0m:\n" +
    "  \u{1b}[2m 8 \u{1b}[0m        \u{1b}[94mif\u{1b}[0m x > \u{1b}[94m10\u{1b}[0m \u{1b}[95mand\u{1b}[0m \u{1b}[95mnot\u{1b}[0m \u{1b}[94mNone\u{1b}[0m:\n" +
    "  \u{1b}[2m 9 \u{1b}[0m        \u{1b}[94mreturn\u{1b}[0m \u{1b}[33mf\u{1b}[0m\u{1b}[33m\"\u{1b}[0m\u{1b}[33mvalue \u{1b}[0m\u{1b}[33m{\u{1b}[0mx\u{1b}[33m!r}\u{1b}[0m\u{1b}[33m\"\u{1b}[0m  \u{1b}[2m# comment\u{1b}[0m\n" +
    "  \u{1b}[2m10 \u{1b}[0m        \u{1b}[94mreturn\u{1b}[0m \u{1b}[33m'\u{1b}[0m\u{1b}[33mcafé 中文\u{1b}[0m\u{1b}[33m'\u{1b}[0m\n" +
    "  \u{1b}[2m11 \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=70, color_system=Some("truecolor")),
    expected,
  )
}

