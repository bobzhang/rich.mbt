///|
fn oracle_render(
  syntax : @syntax.Syntax,
  width~ : Int,
  color_system~ : String?,
  no_wrap? : Bool = false,
) -> String raise {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width~,
    color_system~,
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(syntax, no_wrap~)
  file.getvalue()
}

