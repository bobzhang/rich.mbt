  )
  let expected : String = "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m 98 \u{1b}[0m\u{1b}[37;40m<!DOCTYPE html>\u{1b}[0m\u{1b}[40m                                                           \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m 99 \u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[91;40mhtml\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[40m                                                                    \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m100 \u{1b}[0m\u{1b}[97;40m  \u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[91;40mbody\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[92;40mclass\u{1b}[0m\u{1b}[91;40m=\u{1b}[0m\u{1b}[93;40m\"main\"\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[40m                                                     \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m101 \u{1b}[0m\u{1b}[97;40m    \u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[91;40mp\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[97;40mHello \u{1b}[0m\u{1b}[97;40m&amp;\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[91;40mb\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[97;40mworld\u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[97;40m/\u{1b}[0m\u{1b}[91;40mb\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[97;40m/\u{1b}[0m\u{1b}[91;40mp\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[40m                                       \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m102 \u{1b}[0m\u{1b}[97;40m    \u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[91;40mscript\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[96;40mvar\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[92;40mx\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[91;40m=\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40m1\u{1b}[0m\u{1b}[97;40m;\u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[97;40m/\u{1b}[0m\u{1b}[91;40mscript\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[40m                                           \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m103 \u{1b}[0m\u{1b}[97;40m  \u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[97;40m/\u{1b}[0m\u{1b}[91;40mbody\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[40m                                                                 \u{1b}[0m\n" +
    "\u{1b}[40m  \u{1b}[0m\u{1b}[2;40m104 \u{1b}[0m\u{1b}[97;40m<\u{1b}[0m\u{1b}[97;40m/\u{1b}[0m\u{1b}[91;40mhtml\u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[40m                                                                   \u{1b}[0m\n" +
