    "\u{1b}[38;5;231;48;5;235mHashMap\u{1b}[0m\u{1b}[38;5;231;48;5;235m::\u{1b}[0m\u{1b}[38;5;231;48;5;235mnew\u{1b}[0m\u{1b}[38;5;231;48;5;235m(\u{1b}[0m\u{1b}[38;5;231;48;5;235m)\u{1b}[0m\u{1b}[38;5;231;48;5;235m;\u{1b}[0m\u{1b}[48;5;235m                              \u{1b}[0m\n" +
    "\u{1b}[38;5;231;48;5;235m    \u{1b}[0m\u{1b}[38;5;231;48;5;235mmap\u{1b}[0m\u{1b}[38;5;231;48;5;235m.\u{1b}[0m\u{1b}[38;5;231;48;5;235minsert\u{1b}[0m\u{1b}[38;5;231;48;5;235m(\u{1b}[0m\u{1b}[38;5;186;48;5;235m\"\u{1b}[0m\u{1b}[38;5;186;48;5;235mone\u{1b}[0m\u{1b}[38;5;186;48;5;235m\"\u{1b}[0m\u{1b}[38;5;231;48;5;235m,\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;141;48;5;235m1\u{1b}[0m\u{1b}[38;5;231;48;5;235m)\u{1b}[0m\u{1b}[38;5;231;48;5;235m;\u{1b}[0m\u{1b}[48;5;235m                    \u{1b}[0m\n" +
    "\u{1b}[38;5;231;48;5;235m    \u{1b}[0m\u{1b}[38;5;81;48;5;235mfor\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;231;48;5;235m(\u{1b}[0m\u{1b}[38;5;231;48;5;235mk\u{1b}[0m\u{1b}[38;5;231;48;5;235m,\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;231;48;5;235mv\u{1b}[0m\u{1b}[38;5;231;48;5;235m)\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;81;48;5;235min\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;204;48;5;235m&\u{1b}[0m\u{1b}[38;5;231;48;5;235mmap\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;231;48;5;235m{\u{1b}[0m\u{1b}[48;5;235m                     \u{1b}[0m\n" +
    "\u{1b}[38;5;231;48;5;235m        \u{1b}[0m\u{1b}[38;5;148;48;5;235mprintln!\u{1b}[0m\u{1b}[38;5;231;48;5;235m(\u{1b}[0m\u{1b}[38;5;186;48;5;235m\"\u{1b}[0m\u{1b}[38;5;186;48;5;235m{}: {}\u{1b}[0m\u{1b}[38;5;186;48;5;235m\"\u{1b}[0m\u{1b}[38;5;231;48;5;235m,\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;231;48;5;235mk\u{1b}[0m\u{1b}[38;5;231;48;5;235m,\u{1b}[0m\u{1b}[38;5;231;48;5;235m \u{1b}[0m\u{1b}[38;5;231;48;5;235mv\u{1b}[0m\u{1b}[38;5;231;48;5;235m)\u{1b}[0m\u{1b}[38;5;231;48;5;235m;\u{1b}[0m\u{1b}[48;5;235m            \u{1b}[0m\n" +
    "\u{1b}[38;5;231;48;5;235m    \u{1b}[0m\u{1b}[38;5;231;48;5;235m}\u{1b}[0m\u{1b}[48;5;235m                                        \u{1b}[0m\n" +
    "\u{1b}[38;5;231;48;5;235m}\u{1b}[0m\u{1b}[48;5;235m                                            \u{1b}[0m\n" +
    "\u{1b}[48;5;235m                                             \u{1b}[0m\n"
  assert_eq(oracle_render(syntax, width=45, color_system=Some("256")), expected)
}

