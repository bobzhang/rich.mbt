///|
test "oracle 59: html solarized-light {'padding': 1, 'word_wrap': True, 'line_numbers': True} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_html,
    "html",
    theme="solarized-light",
    padding=[1],
    word_wrap=true,
    line_numbers=true,
  )
  let expected : String = "                                                  \n" +
    "   1 <!DOCTYPE html>                              \n" +
    "   2 <html>                                       \n" +
    "   3   <body class=\"main\">                        \n" +
    "   4     <p>Hello &amp; <b>world</b></p>          \n" +
    "   5     <script>var x = 1;</script>              \n" +
    "   6   </body>                                    \n" +
    "   7 </html>                                      \n" +
    "   8                                              \n" +
    "                                                  \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

