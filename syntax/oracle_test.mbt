test "oracle 28: javascript default {'indent_guides': True, 'line_numbers': True, 'line_range': (2, 6)} {'width': 80, 'color_system': 'standard'}" {
  let syntax = @syntax.Syntax::new(
    sample_javascript,
    "javascript",
    theme="default",
    indent_guides=true,
    line_numbers=true,
    line_range=(Some(2), Some(6)),
  )
  let expected : String = "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m2 \u{1b}[0m\u{1b}[1;32;107mconst\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107madd\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[90;107m=\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107m(\u{1b}[0m\u{1b}[30;107ma\u{1b}[0m\u{1b}[30;107m,\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107mb\u{1b}[0m\u{1b}[30;107m)\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107m=>\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107ma\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[90;107m+\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107mb\u{1b}[0m\u{1b}[30;107m;\u{1b}[0m\u{1b}[107m                                                \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m3 \u{1b}[0m\u{1b}[1;32;107mclass\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107mPoint\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107m{\u{1b}[0m\u{1b}[107m                                                               \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m4 \u{1b}[0m\u{1b}[2;90;107m  \u{1b}[0m\u{1b}[1;32;107mconstructor\u{1b}[0m\u{1b}[30;107m(\u{1b}[0m\u{1b}[30;107mx\u{1b}[0m\u{1b}[30;107m,\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107my\u{1b}[0m\u{1b}[30;107m)\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107m{\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[1;32;107mthis\u{1b}[0m\u{1b}[30;107m.\u{1b}[0m\u{1b}[30;107mx\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[90;107m=\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107mx\u{1b}[0m\u{1b}[30;107m;\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[1;32;107mthis\u{1b}[0m\u{1b}[30;107m.\u{1b}[0m\u{1b}[30;107my\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[90;107m=\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107my\u{1b}[0m\u{1b}[30;107m;\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[30;107m}\u{1b}[0m\u{1b}[107m                             \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m5 \u{1b}[0m\u{1b}[30;107m}\u{1b}[0m\u{1b}[107m                                                                           \u{1b}[0m\n" +
    "\u{1b}[107m  \u{1b}[0m\u{1b}[2;107m6 \u{1b}[0m\u{1b}[30;107mconsole\u{1b}[0m\u{1b}[30;107m.\u{1b}[0m\u{1b}[30;107mlog\u{1b}[0m\u{1b}[30;107m(\u{1b}[0m\u{1b}[31;107m`\u{1b}[0m\u{1b}[31;107msum: \u{1b}[0m\u{1b}[1;90;107m${\u{1b}[0m\u{1b}[30;107madd\u{1b}[0m\u{1b}[30;107m(\u{1b}[0m\u{1b}[90;107m1\u{1b}[0m\u{1b}[30;107m,\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[90;107m2\u{1b}[0m\u{1b}[30;107m)\u{1b}[0m\u{1b}[1;90;107m}\u{1b}[0m\u{1b}[31;107m`\u{1b}[0m\u{1b}[30;107m,\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[90;107m/re+gex/g\u{1b}[0m\u{1b}[30;107m,\u{1b}[0m\u{1b}[37;107m \u{1b}[0m\u{1b}[1;32;107mnull\u{1b}[0m\u{1b}[30;107m)\u{1b}[0m\u{1b}[30;107m;\u{1b}[0m\u{1b}[107m                          \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=80, color_system=Some("standard")),
