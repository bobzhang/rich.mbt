    "\u{1b}[90;107m  \u{1b}[0m\u{1b}[33;107mconstructor\u{1b}[0m\u{1b}[90;107m(\u{1b}[0m\u{1b}[90;107mx\u{1b}[0m\u{1b}[90;107m,\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[90;107my\u{1b}[0m\u{1b}[90;107m)\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[90;107m{\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[33;107mthis\u{1b}[0m\u{1b}[90;107m.\u{1b}[0m\u{1b}[90;107mx\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[37;107m=\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[90;107mx\u{1b}[0m\u{1b}[90;107m;\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[33;107mthis\u{1b}[0m\u{1b}[90;107m.\u{1b}[0m\u{1b}[90;107my\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[37;107m=\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[90;107my\u{1b}[0m\u{1b}[90;107m;\u{1b}[0m\u{1b}[90;107m \u{1b}[0m\u{1b}[90;107m}\u{1b}[0m\u{1b}[107m                                 \u{1b}[0m\n" +
