test "oracle 71: json gruvbox-dark {'padding': 1, 'word_wrap': True, 'line_numbers': True} {'width': 60, 'color_system': 'truecolor'}" {
  let syntax = @syntax.Syntax::new(
    sample_json,
    "json",
    theme="gruvbox-dark",
    padding=[1],
    word_wrap=true,
    line_numbers=true,
  )
  let expected : String = "\u{1b}[48;2;40;40;40m                                                            \u{1b}[0m\n" +
    "\u{1b}[48;2;40;40;40m \u{1b}[0m\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m1 \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m{\u{1b}[0m\u{1b}[48;2;40;40;40m                                                     \u{1b}[0m\u{1b}[48;2;40;40;40m \u{1b}[0m\n" +
    "\u{1b}[48;2;40;40;40m \u{1b}[0m\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m2 \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;142;192;124;48;2;40;40;40m\"name\"\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m:\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;184;187;38;48;2;40;40;40m\"rich\"\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m,\u{1b}[0m\u{1b}[48;2;40;40;40m                                     \u{1b}[0m\u{1b}[48;2;40;40;40m \u{1b}[0m\n" +
    "\u{1b}[48;2;40;40;40m \u{1b}[0m\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m3 \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;142;192;124;48;2;40;40;40m\"version\"\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m:\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m[\u{1b}[0m\u{1b}[38;2;211;134;155;48;2;40;40;40m1\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m,\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;211;134;155;48;2;40;40;40m2.5\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m,\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;211;134;155;48;2;40;40;40m-3e10\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m],\u{1b}[0m\u{1b}[48;2;40;40;40m                         \u{1b}[0m\u{1b}[48;2;40;40;40m \u{1b}[0m\n" +
    "\u{1b}[48;2;40;40;40m \u{1b}[0m\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m4 \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;142;192;124;48;2;40;40;40m\"ok\"\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m:\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;251;73;52;48;2;40;40;40mtrue\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m,\u{1b}[0m\u{1b}[48;2;40;40;40m                                         \u{1b}[0m\u{1b}[48;2;40;40;40m \u{1b}[0m\n" +
    "\u{1b}[48;2;40;40;40m \u{1b}[0m\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m5 \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;142;192;124;48;2;40;40;40m\"none\"\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m:\u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m \u{1b}[0m\u{1b}[38;2;251;73;52;48;2;40;40;40mnull\u{1b}[0m\u{1b}[48;2;40;40;40m                                        \u{1b}[0m\u{1b}[48;2;40;40;40m \u{1b}[0m\n" +
    "\u{1b}[48;2;40;40;40m \u{1b}[0m\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m6 \u{1b}[0m\u{1b}[38;2;221;221;221;48;2;40;40;40m}\u{1b}[0m\u{1b}[48;2;40;40;40m                                                     \u{1b}[0m\u{1b}[48;2;40;40;40m \u{1b}[0m\n" +
    "\u{1b}[48;2;40;40;40m \u{1b}[0m\u{1b}[1;38;2;202;202;202;48;2;40;40;40m  \u{1b}[0m\u{1b}[38;2;94;94;94;48;2;40;40;40m7 \u{1b}[0m\u{1b}[48;2;40;40;40m                                                      \u{1b}[0m\u{1b}[48;2;40;40;40m \u{1b}[0m\n" +
    "\u{1b}[48;2;40;40;40m                                                            \u{1b}[0m\n"
  assert_eq(
