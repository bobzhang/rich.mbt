    "\u{1b}[97;100m  \u{1b}[0m\u{1b}[95;100mnumber\u{1b}[0m\u{1b}[97;100m:\u{1b}[0m\u{1b}[97;100m \u{1b}[0m\u{1b}[100m42\u{1b}[0m\u{1b}[97;100m  \u{1b}[0m\u{1b}[90;100m# comment\u{1b}[0m\u{1b}[100m                                                         \u{1b}[0m\n" +
