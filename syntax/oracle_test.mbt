    "\u{1b}[38;5;109;48;5;23mlist\u{1b}[0m\u{1b}[38;5;231;48;5;23m:\u{1b}[0m\u{1b}[48;5;23m                                        \u{1b}[0m\n" +
    "\u{1b}[2;3;38;5;60;48;5;23m  \u{1b}[0m\u{1b}[48;5;23m-\u{1b}[0m\u{1b}[38;5;188;48;5;23m \u{1b}[0m\u{1b}[48;5;23mone\u{1b}[0m\u{1b}[48;5;23m                                      \u{1b}[0m\n" +
    "\u{1b}[2;3;38;5;60;48;5;23m  \u{1b}[0m\u{1b}[48;5;23m-\u{1b}[0m\u{1b}[38;5;188;48;5;23m \u{1b}[0m\u{1b}[38;5;144;48;5;23m\"\u{1b}[0m\u{1b}[38;5;144;48;5;23mtwo\u{1b}[0m\u{1b}[38;5;144;48;5;23m\"\u{1b}[0m\u{1b}[48;5;23m                                    \u{1b}[0m\n" +
    "\u{1b}[38;5;109;48;5;23mnested\u{1b}[0m\u{1b}[38;5;231;48;5;23m:\u{1b}[0m\u{1b}[48;5;23m                                      \u{1b}[0m\n" +
    "\u{1b}[2;3;38;5;60;48;5;23m  \u{1b}[0m\u{1b}[38;5;109;48;5;23mnumber\u{1b}[0m\u{1b}[38;5;231;48;5;23m:\u{1b}[0m\u{1b}[38;5;188;48;5;23m \u{1b}[0m\u{1b}[48;5;23m42\u{1b}[0m\u{1b}[38;5;188;48;5;23m  \u{1b}[0m\u{1b}[3;38;5;60;48;5;23m# comment\u{1b}[0m\u{1b}[48;5;23m                      \u{1b}[0m\n" +
    "\u{1b}[48;5;23m                                             \u{1b}[0m\n"
