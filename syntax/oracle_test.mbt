test "oracle 10: python gruvbox-dark {'code_width': 20} {'width': 80, 'color_system': 'standard'}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="gruvbox-dark",
    code_width=20,
  )
  let expected : String = "\u{1b}[91;40mimport\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40mos\u{1b}[0m\u{1b}[40m           \u{1b}[0m\n" +
    "\u{1b}[40m                    \u{1b}[0m\n" +
    "\u{1b}[91;40m@decorator\u{1b}[0m\u{1b}[40m          \u{1b}[0m\n" +
    "\u{1b}[91;40mclass\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40mFoo\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[97;40mBase\u{1b}[0m\u{1b}[97;40m)\u{1b}[0m\u{1b}[97;40m:\u{1b}[0m\u{1b}[40m    \u{1b}[0m\n" +
    "\u{1b}[97;40m    \u{1b}[0m\u{1b}[93;40m\"\"\"Docstring wit\u{1b}[0m\n" +
    "\u{1b}[40m                    \u{1b}[0m\n" +
    "\u{1b}[97;40m    \u{1b}[0m\u{1b}[91;40mdef\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40mmethod\u{1b}[0m\u{1b}[97;40m(\u{1b}[0m\u{1b}[91;40mself\u{1b}[0m\u{1b}[97;40m,\u{1b}[0m\n" +
    "\u{1b}[97;40m        \u{1b}[0m\u{1b}[91;40mif\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40mx\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[97;40m>\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[37;40m10\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[91;40man\u{1b}[0m\n" +
    "\u{1b}[97;40m        \u{1b}[0m\u{1b}[91;40mreturn\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[93;40mf\u{1b}[0m\u{1b}[93;40m\"\u{1b}[0m\u{1b}[93;40mval\u{1b}[0m\n" +
    "\u{1b}[97;40m        \u{1b}[0m\u{1b}[91;40mreturn\u{1b}[0m\u{1b}[97;40m \u{1b}[0m\u{1b}[93;40m'\u{1b}[0m\u{1b}[93;40mcafé\u{1b}[0m\n" +
    "\u{1b}[40m                    \u{1b}[0m\n"
  assert_eq(
    oracle_render(syntax, width=80, color_system=Some("standard")),
    expected,
  )
}

///|
test "oracle 11: python one-dark {'padding': 1, 'word_wrap': True, 'line_numbers': True} {'width': 50, 'color_system': None}" {
  let syntax = @syntax.Syntax::new(
    sample_python,
    "python",
    theme="one-dark",
    padding=[1],
    word_wrap=true,
    line_numbers=true,
  )
  let expected : String = "                                                  \n" +
    "    1 import os                                   \n" +
    "    2                                             \n" +
    "    3 @decorator                                  \n" +
    "    4 class Foo(Base):                            \n" +
    "    5     \"\"\"Docstring with a very long line that \n" +
    "      is going to need wrapping when the width is \n" +
    "      small.\"\"\"                                   \n" +
    "    6                                             \n" +
    "    7     def method(self, x: int = 0x1F) -> str: \n" +
    "    8         if x > 10 and not None:             \n" +
    "    9         return f\"value {x!r}\"  # comment    \n" +
    "   10         return 'café 中文'                  \n" +
    "   11                                             \n" +
    "                                                  \n"
  assert_eq(oracle_render(syntax, width=50, color_system=None), expected)
}

