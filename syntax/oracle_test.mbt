    "\u{1b}[1;38;2;0;128;0;48;2;248;248;248mdone\u{1b}[0m\u{1b}[48;2;248;248;248m                                                        \u{1b}[0m\n" +
    "\u{1b}[38;2;0;128;0;48;2;248;248;248mexport\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;248;248;248m \u{1b}[0m\u{1b}[38;2;25;23;124;48;2;248;248;248mX\u{1b}[0m\u{1b}[38;2;102;102;102;48;2;248;248;248m=\u{1b}[0m\u{1b}[1;38;2;164;90;119;48;2;248;248;248m${\u{1b}[0m\u{1b}[38;2;25;23;124;48;2;248;248;248mHOME\u{1b}[0m\u{1b}[1;38;2;0;128;0;48;2;248;248;248m:-\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;248;248;248m/tmp\u{1b}[0m\u{1b}[1;38;2;164;90;119;48;2;248;248;248m}\u{1b}[0m\u{1b}[48;2;248;248;248m                                      \u{1b}[0m\n" +
