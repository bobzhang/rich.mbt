            \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-e\u{1b}[0m\u{1b}[1;36mxport\u{1b}[0m\u{1b}[1;36m-s\u{1b}[0m\u{1b}[1;36mvg\u{1b}[0m\u{1b}[1;33m PATH\u{1b}[0m                Write SVG to \u{1b}[1mPATH\u{1b}[0m.                                         \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-p\u{1b}[0m\u{1b}[1;36mager\u{1b}[0m                          Display in an interactive pager.                           \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-v\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-v\u{1b}[0m\u{1b}[1;36mersion\u{1b}[0m                        Print version and exit.                                    \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-h\u{1b}[0m\u{1b}[1;36melp\u{1b}[0m                           Show this message and exit.                                \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u{1b}[0m\n\u{1b}[1;38;2;177;105;221m♥\u{1b}[0m\u{1b}[1;38;2;173;102;218m \u{1b}[0m\u{1b}[1;38;2;170;100;215mh\u{1b}[0m\u{1b}[1;38;2;166;98;212mt\u{1b}[0m\u{1b}[1;38;2;163;95;209mt\u{1b}[0m\u{1b}[1;38;2;159;93;206mp\u{1b}[0m\u{1b}[1;38;2;156;91;204ms\u{1b}[0m\u{1b}[1;38;2;152;89;201m:\u{1b}[0m\u{1b}[1;38;2;149;86;198m/\u{1b}[0m\u{1b}[1;38;2;146;84;195m/\u{1b}[0m\u{1b}[1;38;2;142;82;192mw\u{1b}[0m\u{1b}[1;38;2;139;80;190mw\u{1b}[0m\u{1b}[1;38;2;135;77;187mw\u{1b}[0m\u{1b}[1;38;2;132;75;184m.\u{1b}[0m\u{1b}[1;38;2;128;73;181mt\u{1b}[0m\u{1b}[1;38;2;125;71;178me\u{1b}[0m\u{1b}[1;38;2;121;68;175mx\u{1b}[0m\u{1b}[1;38;2;118;66;173mt\u{1b}[0m\u{1b}[1;38;2;115;64;170mu\u{1b}[0m\u{1b}[1;38;2;111;62;167ma\u{1b}[0m\u{1b}[1;38;2;108;59;164ml\u{1b}[0m\u{1b}[1;38;2;104;57;161mi\u{1b}[0m\u{1b}[1;38;2;101;55;159mz\u{1b}[0m\u{1b}[1;38;2;97;53;156me\u{1b}[0m\u{1b}[1;38;2;94;50;153m.\u{1b}[0m\u{1b}[1;38;2;90;48;150mi\u{1b}[0m\u{1b}[1;38;2;87;46;147mo\u{1b}