    "                                         \u{1b}[1mRich CLI\u{1b}[0m \u{1b}[35mv1.8.0\u{1b}[0m 🤑                                         \n                                                                                                    \n                              \u{1b}[2mRich text and formatting in the terminal\u{1b}[0m                              \n                                                                                                    \nUsage: \u{1b}[1mrich\u{1b}[0m \u{1b}[1m[OPTIONS]\u{1b}[0m \u{1b}[1;36m<PATH,TEXT,URL, or '-'>\u{1b}[0m\n\n\u{1b}[2m╭─\u{1b}[0m\u{1b}[2m Options \u{1b}[0m\u{1b}[2m───────────────────────────────────────────────────────────────────────────────────────\u{1b}[0m\u{1b}[2m─╮\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-p\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-p\u{1b}[0m\u{1b}[1;36mrint\u{1b}[0m                          Print \u{1b}[4mconsole markup\u{1b}[0m. \u{1b}[2mSee \u{1b}[0m                                 \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m                                       \u{1b}[2mhttps://rich.readthedocs.io/en/latest/markup.html\u{1b}[0m          \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-u\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-r\u{1b}[0m\u{1b}[1;36mule\u{1b}[0m                           Display a horizontal \u{1b}[4mrule\u{1b}[0m.                                 \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-J\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-j\u{1b}[0m\u{1b}[1;36mson\u{1b}[0m                           Display as \u{1b}[4mJSON\u{1b}[0m.                                           \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-m\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-m\u{1b}[0m\u{1b}[1;36markdown\u{1b}[0m                       Display as \u{1b}[4mmarkdown\u{1b}[0m.                                       \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-r\u{1b}[0m\u{1b}[1;36mst\u{1b}[0m                            Display \u{1b}[4mrestructured text\u{1b}[0m.                                 \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-c\u{1b}[0m\u{1b}[1;36msv\u{1b}[0m                            Display \u{1b}[4mCSV\u{1b}[0m as a table.                                    \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-i\u{1b}[0m\u{1b}[1;36mpynb\u{1b}[0m                          Display \u{1b}[4mJupyter notebook\u{1b}[0m.                                  \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-s\u{1b}[0m\u{1b}[1;36myntax\u{1b}[0m                         \u{1b}[4mSyntax\u{1b}[0m highlighting.                                       \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-i\u{1b}[0m\u{1b}[1;36mnspect\u{1b}[0m                        \u{1b}[4mInspect\u{1b}[0m a python object.                                   \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-h\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-h\u{1b}[0m\u{1b}[1;36mead\u{1b}[0m\u{1b}[1;33m LINES\u{1b}[0m                     Display first \u{1b}[1mLINES\u{1b}[0m of the file (requires \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-s\u{1b}[0m\u{1b}[1;36myntax\u{1b}[0m or      \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m                                       \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-c\u{1b}[0m\u{1b}[1;36msv\u{1b}[0m).                                                    \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-t\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-t\u{1b}[0m\u{1b}[1;36mail\u{1b}[0m\u{1b}[1;33m LINES\u{1b}[0m                     Display last \u{1b}[1mLINES\u{1b}[0m of the file (requires \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-s\u{1b}[0m\u{1b}[1;36myntax\u{1b}[0m or       \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m                                       \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-c\u{1b}[0m\u{1b}[1;36msv\u{1b}[0m).                                                    \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-j\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-e\u{1b}[0m\u{1b}[1;36mmoji\u{1b}[0m                          Enable emoji code. \u{1b}[2me.g. :sparkle:\u{1b}[0m                          \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-l\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-l\u{1b}[0m\u{1b}[1;36meft\u{1b}[0m                           Align to left.                                             \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-r\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-r\u{1b}[0m\u{1b}[1;36might\u{1b}[0m                          Align to right.                                            \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-c\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-c\u{1b}[0m\u{1b}[1;36menter\u{1b}[0m                         Align to center.                                           \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-L\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-t\u{1b}[0m\u{1b}[1;36mext\u{1b}[0m\u{1b}[1;36m-l\u{1b}[0m\u{1b}[1;36meft\u{1b}[0m                      Justify text to left.                                      \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-R\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-t\u{1b}[0m\u{1b}[1;36mext\u{1b}[0m\u{1b}[1;36m-r\u{1b}[0m\u{1b}[1;36might\u{1b}[0m                     Justify text to right.                                     \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-C\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-t\u{1b}[0m\u{1b}[1;36mext\u{1b}[0m\u{1b}[1;36m-c\u{1b}[0m\u{1b}[1;36menter\u{1b}[0m                    Justify text to center.                                    \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-F\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-t\u{1b}[0m\u{1b}[1;36mext\u{1b}[0m\u{1b}[1;36m-f\u{1b}[0m\u{1b}[1;36mull\u{1b}[0m                      Justify text to both left and right edges.                 \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-s\u{1b}[0m\u{1b}[1;36moft\u{1b}[0m                           Enable soft wrapping of text (requires \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-p\u{1b}[0m\u{1b}[1;36mrint\u{1b}[0m).           \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-e\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-e\u{1b}[0m\u{1b}[1;36mxpand\u{1b}[0m                         Expand to full width (requires \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-p\u{1b}[0m\u{1b}[1;36manel\u{1b}[0m).                   \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-w\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-w\u{1b}[0m\u{1b}[1;36midth\u{1b}[0m\u{1b}[1;33m SIZE\u{1b}[0m                     Fit output to \u{1b}[1mSIZE\u{1b}[0m characters.                             \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-W\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-m\u{1b}[0m\u{1b}[1;36max\u{1b}[0m\u{1b}[1;36m-w\u{1b}[0m\u{1b}[1;36midth\u{1b}[0m\u{1b}[1;33m SIZE\u{1b}[0m                 Set maximum width to \u{1b}[1mSIZE\u{1b}[0m characters.                      \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-s\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-s\u{1b}[0m\u{1b}[1;36mtyle\u{1b}[0m\u{1b}[1;33m STYLE\u{1b}[0m                    Set text style to \u{1b}[1mSTYLE\u{1b}[0m.                                   \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-r\u{1b}[0m\u{1b}[1;36mule\u{1b}[0m\u{1b}[1;36m-s\u{1b}[0m\u{1b}[1;36mtyle\u{1b}[0m\u{1b}[1;33m STYLE\u{1b}[0m               Set rule style to \u{1b}[1mSTYLE\u{1b}[0m.                                   \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-r\u{1b}[0m\u{1b}[1;36mule\u{1b}[0m\u{1b}[1;36m-c\u{1b}[0m\u{1b}[1;36mhar\u{1b}[0m\u{1b}[1;33m CHARACTER\u{1b}[0m            Use \u{1b}[1mCHARACTER\u{1b}[0m to generate a line with \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-r\u{1b}[0m\u{1b}[1;36mule\u{1b}[0m.              \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-d\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-p\u{1b}[0m\u{1b}[1;36madding\u{1b}[0m\u{1b}[1;33m TOP,RIGHT,BOTTOM,LEFT\u{1b}[0m  Padding around output. \u{1b}[2m1, 2 or 4 comma separated \u{1b}[0m          \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m                                       \u{1b}[2mintegers, e.g. 2,4\u{1b}[0m                                         \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-a\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-p\u{1b}[0m\u{1b}[1;36manel\u{1b}[0m\u{1b}[1;33m BOX\u{1b}[0m                      Set panel type to \u{1b}[1mBOX\u{1b}[0m. \u{1b}[2mascii, ascii2, double, heavy, \u{1b}[0m      \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m                                       \u{1b}[2mnone, rounded, square\u{1b}[0m                                      \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-S\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-p\u{1b}[0m\u{1b}[1;36manel\u{1b}[0m\u{1b}[1;36m-s\u{1b}[0m\u{1b}[1;36mtyle\u{1b}[0m\u{1b}[1;33m STYLE\u{1b}[0m              Set the panel style to \u{1b}[1mSTYLE\u{1b}[0m (requires \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-p\u{1b}[0m\u{1b}[1;36manel\u{1b}[0m).           \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m      \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-t\u{1b}[0m\u{1b}[1;36mheme\u{1b}[0m\u{1b}[1;33m THEME\u{1b}[0m                    Set syntax theme to \u{1b}[1mTHEME\u{1b}[0m. \u{1b}[2mSee \u{1b}[0m                            \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m                                       \u{1b}[2mhttps://pygments.org/styles/\u{1b}[0m                               \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-n\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-l\u{1b}[0m\u{1b}[1;36mine\u{1b}[0m\u{1b}[1;36m-n\u{1b}[0m\u{1b}[1;36mumbers\u{1b}[0m                   Enable line number in syntax.                              \u{1b}[2m│\u{1b}[0m\n\u{1b}[2m│\u{1b}[0m  \u{1b}[1;32m-g\u{1b}[0m  \u{1b}[1;36m-\u{1b}[0m\u{1b}[1;36m-g\u{1b}[0m\u{1b}[1;36muides\u{1b}[