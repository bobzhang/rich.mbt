///|
test "style add oracle cases" {
  let cases : Array[(String, String, String)] = [
    ("", "none", "none"),
    ("", "BOLD", "bold"),
    ("", "not b", "not bold"),
    ("", "r c s uu o", "reverse conceal strike underline2 overline"),
    ("", "on red", "on red"),
    ("", "#FF00ff on #000000", "#ff00ff on #000000"),
    ("", "rgb(10,20,30)", "rgb(10,20,30)"),
    ("", "bright_red", "bright_red"),
    ("", "link https://example.org", "link https://example.org"),
    ("", "bold on color(17)", "bold on color(17)"),
    ("", "reverse red on white", "reverse red on white"),
    (
      "", "bold italic underline strike overline red", "bold italic underline strike overline red",
    ),
    ("bold", "none", "bold"),
    ("bold", "BOLD", "bold"),
    ("bold", "not b", "not bold"),
    ("bold", "r c s uu o", "bold reverse conceal strike underline2 overline"),
    ("bold", "on red", "bold on red"),
    ("bold", "#FF00ff on #000000", "bold #ff00ff on #000000"),
    ("bold", "rgb(10,20,30)", "bold rgb(10,20,30)"),
    ("bold", "bright_red", "bold bright_red"),
    ("bold", "link https://example.org", "bold link https://example.org"),
    ("bold", "bold on color(17)", "bold on color(17)"),
    ("bold", "reverse red on white", "bold reverse red on white"),
    (
      "bold", "bold italic underline strike overline red", "bold italic underline strike overline red",
    ),
    ("Bold Italic", "none", "bold italic"),
    ("Bold Italic", "BOLD", "bold italic"),
    ("Bold Italic", "not b", "not bold italic"),
    (
      "Bold Italic", "r c s uu o", "bold italic reverse conceal strike underline2 overline",
    ),
    ("Bold Italic", "on red", "bold italic on red"),
    ("Bold Italic", "#FF00ff on #000000", "bold italic #ff00ff on #000000"),
    ("Bold Italic", "rgb(10,20,30)", "bold italic rgb(10,20,30)"),
    ("Bold Italic", "bright_red", "bold italic bright_red"),
    (
      "Bold Italic", "link https://example.org", "bold italic link https://example.org",
    ),
    ("Bold Italic", "bold on color(17)", "bold italic on color(17)"),
    ("Bold Italic", "reverse red on white", "bold italic reverse red on white"),
    (
      "Bold Italic", "bold italic underline strike overline red", "bold italic underline strike overline red",
    ),
    ("not b", "none", "not bold"),
    ("not b", "BOLD", "bold"),
    ("not b", "not b", "not bold"),
