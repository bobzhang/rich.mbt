import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
}

warnings = "-implicit_impl_as_method"

options(
  "native-stub": [ "term_stub.c" ],
  targets: {
    "term_native.mbt": [ "native", "llvm" ],
    "term_js.mbt": [ "js" ],
    "term_wasm.mbt": [ "wasm", "wasm-gc" ],
    "strftime.mbt": [ "js", "wasm", "wasm-gc" ],
  },
)
