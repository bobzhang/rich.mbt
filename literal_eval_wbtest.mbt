test "literal_eval oracle cases" {
  let cases : Array[(String, String)] = [
    ("", "SyntaxError invalid syntax"),
    ("(", "SyntaxError '(' was never closed"),
    ("(1", "SyntaxError '(' was never closed"),
    ("[1", "SyntaxError '[' was never closed"),
    ("1 2", "SyntaxError invalid syntax"),
    (")", "SyntaxError unmatched ')'"),
    ("a b", "SyntaxError invalid syntax"),
    ("'x", "SyntaxError unterminated string literal (detected at line 1)"),
    (
      "'''x", "SyntaxError unterminated triple-quoted string literal (detected at line 1)",
    ),
    ("{1:}", "SyntaxError expression expected after dictionary key and ':'"),
    (
      "(1]", "SyntaxError closing parenthesis ']' does not match opening parenthesis '('",
    ),
    (
      "sfs", "ValueError malformed node or string on line 1: Name(id='sfs', ctx=Load())",
    ),
    (
      "x.y", "ValueError malformed node or string on line 1: Attribute(value=Name(id='x', ctx=Load()), attr='y', ctx=Load())",
    ),
    (
      "f(1)", "ValueError malformed node or string on line 1: Call(func=Name(id='f', ctx=Load()), args=[Constant(value=1, kind=None)], keywords=[])",
    ),
    (
      "1+2", "ValueError malformed node or string on line 1: BinOp(left=Constant(value=1, kind=None), op=Add(), right=Constant(value=2, kind=None))",
    ),
    (
      "-x", "ValueError malformed node or string on line 1: Name(id='x', ctx=Load())",
    ),
    ("{1, 2}", "OK {1, 2}"),
    ("b'x'", "OK b'x'"),
    ("[1,,2]", "SyntaxError invalid syntax"),
    ("(,)", "SyntaxError invalid syntax"),
    ("'a\\x41'", "OK 'aA'"),
    ("'\\u00e9'", "OK 'é'"),
    ("r'\\n'", "OK '\\\\n'"),
    ("u'x'", "OK 'x'"),
    ("1_000", "OK 1000"),
    ("0o17", "OK 15"),
    ("0b11", "OK 3"),
    (".5", "OK 0.5"),
    ("1.", "OK 1.0"),
    ("00", "OK 0"),
    (
      "007", "SyntaxError leading zeros in decimal integer literals are not permitted; use an 0o prefix for octal integers",
    ),
    ("-0x10", "OK -16"),
    ("+3", "OK 3"),
    (
      "--3", "ValueError malformed node or string on line 1: UnaryOp(op=USub(), operand=Constant(value=3, kind=None))",
    ),
    ("True, False", "OK (True, False)"),
    ("1,", "OK (1,)"),
    (",", "SyntaxError invalid syntax"),
    ("x)", "SyntaxError unmatched ')'"),
    ("[1](", "SyntaxError '(' was never closed"),
    (" (1, 2) ", "OK (1, 2)"),
    ("{'a': [1, (2,)]}", "OK {'a': [1, (2,)]}"),
    ("{1: 2}", "OK {1: 2}"),
    ("{'a': None, 'b': True}", "OK {'a': None, 'b': True}"),
    ("'a' 'b'", "OK 'ab'"),
    ("\"x\\\"y\"", "OK 'x\"y'"),
    ("set()", "OK set()"),
    ("[]", "OK []"),
    ("{}", "OK {}"),
    ("(((1)))", "OK 1"),
    ("1e-3", "OK 0.001"),
    ("-2.5", "OK -2.5"),
    ("[1, 'two', 3.5]", "OK [1, 'two', 3.5]"),
    ("'''a\nb'''", "OK 'a\\nb'"),
    (
      "1 + 'a'", "ValueError malformed node or string on line 1: Constant(value='a', kind=None)",
    ),
    (
      "'a' + 1", "ValueError malformed node or string on line 1: Constant(value='a', kind=None)",
    ),
    ("{1: 2, 3: 4,}", "OK {1: 2, 3: 4}"),
    ("(1, 2,)", "OK (1, 2)"),
    (
      "1*2", "ValueError malformed node or string on line 1: BinOp(left=Constant(value=1, kind=None), op=Mult(), right=Constant(value=2, kind=None))",
    ),
    (
      "2**3", "ValueError malformed node or string on line 1: BinOp(left=Constant(value=2, kind=None), op=Pow(), right=Constant(value=3, kind=None))",
    ),
    (
      "~1", "ValueError malformed node or string on line 1: UnaryOp(op=Invert(), operand=Constant(value=1, kind=None))",
    ),
    ("'\\101'", "OK 'A'"),
