}

///|
test "special keys unsorted" {
  assert_eq(
    render(special_scope(), width=50, color=false, sort_keys=false),
    "╭───────────────────────╮\n│    zebra = 1          │\n│    Apple = 'a'        │\n│ __name__ = '__main__' │\n│    apple = 'b'        │\n│  __doc__ = None       │\n│ _private = [1, 2]     │\n│      Zed = {'k': 'v'} │\n╰───────────────────────╯\n",
  )
}

