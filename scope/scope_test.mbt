///|
test "demo max_length" {
  assert_eq(
    render(demo_scope(), width=60, color=false, max_length=2, max_string=4),
    "╭───────────────────────────────────────────╮\n│            bar = 3.1427                   │\n│ dict_of_things = {                        │\n│                      'vers'+3: '1.1',     │\n│                      'meth'+2: 'conf'+16, │\n│                      ... +2               │\n│                  }                        │\n│            foo = 20.3423                  │\n│ list_of_things = [1, 2, ... +6]           │\n╰───────────────────────────────────────────╯\n",
  )
}

///|
test "demo max_depth" {
  assert_eq(
    render(demo_scope(), width=60, color=false, max_depth=1, title="Scope"),
    "╭───────────────────────── Scope ──────────────────────────╮\n│            bar = 3.1427                                  │\n│ dict_of_things = {                                       │\n│                      'version': '1.1',                   │\n│                      'method': 'confirmFruitPurchase',   │\n│                      'params': [...],                    │\n│                      'id': '194521489'                   │\n│                  }                                       │\n│            foo = 20.3423                                 │\n│ list_of_things = [                                       │\n│                      1,                                  │\n│                      2,                                  │\n│                      3,                                  │\n│                      None,                               │\n│                      4,                                  │\n│                      True,                               │\n│                      False,                              │\n│                      'Hello World'                       │\n│                  ]                                       │\n╰──────────────────────────────────────────────────────────╯\n",
  )
}

