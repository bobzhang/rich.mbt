m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m                              \u{1b}[32m'mangoes'\u{1b}[0m,                                      \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m                              \u{1b}[32m'pomelo'\u{1b}[0m                                        \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m                          \u{1b}[1m]\u{1b}[0m,                                                  \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m                          \u{1b}[1;36m1.123\u{1b}[0m                                               \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m                      \u{1b}[1m]\u{1b}[0m,                                                      \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m                      \u{1b}[32m'id'\u{1b}[0m: \u{1b}[32m'194521489'\u{1b}[0m                                       \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m                  \u{1b}[1m}\u{1b}[0m                                                           \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m╰──────────────────────────────────────────────────────────────────────────────╯\u{1b}[0m\n",
