test "special keys" {
  assert_eq(
    render(special_scope(), width=50, color=true),
    "\u{1b}[34m╭───────────────────────╮\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m  \u{1b}[2;3;33m__doc__\u{1b}[0m\u{1b}[31m =\u{1b}[0m \u{1b}[3;35mNone\u{1b}[0m       \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m \u{1b}[2;3;33m__name__\u{1b}[0m\u{1b}[31m =\u{1b}[0m \u{1b}[32m'__main__'\u{1b}[0m \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m \u{1b}[3;33m_private\u{1b}[0m\u{1b}[31m =\u{1b}[0m \u{1b}[1m[\u{1b}[0m\u{1b}[1;36m1\u{1b}[0m, \u{1b}[1;36m2\u{1b}[0m\u{1b}[1m]\u{1b}[0m     \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m    \u{1b}[3;33mApple\u{1b}[0m\u{1b}[31m =\u{1b}[0m \u{1b}[32m'a'\u{1b}[0m        \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m    \u{1b}[3;33mapple\u{1b}[0m\u{1b}[31m =\u{1b}[0m \u{1b}[32m'b'\u{1b}[0m        \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m    \u{1b}[3;33mzebra\u{1b}[0m\u{1b}[31m =\u{1b}[0m \u{1b}[1;36m1\u{1b}[0m          \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m│\u{1b}[0m      \u{1b}[3;33mZed\u{1b}[0m\u{1b}[31m =\u{1b}[0m \u{1b}[1m{\u{1b}[0m\u{1b}[32m'k'\u{1b}[0m: \u{1b}[32m'v'\u{1b}[0m\u{1b}[1m}\u{1b}[0m \u{1b}[34m│\u{1b}[0m\n\u{1b}[34m╰───────────────────────╯\u{1b}[0m\n",
