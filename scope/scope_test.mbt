///|
test "demo sorted" {
  assert_eq(
    render(demo_scope(), width=80, color=false),
    "╭──────────────────────────────────────────────────────────────────────────────╮\n│            bar = 3.1427                                                      │\n│ dict_of_things = {                                                           │\n│                      'version': '1.1',                                       │\n│                      'method': 'confirmFruitPurchase',                       │\n│                      'params': [                                             │\n│                          [                                                   │\n│                              'apple',                                        │\n│                              'orange',                                       │\n│                              'mangoes',                                      │\n│                              'pomelo'                                        │\n│                          ],                                                  │\n│                          1.123                                               │\n│                      ],                                                      │\n│                      'id': '194521489'                                       │\n│                  }                                                           │\n│            foo = 20.3423                                                     │\n│ list_of_things = [1, 2, 3, None, 4, True, False, 'Hello World']              │\n╰──────────────────────────────────────────────────────────────────────────────╯\n",
  )
}

