// Differential tests against upstream Rich + markdown-it-py, replaying the
// data generated by scripts/markdown_oracle.py (corpus_data_test.mbt).

///|
fn dump_tokens(markup : String) -> String {
  @markdown.parse_tokens(markup).map(t => t.dump()).join("\n")
}

///|
fn render_with_options(
  markup : String,
  width : Int,
  options : String,
) -> String raise {
  let kwargs : Map[String, String] = Map([])
  for pair in options.split(";") {
    if pair.find("=") is Some(i) {
      kwargs[pair[:i].to_owned()] = pair[i + 1:].to_owned()
    }
  }
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    width~,
    file~,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let markdown = @markdown.Markdown::new(
    markup,
    hyperlinks=kwargs.get("hyperlinks") != Some("false"),
    justify?=kwargs.get("justify").bind(@rich.JustifyMethod::parse),
    style?=kwargs.get("style").map(s => (s : &@rich.IntoStyle)),
    code_theme?=kwargs.get("code_theme"),
    inline_code_lexer?=kwargs.get("inline_code_lexer"),
    inline_code_theme?=kwargs.get("inline_code_theme"),
  )
  console.print(markdown)
  replace_link_ids(file.getvalue())
}

///|

///|
test "markdown-it token stream: CommonMark spec examples" {
  let failures = []
  for i, case in spec_token_cases {
    let (markup, expected) = case
    if dump_tokens(markup) != expected {
      failures.push(i)
    }
  }
  debug_inspect(
    (spec_token_cases.length() - failures.length(), spec_token_cases.length()),
    content="(652, 652)",
  )
  assert_eq(failures, [])
}

///|
test "markdown-it token stream: corpus" {
  let failures = []
  for i, case in corpus_token_cases {
    let (markup, expected) = case
    if dump_tokens(markup) != expected {
      failures.push(i)
    }
  }
  assert_eq(failures, [])
}

///|
test "rendered output matches upstream" {
  for case in render_cases {
    let (markup, width, options, expected) = case
    let actual = render_with_options(markup, width, options) catch {
      e => "error: \{e}"
    }
    assert_eq(actual, expected, msg="\{markup} (width \{width}, \{options})")
  }
}
