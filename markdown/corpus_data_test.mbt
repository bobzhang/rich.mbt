    "\u{1b}[48;2;240;240;240m                                                            \u{1b}[0m\n\u{1b}[48;2;240;240;240m \u{1b}[0m\u{1b}[1;38;2;0;112;32;48;2;240;240;240mfn\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;240;240;240m \u{1b}[0m\u{1b}[38;2;6;40;126;48;2;240;240;240mmain\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;240;240;240m(\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;240;240;240m)\u{1b}[0m\u{1b}[38;2;187;187;187;48;2;240;240;240m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;240;240;240m{\u{1b}[0m\u{1b}[38;2;0;0;0;48;2;240;240;240m}\u{1b}[0m\u{1b}[48;2;240;240;240m                                              \u{1b}[0m\u{1b}[48;2;240;240;240m \u{1b}[0m\n\u{1b}[48;2;240;240;240m                                                            \u{1b}[0m\n\n\u{1b}[48;2;240;240;240m                                                            \u{1b}[0m\n\u{1b}[48;2;240;240;240m \u{1b}[0m\u{1b}[38;2;0;0;0;48;2;240;240;240mplain\u{1b}[0m\u{1b}[48;2;240;240;240m                                                     \u{1b}[0m\u{1b}[48;2;240;240;240m \u{1b}[0m\n\u{1b}[48;2;240;240;240m                                                            \u{1b}[0m\n",
