    "40;34m \u{1b}[0m\u{1b}[48;2;39;40;34m                                                                                                  \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mconsole\u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mprint\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mtable\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                              \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m                                                                                                    \u{1b}[0m\n\nThis produces the following output:                                                                 \n\n🌆 \u{1b}]8;id=0;foo\u{1b}\\table\u{1b}]8;;\u{1b}\\                                                                                            \n\nNote that console markup is rendered in the same way as \u{1b}[1;36;40mprint()\u{1b}[0m and \u{1b}[1;36;40mlog()\u{1b}[0m. In fact, anything that is\nrenderable by Rich may be included in the headers / rows (even other tables).                       \n\nThe \u{1b}[1;36;40mTable\u{1b}[0m class is smart enough to resize columns to fit the available width of the terminal,       \nwrapping text as required. Here's the same example, with the terminal made smaller than the table   \nabove:                                                                                              \n\n🌆 \u{1b}]8;id=0;foo\u{1b}\\table2\u{1b}]8;;\u{1b}\\                                           " +
    "                                                \n\n\n\nRich can render multiple flicker-free \u{1b}]8;id=0;foo\u{1b}\\\u{1b}[4;34mprogress\u{1b}[0m\u{1b}]8;;\u{1b}\\ bars to track long-running tasks.                    \n\nFor basic usage, wrap any sequence in the \u{1b}[1;36;40mtrack\u{1b}[0m function and iterate over the result. Here's an     \nexample:                                                                                            \n\n\u{1b}[48;2;39;40;34m                                                                                                    \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mfrom\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mrich\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mprogress\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mtrack\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                   \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[48;2;39;40;34m                                                                                                  \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mfor\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mstep\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34min\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mtrack\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;" +
    "40;34m(\u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34mrange\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;174;129;255;48;2;39;40;34m100\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m:\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                    \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m    \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mdo_step\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mstep\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                                 \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m                                                                                                    \u{1b}[0m\n\nIt's not much harder to add multiple progress bars. Here's an example taken from the docs:          \n\n🌆 \u{1b}]8;id=0;foo\u{1b}\\progress\u{1b}]8;;\u{1b}\\                                                                                         \n\nThe columns may be configured to show any details you want. Built-in columns include percentage     \ncomplete, file size, file speed, and time remaining. Here's another example showing a download in   \nprogress:                                                                                           \n\n🌆 \u{1b}]8;id=0;foo\u{1b}\\progress\u{1b}]8;;\u{1b}\\                                                                                         \n\nTo try this out yourself, se" +
    "e \u{1b}]8;id=0;foo\u{1b}\\\u{1b}[4;34mexamples/downloader.py\u{1b}[0m\u{1b}]8;;\u{1b}\\ which can download multiple URLs simultaneously\nwhile displaying progress.                                                                          \n\n\n\nFor situations where it is hard to calculate progress, you can use the \u{1b}]8;id=0;foo\u{1b}\\\u{1b}[4;34mstatus\u{1b}[0m\u{1b}]8;;\u{1b}\\ method which will     \ndisplay a 'spinner' animation and message. The animation won't prevent you from using the console as\nnormal. Here's an example:                                                                          \n\n\u{1b}[48;2;39;40;34m                                                                                                    \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mfrom\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mtime\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34msleep\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                            \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mfrom\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mrich\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mconsole\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mConsole\u{1b}[0m\u{1b}[48;2;39;40;34m                " +
    "                                                  \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[48;2;39;40;34m                                                                                                  \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mconsole\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m=\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mConsole\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                               \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mtasks\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m=\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m[\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mf\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mtask \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m{\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mn\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m}\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mfor\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mn\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34min\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34mrange\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;174;12" +
    "9;255;48;2;39;40;34m1\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m,\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;174;129;255;48;2;39;40;34m11\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m]\u{1b}[0m\u{1b}[48;2;39;40;34m                                                       \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[48;2;39;40;34m                                                                                                  \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mwith\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mconsole\u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mstatus\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m[bold green]Working on tasks...\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mas\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mstatus\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m:\u{1b}[0m\u{1b}[48;2;39;40;34m                                 \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m    \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mwhile\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mtasks\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m:\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                         " +
    "         \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m        \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mtask\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m=\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mtasks\u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mpop\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;174;129;255;48;2;39;40;34m0\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                       \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m        \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34msleep\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;174;129;255;48;2;39;40;34m1\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                                  \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m        \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mconsole\u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mlog\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mf\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m{\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mtask\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m}\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m complete\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[48;2;39;40;" +
    "34m                                                           \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m                                                                                                    \u{1b}[0m\n\nThis generates the following output in the terminal.                                                \n\n🌆 \u{1b}]8;id=0;foo\u{1b}\\status\u{1b}]8;;\u{1b}\\                                                                                           \n\nThe spinner animations were borrowed from \u{1b}]8;id=0;foo\u{1b}\\\u{1b}[4;34mcli-spinners\u{1b}[0m\u{1b}]8;;\u{1b}\\. You can select a spinner by specifying the  \n\u{1b}[1;36;40mspinner\u{1b}[0m parameter. Run the following command to see the available values:                           \n\n\u{1b}[48;2;39;40;34m                                                                                                    \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mpython -m rich.spinner\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                            \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m                                                                                                    \u{1b}[0m\n\nThe above command generates the following output in the terminal:                                   \n\n🌆 \u{1b}]8;id=0;foo\u{1b}\\spinners\u{1b}]8;;\u{1b}\\                                                                                         \n\n\n\nRich can render a \u{1b}]8;id=0;foo\u{1b}\\\u{1b}[4;34mtree\u{1b}[0m\u{1b}]8;;\u{1b}\\ with guide lines. A tree is ideal for displaying a file structure, or any    \nother hierarchica" +
    "l data.                                                                            \n\nThe labels of the tree can be simple text or anything else Rich can render. Run the following for a \ndemonstration:                                                                                      \n\n\u{1b}[48;2;39;40;34m                                                                                                    \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mpython -m rich.tree\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                               \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m                                                                                                    \u{1b}[0m\n\nThis generates the following output:                                                                \n\n🌆 \u{1b}]8;id=0;foo\u{1b}\\markdown\u{1b}]8;;\u{1b}\\                                                                                         \n\nSee the \u{1b}]8;id=0;foo\u{1b}\\\u{1b}[4;34mtree.py\u{1b}[0m\u{1b}]8;;\u{1b}\\ example for a script that displays a tree view of any directory, similar to the     \nlinux \u{1b}[1;36;40mtree\u{1b}[0m command.                                                                                 \n\n\n\nRich can render content in neat \u{1b}]8;id=0;foo\u{1b}\\\u{1b}[4;34mcolumns\u{1b}[0m\u{1b}]8;;\u{1b}\\ with equal or optimal width. Here's a very basic clone of   \nthe (MacOS / Linux) \u{1b}[1;36;40mls\u{1b}[0m command which displays a directory listing in columns:                       \n\n\u{1b}[48;2;39;40;34m                               " +
    "                                                                     \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mos\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                                         \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34msys\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                                        \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[48;2;39;40;34m                                                                                                  \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mfrom\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mrich\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34mprint\u{1b}[0m\u{1b}[48;2;39;40;34m                                                                            \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mfrom\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mrich\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mcolumns\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38" +
