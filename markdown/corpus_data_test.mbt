    "examples/colum\u{1b}[0m\n\u{1b}[4;34mns.py\u{1b}[0m) which displays data pulled from an API in columns:   \n\n🌆 columns                                                  \n\n\n\nRich can render \u{1b}[94mmarkdown\u{1b}[0m                                    \n(\u{1b}[4;34mhttps://rich.readthedocs.io/en/latest/markdown.html\u{1b}[0m) and   \ndoes a reasonable job of translating the formatting to the  \nterminal.                                                   \n\nTo render markdown import the \u{1b}[1;36;40mMarkdown\u{1b}[0m class and construct  \nit with a string containing markdown code. Then print it to \nthe console. Here's an example:                             \n\n\u{1b}[48;2;39;40;34m                                                            \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mfrom\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mrich\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mconsole\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mConsole\u{1b}[0m\u{1b}[48;2;39;40;34m                          \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mfrom\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mrich\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mmarkdown\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;2" +
    "48;248;242;48;2;39;40;34mMarkdown\u{1b}[0m\u{1b}[48;2;39;40;34m                        \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[48;2;39;40;34m                                                          \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mconsole\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m=\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mConsole\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[48;2;39;40;34m                                       \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mwith\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;166;226;46;48;2;39;40;34mopen\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mREADME.md\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;102;217;239;48;2;39;40;34mas\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mreadme\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m:\u{1b}[0m\u{1b}[48;2;39;40;34m                         \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m    \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mmarkdown\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m=\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mMarkdown\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;3" +
    "4m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mreadme\u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mread\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[48;2;39;40;34m                    \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mconsole\u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mprint\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mmarkdown\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m)\u{1b}[0m\u{1b}[48;2;39;40;34m                                   \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m                                                            \u{1b}[0m\n\nThis will produce output something like the following:      \n\n🌆 markdown                                                 \n\n\n\nRich uses the \u{1b}[94mpygments\u{1b}[0m (\u{1b}[4;34mhttps://pygments.org/\u{1b}[0m) library to   \nimplement \u{1b}[94msyntax highlighting\u{1b}[0m                               \n(\u{1b}[4;34mhttps://rich.readthedocs.io/en/latest/syntax.html\u{1b}[0m). Usage  \nis similar to rendering markdown; construct a \u{1b}[1;36;40mSyntax\u{1b}[0m object \nand print it to the console. Here's an example:             \n\n\u{1b}[48;2;39;40;34m                                                            \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mfrom\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mrich\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;4" +
    "0;34mconsole\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mConsole\u{1b}[0m\u{1b}[48;2;39;40;34m                          \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mfrom\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mrich\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m.\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34msyntax\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34mimport\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mSyntax\u{1b}[0m\u{1b}[48;2;39;40;34m                            \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[48;2;39;40;34m                                                          \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mmy_code\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m=\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m'''\u{1b}[0m\u{1b}[48;2;39;40;34m                                             \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mdef iter_first_last(values: Iterable[T]) -> \u{1b}[0m\u{1b}[48;2;39;40;34m              \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mIterable[Tuple[bool, bool, T]]:\u{1b}[0m\u{1b}[48;2;39;40;34m                           \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m    \u{1b}[" +
    "0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mIterate and generate a tuple with a flag for first \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mand last value.\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[48;2;39;40;34m                                        \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m    iter_values = iter(values)\u{1b}[0m\u{1b}[48;2;39;40;34m                            \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m    try:\u{1b}[0m\u{1b}[48;2;39;40;34m                                                  \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m        previous_value = next(iter_values)\u{1b}[0m\u{1b}[48;2;39;40;34m                \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m    except StopIteration:\u{1b}[0m\u{1b}[48;2;39;40;34m                                 \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m        return\u{1b}[0m\u{1b}[48;2;39;40;34m                                            \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m    first = True\u{1b}[0m\u{1b}[48;2;39;40;34m                                          \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m   " +
    " for value in iter_values:\u{1b}[0m\u{1b}[48;2;39;40;34m                             \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m        yield first, False, previous_value\u{1b}[0m\u{1b}[48;2;39;40;34m                \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m        first = False\u{1b}[0m\u{1b}[48;2;39;40;34m                                     \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m        previous_value = value\u{1b}[0m\u{1b}[48;2;39;40;34m                            \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m    yield first, True, previous_value\u{1b}[0m\u{1b}[48;2;39;40;34m                     \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m'''\u{1b}[0m\u{1b}[48;2;39;40;34m                                                       \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34msyntax\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;255;70;137;48;2;39;40;34m=\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mSyntax\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m(\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mmy_code\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m,\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34mpython\u{1b}[0m\u{1b}[38;2;230;219;116;48;2;39;40;34m\"\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m,\u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mthe" +
