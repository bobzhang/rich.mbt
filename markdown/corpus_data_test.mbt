    "                                                         \u{1b}[1;4mTitle\u{1b}[0m                                                          \n\nSome \u{1b}[3mtext\u{1b}[0m with a \u{1b}[94mlink\u{1b}[0m (\u{1b}[4;34mhttp://example.com\u{1b}[0m).                                                                             \n\n\u{1b}[35m▌ \u{1b}[0m\u{1b}[35mA quote\u{1b}[0m\u{1b}[35m                                                                                                             \u{1b}[0m\n\n\u{1b}[1m • \u{1b}[0mitem 1                                                                                                               \n\u{1b}[1m • \u{1b}[0mitem 2                                                                                                               \n\n\u{1b}[36m 1 \u{1b}[0mone                                                                                                                  \n\u{1b}[36m 2 \u{1b}[0mtwo                                                                                                                  \n\n\u{1b}[2m------------------------------------------------------------------------------------------------------------------------\u{1b}[0m\n\n\n\u{1b}[36m      \u{1b}[0m\n\u{1b}[36m \u{1b}[0m\u{1b}[36mx\u{1b}[0m\u{1b}[1m \u{1b}[0m\u{1b}[36m \u{1b}[0m\u{1b}[36my\u{1b}[0m\u{1b}[36m \u{1b}[0m\n\u{1b}[36m ──── \u{1b}[0m\n\u{1b}[36m \u{1b}[0m1 \u{1b}[36m \u{1b}[0m2\u{1b}[36m \u{1b}[0m\n\u{1b}[36m      \u{1b}[0m\n\n\u{1b}[48;2;39;40;34m                                                                                                                        \u{1b}[0m\n\u{1b}[48;2;39;40;34m \u{1b}[0m\u{1b}[38;2;248;248;242;48;2;39;40;34mcode\u{1b}[0m\u{1b}[48;2;39;40;34m                                                          " +
    "                                                        \u{1b}[0m\u{1b}[48;2;39;40;34m \u{1b}[0m\n\u{1b}[48;2;39;40;34m                                                                                                                        \u{1b}[0m\n\nEnd.                                                                                                                    \n",
