///|
test "oracle long" {
  let (console, file) = term_console(60)
  let handler = @logging.RichHandler::new(console~, enable_link_path=false)
  handler.set_formatter(Some(@logging.Formatter::new(datefmt="%Y")))
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "Loading configuration file /adasd/asdasd/qeqwe/qwrqwrqwr/sdgsdgsdg/werwerwer/dfgerert/ertertert/ertetert/werwerwer and more words to wrap",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      40,
      "with exception",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
      exc_text="Traceback (most recent call last):\n  File \"app.py\", line 3, in <module>\nZeroDivisionError: division by zero",
    ),
  )
  assert_eq(
    normalize_links(file.getvalue()),
    "\u{1b}[2;36m2023\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m Loading configuration file           \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m         \u{1b}[35m/adasd/asdasd/qeqwe/qwrqwrqwr/sdgsdg\u{1b}[0m \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m         \u{1b}[35msdg/werwerwer/dfgerert/ertertert/ert\u{1b}[0m \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m         \u{1b}[35metert/\u{1b}[0m\u{1b}[95mwerwerwer\u{1b}[0m and more words to    \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m         wrap                                 \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m    \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[1;31mERROR   \u{1b}[0m with exception                       \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m         Traceback \u{1b}[1m(\u{1b}[0mmost recent call last\u{1b}[1m)\u{1b}[0m:   \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m           File \u{1b}[32m\"app.py\"\u{1b}[0m, line \u{1b}[1;36m3\u{1b}[0m, in \u{1b}[1m<\u{1b}[0m\u{1b}[1;95mmodule\u{1b}[0m\u{1b}[1m>\u{1b}[0m \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m         ZeroDivisionError: division by zero  \u{1b}[2m         \u{1b}[0m\n",
  )
}

///|
test "oracle formatter_fields" {
  let (console, file) = term_console(120)
  let handler = @logging.RichHandler::new(console~, enable_link_path=false)
  handler.set_formatter(
    Some(
      @logging.Formatter::new(
        fmt="%(levelname)s:%(name)s:%(message)s [%(asctime)s] %(lineno)d %(filename)s %(module)s %(funcName)s %(levelno)05d|%(name)-6s|%(name)6s|%(msg).3s|%%",
        datefmt="%Y",
      ),
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "Server starting...",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "Listening on http://127.0.0.1:8080",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      40,
      "with exception",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
      exc_text="Traceback (most recent call last):\n  File \"app.py\", line 3, in <module>\nZeroDivisionError: division by zero",
    ),
  )
  assert_eq(
    normalize_links(file.getvalue()),
    "\u{1b}[2;36m2023\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m INFO:rich:Server starting\u{1b}[33m...\u{1b}[0m \u{1b}[1m[\u{1b}[0m\u{1b}[1;36m2023\u{1b}[0m\u{1b}[1m]\u{1b}[0m \u{1b}[1;36m10\u{1b}[0m app.py app main \u{1b}[1;36m00020\u{1b}[0m|rich  |  rich|Ser|%                 \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m    \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m INFO:rich:Listening on \u{1b}[4;94mhttp://127.0.0.1:8080\u{1b}[0m \u{1b}[1m[\u{1b}[0m\u{1b}[1;36m2023\u{1b}[0m\u{1b}[1m]\u{1b}[0m \u{1b}[1;36m10\u{1b}[0m app.py app main \u{1b}[1;36m00020\u{1b}[0m|rich  |  rich|Lis|% \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m    \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[1;31mERROR   \u{1b}[0m ERROR:rich:with exception \u{1b}[1m[\u{1b}[0m\u{1b}[1;36m2023\u{1b}[0m\u{1b}[1m]\u{1b}[0m \u{1b}[1;36m10\u{1b}[0m app.py app main \u{1b}[1;36m00040\u{1b}[0m|rich  |  rich|wit|%                    \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m         Traceback \u{1b}[1m(\u{1b}[0mmost recent call last\u{1b}[1m)\u{1b}[0m:                                                               \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m           File \u{1b}[32m\"app.py\"\u{1b}[0m, line \u{1b}[1;36m3\u{1b}[0m, in \u{1b}[1m<\u{1b}[0m\u{1b}[1;95mmodule\u{1b}[0m\u{1b}[1m>\u{1b}[0m                                                             \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m     \u{1b}[0m         ZeroDivisionError: division by zero                                                              \u{1b}[2m         \u{1b}[0m\n",
  )
}
