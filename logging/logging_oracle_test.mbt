    @logging.LogRecord::new(
      name="rich",
      20,
      "[bold]EXITING...[/bold]",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000004.25,
      markup=true,
    ),
  )
  assert_eq(
    normalize_links(file.getvalue()),
    "\u{1b}[2;36m[DATE]\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m Server starting\u{1b}[33m...\u{1b}[0m                                     \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m Listening on \u{1b}[4;94mhttp://127.0.0.1:8080\u{1b}[0m                     \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m \u{1b}[1;33mGET\u{1b}[0m \u{1b}[35m/\u{1b}[0m\u{1b}[95mindex.html\u{1b}[0m \u{1b}[1;36m200\u{1b}[0m \u{1b}[1;36m1298\u{1b}[0m                               \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[33mWARNING \u{1b}[0m \u{1b}[1;33mGET\u{1b}[0m \u{1b}[35m/\u{1b}[0m\u{1b}[95mfavicon.ico\u{1b}[0m \u{1b}[1;36m404\u{1b}[0m \u{1b}[1;36m242\u{1b}[0m                               \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[32mDEBUG   \u{1b}[0m JSONRPC request                                        \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m       \u{1b}[0m         --> \u{1b}[1m{\u{1b}[0m\u{1b}[32m'version'\u{1b}[0m: \u{1b}[32m'1.1'\u{1b}[0m, \u{1b}[32m'params'\u{1b}[0m: \u{1b}[1m[\u{1b}[0m\u{1b}[1m[\u{1b}[0m\u{1b}[32m'apple'\u{1b}[0m, \u{1b}[32m'orange'\u{1b}[0m\u{1b}[1m]\u{1b}[0m, \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m       \u{1b}[0m         \u{1b}[1;36m1.123\u{1b}[0m\u{1b}[1m]\u{1b}[0m\u{1b}[1m}\u{1b}[0m                                                \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m       \u{1b}[0m         <-- \u{1b}[1m{\u{1b}[0m\u{1b}[32m'result'\u{1b}[0m: \u{1b}[3;92mTrue\u{1b}[0m, \u{1b}[32m'error'\u{1b}[0m: \u{1b}[3;35mNone\u{1b}[0m\u{1b}[1m}\u{1b}[0m                    \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[1;31mERROR   \u{1b}[0m Unable to find \u{1b}[32m'pomelo'\u{1b}[0m in database!                   \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[1;7;31m