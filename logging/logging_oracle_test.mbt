    normalize_links(file.getvalue()),
    "\u{1b}[2;32m0\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m Server starting\u{1b}[33m...\u{1b}[0m                                          \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;36m \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m Listening on \u{1b}[4;94mhttp://127.0.0.1:8080\u{1b}[0m                          \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;32m1\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m \u{1b}[1;33mGET\u{1b}[0m \u{1b}[35m/\u{1b}[0m\u{1b}[95mindex.html\u{1b}[0m \u{1b}[1;36m200\u{1b}[0m \u{1b}[1;36m1298\u{1b}[0m                                    \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;36m \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[33mWARNING \u{1b}[0m \u{1b}[1;33mGET\u{1b}[0m \u{1b}[35m/\u{1b}[0m\u{1b}[95mfavicon.ico\u{1b}[0m \u{1b}[1;36m404\u{1b}[0m \u{1b}[1;36m242\u{1b}[0m                                    \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;32m2\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[32mDEBUG   \u{1b}[0m JSONRPC request                                             \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;36m  \u{1b}[0m         --> \u{1b}[1m{\u{1b}[0m\u{1b}[32m'version'\u{1b}[0m: \u{1b}[32m'1.1'\u{1b}[0m, \u{1b}[32m'params'\u{1b}[0m: \u{1b}[1m[\u{1b}[0m\u{1b}[1m[\u{1b}[0m\u{1b}[32m'apple'\u{1b}[0m, \u{1b}[32m'orange'\u{1b}[0m\u{1b}[1m]\u{1b}[0m,      \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m  \u{1b}[0m         \u{1b}[1;36m1.123\u{1b}[0m\u{1b}[1m]\u{1b}[0m\u{1b}[1m}\u{1b}[0m                                                     \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m  \u{1b}[0m         <-- \u{1b}[1m{\u{1b}[0m\u{1b}[32m'result'\u{1b}[0m: \u{1b}[3;92mTrue\u{1b}[0m, \u{1b}[32m'error'\u{1b}[0m: \u{1b}[3;35mNone\u{1b}[0m\u{1b}[1m}\u{1b}[0m                         \u{1b}[2m         \u{1b}[0m\n\u{1b}[2;36m \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[1;31mERROR   \u{1b}[0m Unable to find \u{1b}[32m'pomelo'\u{1b}[0m in database!                        \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;32m3\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[1;7;31mCRITICAL\u{1b}[0m Out of memory!                                                 \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;36m \u{1b}[0m\u{1b}[2;36m \u{1b}[0mLevel 25 custom level \u{1b}[1;36m25\u{1b}[0m                                             \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;32m4\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m \u{1b}[1mEXITING\u{1b}[0m\u{1b}[1;33m...\u{1b}[0m                                                  \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n",
  )
}

///|
test "oracle no_omit" {
  let (console, file) = term_console(60)
  let handler = @logging.RichHandler::new(
    console~,
    omit_repeated_times=false,
    log_time_format="%Y",
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "Server starting...",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "Listening on http://127.0.0.1:8080",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "GET /index.html 200 1298",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000001.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      30,
      "GET /favicon.ico 404 242",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000001.25,
    ),
  )
  assert_eq(
    normalize_links(file.getvalue()),
    "\u{1b}[2;36m2023\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m Server starting\u{1b}[33m...\u{1b}[0m                   \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;36m2023\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m Listening on \u{1b}[4;94mhttp://127.0.0.1:8080\u{1b}[0m   \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;36m2023\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m \u{1b}[1;33mGET\u{1b}[0m \u{1b}[35m/\u{1b}[0m\u{1b}[95mindex.html\u{1b}[0m \u{1b}[1;36m200\u{1b}[0m \u{1b}[1;36m1298\u{1b}[0m             \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n\u{1b}[2;36m2023\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[33mWARNING \u{1b}[0m \u{1b}[1;33mGET\u{1b}[0m \u{1b}[35m/\u{1b}[0m\u{1b}[95mfavicon.ico\u{1b}[0m \u{1b}[1;36m404\u{1b}[0m \u{1b}[1;36m242\u{1b}[0m             \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n",
  )
}

///|
test "oracle no_time_level_path" {
  let (console, file) = term_console(50)
  let handler = @logging.RichHandler::new(
    console~,
    show_time=false,
    show_level=false,
    show_path=false,
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "Server starting...",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "Listening on http://127.0.0.1:8080",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "GET /index.html 200 1298",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000001.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      30,
      "GET /favicon.ico 404 242",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000001.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      10,
      "JSONRPC request\n--> {'version': '1.1', 'params': [['apple', 'orange'], 1.123]}\n<-- {'result': True, 'error': None}",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000002.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      40,
      "Unable to find 'pomelo' in database!",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000002.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      50,
      "Out of memory!",
      pathname="/home/user/project/app.py",
      lineno=0,
      func_name="main",
      created=1700000003.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      25,
      "custom level 25",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000003.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "[bold]EXITING...[/bold]",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000004.25,
      markup=true,
    ),
  )
  assert_eq(
    normalize_links(file.getvalue()),
    "Server starting\u{1b}[33m...\u{1b}[0m                                \nListening on \u{1b}[4;94mhttp://127.0.0.1:8080\u{1b}[0m                \n\u{1b}[1;33mGET\u{1b}[0m \u{1b}[35m/\u{1b}[0m\u{1b}[95mindex.html\u{1b}[0m \u{1b}[1;36m200\u{1b}[0m \u{1b}[1;36m1298\u{1b}[0m                          \n\u{1b}[1;33mGET\u{1b}[0m \u{1b}[35m/\u{1b}[0m\u{1b}[95mfavicon.ico\u{1b}[0m \u{1b}[1;36m404\u{1b}[0m \u{1b}[1;36m242\u{1b}[0m                          \nJSONRPC request                                   \n--> \u{1b}[1m{\u{1b}[0m\u{1b}[32m'version'\u{1b}[0m: \u{1b}[32m'1.1'\u{1b}[0m, \u{1b}[32m'params'\u{1b}[0m: \u{1b}[1m[\u{1b}[0m\u{1b}[1m[\u{1b}[0m\u{1b}[32m'apple'\u{1b}[0m,       \n\u{1b}[32m'orange'\u{1b}[0m\u{1b}[1m]\u{1b}[0m, \u{1b}[1;36m1.123\u{1b}[0m\u{1b}[1m]\u{1b}[0m\u{1b}[1m}\u{1b}[0m                                \n<-- \u{1b}[1m{\u{1b}[0m\u{1b}[32m'result'\u{1b}[0m: \u{1b}[3;92mTrue\u{1b}[0m, \u{1b}[32m'error'\u{1b}[0m: \u{1b}[3;35mNone\u{1b}[0m\u{1b}[1m}\u{1b}[0m               \nUnable to find \u{1b}[32m'pomelo'\u{1b}[0m in database!              \nOut of memory!                                    \ncustom level \u{1b}[1;36m25\u{1b}[0m                                   \n\u{1b}[1mEXITING\u{1b}[0m\u{1b}[1;33m...\u{1b}[0m                                        \n",
  )
}

