            \u{1b}[2m         \u{1b}[0m\n         <-- \u{1b}[1m{\u{1b}[0m\u{1b}[32m'result'\u{1b}[0m: \u{1b}[3;92mTrue\u{1b}[0m, \u{1b}[32m'error'\u{1b}[0m: \u{1b}[3;35mNone\u{1b}[0m\u{1b}[1m}\u{1b}[0m       \u{1b}[2m         \u{1b}[0m\n\u{1b}[1;31mERROR   \u{1b}[0m Unable to find \u{1b}[32m'pomelo'\u{1b}[0m in database!      \u{1b}]8;id=0;file:///home/user/project/app.py\u{1b}\\\u{1b}[2mapp.py\u{1b}[0m\u{1b}]8;;\u{1b}\\\u{1b}[2m:\u{1b}[0m\u{1b}]8;id=0;file:///home/user/project/app.py#10\u{1b}\\\u{1b}[2m10\u{1b}[0m\u{1b}]8;;\u{1b}\\\n",
