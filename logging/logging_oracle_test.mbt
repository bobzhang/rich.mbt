test "oracle basic" {
  let (console, file) = term_console(80)
  let handler = @logging.RichHandler::new(console~, enable_link_path=false)
  handler.set_formatter(Some(@logging.Formatter::new(datefmt="[DATE]")))
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "Server starting...",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "Listening on http://127.0.0.1:8080",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "GET /index.html 200 1298",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000001.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      30,
      "GET /favicon.ico 404 242",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000001.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      10,
      "JSONRPC request\n--> {'version': '1.1', 'params': [['apple', 'orange'], 1.123]}\n<-- {'result': True, 'error': None}",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000002.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      40,
      "Unable to find 'pomelo' in database!",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000002.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      50,
      "Out of memory!",
      pathname="/home/user/project/app.py",
      lineno=0,
      func_name="main",
      created=1700000003.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      25,
      "custom level 25",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000003.25,
    ),
  )
