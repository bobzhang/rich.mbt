///|
test "oracle markup" {
  let (console, file) = term_console(100)
  let handler = @logging.RichHandler::new(
    console~,
    markup=true,
    enable_link_path=false,
  )
  handler.set_formatter(Some(@logging.Formatter::new(datefmt="[DATE]")))
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "foo 3.141 127.0.0.1 [red]alert[/red]",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "foo 3.141 127.0.0.1 [red]alert[/red]",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
      markup=false,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "foo 3.141 127.0.0.1 [red]alert[/red] POST",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
      highlighter=@rich.NullHighlighter::new(),
    ),
  )
  assert_eq(
    normalize_links(file.getvalue()),
    "\u{1b}[2;36m[DATE]\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m foo \u{1b}[1;36m3.141\u{1b}[0m \u{1b}[1;92m127.0.0.1\u{1b}[0m \u{1b}[31malert\u{1b}[0m                                                  \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m foo \u{1b}[1;36m3.141\u{1b}[0m \u{1b}[1;92m127.0.0.1\u{1b}[0m \u{1b}[1m[\u{1b}[0mred\u{1b}[1m]\u{1b}[0malert\u{1b}[1m[\u{1b}[0m\u{1b}[35m/\u{1b}[0m\u{1b}[95mred\u{1b}[0m\u{1b}[1m]\u{1b}[0m                                       \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m foo 3.141 127.0.0.1 \u{1b}[31malert\u{1b}[0m \u{1b}[1;33mPOST\u{1b}[0m                                             \u{1b}[2mapp.py:10\u{1b}[0m\n",
  )
}

///|
test "oracle keywords" {
  let (console, file) = term_console(100)
  let handler = @logging.RichHandler::new(
    console~,
    keywords=["foo", "alert"],
    enable_link_path=false,
  )
  handler.set_formatter(Some(@logging.Formatter::new(datefmt="[DATE]")))
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "foo 3.141 127.0.0.1 [red]alert[/red]",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "foo 3.141 127.0.0.1 [red]alert[/red]",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
      markup=false,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "foo 3.141 127.0.0.1 [red]alert[/red] POST",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000000.25,
      highlighter=@rich.NullHighlighter::new(),
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      20,
      "GET /index.html 200 1298",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000001.25,
    ),
  )
  handler.handle(
    @logging.LogRecord::new(
      name="rich",
      30,
      "GET /favicon.ico 404 242",
      pathname="/home/user/project/app.py",
      lineno=10,
      func_name="main",
      created=1700000001.25,
    ),
  )
  assert_eq(
    normalize_links(file.getvalue()),
    "\u{1b}[2;36m[DATE]\u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m \u{1b}[1;33mfoo\u{1b}[0m \u{1b}[1;36m3.141\u{1b}[0m \u{1b}[1;92m127.0.0.1\u{1b}[0m \u{1b}[1m[\u{1b}[0mred\u{1b}[1m]\u{1b}[0m\u{1b}[1;33malert\u{1b}[0m\u{1b}[1m[\u{1b}[0m\u{1b}[35m/\u{1b}[0m\u{1b}[95mred\u{1b}[0m\u{1b}[1m]\u{1b}[0m                                       \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m \u{1b}[1;33mfoo\u{1b}[0m \u{1b}[1;36m3.141\u{1b}[0m \u{1b}[1;92m127.0.0.1\u{1b}[0m \u{1b}[1m[\u{1b}[0mred\u{1b}[1m]\u{1b}[0m\u{1b}[1;33malert\u{1b}[0m\u{1b}[1m[\u{1b}[0m\u{1b}[35m/\u{1b}[0m\u{1b}[95mred\u{1b}[0m\u{1b}[1m]\u{1b}[0m                                       \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m \u{1b}[1;33mfoo\u{1b}[0m 3.141 127.0.0.1 [red]\u{1b}[1;33malert\u{1b}[0m[/red] POST                                  \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[34mINFO    \u{1b}[0m GET \u{1b}[35m/\u{1b}[0m\u{1b}[95mindex.html\u{1b}[0m \u{1b}[1;36m200\u{1b}[0m \u{1b}[1;36m1298\u{1b}[0m                                                   \u{1b}[2mapp.py:10\u{1b}[0m\n\u{1b}[2;36m      \u{1b}[0m\u{1b}[2;36m \u{1b}[0m\u{1b}[33mWARNING \u{1b}[0m GET \u{1b}[35m/\u{1b}[0m\u{1b}[95mfavicon.ico\u{1b}[0m \u{1b}[1;36m404\u{1b}[0m \u{1b}[1;36m242\u{1b}[0m                                                   \u{1b}[2mapp.py:10\u{1b}[0m\n",
  )
}

