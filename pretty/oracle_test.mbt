  )
  assert_eq(
    @pretty.pretty_repr(value, max_string=5, max_width=40),
    "{\n    'versi'+2: '1.1',\n    'metho'+1: 'confi'+15,\n    'param'+1: [\n        [\n            'apple',\n            'orang'+1,\n            'mango'+2,\n            'pomel'+1\n        ],\n        1.123\n    ],\n    'id': '19452'+4\n}",
  )
