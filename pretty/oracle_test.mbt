///|
test "oracle mixed_list" {
  let value = (
    [1, 2, 3, "four", 5.5, none, true, false] : Array[&@pretty.PrettyRepr])
  assert_eq(
    @pretty.pretty_repr(value, max_width=4),
    "[\n    1,\n    2,\n    3,\n    'four',\n    5.5,\n    None,\n    True,\n    False\n]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_width=10),
    "[\n    1,\n    2,\n    3,\n    'four',\n    5.5,\n    None,\n    True,\n    False\n]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_width=20),
    "[\n    1,\n    2,\n    3,\n    'four',\n    5.5,\n    None,\n    True,\n    False\n]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_width=30),
    "[\n    1,\n    2,\n    3,\n    'four',\n    5.5,\n    None,\n    True,\n    False\n]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_width=40),
    "[\n    1,\n    2,\n    3,\n    'four',\n    5.5,\n    None,\n    True,\n    False\n]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_width=60),
    "[1, 2, 3, 'four', 5.5, None, True, False]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_width=80),
    "[1, 2, 3, 'four', 5.5, None, True, False]",
  )
  assert_eq(
    @pretty.pretty_repr(value, expand_all=true, indent_size=2),
    "[\n  1,\n  2,\n  3,\n  'four',\n  5.5,\n  None,\n  True,\n  False\n]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_length=2, max_width=40),
    "[1, 2, ... +6]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_string=5, max_width=40),
    "[\n    1,\n    2,\n    3,\n    'four',\n    5.5,\n    None,\n    True,\n    False\n]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_depth=1),
    "[1, 2, 3, 'four', 5.5, None, True, False]",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_depth=2, max_width=30),
    "[\n    1,\n    2,\n    3,\n    'four',\n    5.5,\n    None,\n    True,\n    False\n]",
  )
  assert_eq(
    render_pretty(value, width=24, indent_guides=true),
    "\u{1b}[1m[\u{1b}[0m\n\u{1b}[2;32m│   \u{1b}[0m\u{1b}[1;36m1\u{1b}[0m,\n\u{1b}[2;32m│   \u{1b}[0m\u{1b}[1;36m2\u{1b}[0m,\n\u{1b}[2;32m│   \u{1b}[0m\u{1b}[1;36m3\u{1b}[0m,\n\u{1b}[2;32m│   \u{1b}[0m\u{1b}[32m'four'\u{1b}[0m,\n\u{1b}[2;32m│   \u{1b}[0m\u{1b}[1;36m5.5\u{1b}[0m,\n\u{1b}[2;32m│   \u{1b}[0m\u{1b}[3;35mNone\u{1b}[0m,\n\u{1b}[2;32m│   \u{1b}[0m\u{1b}[3;92mTrue\u{1b}[0m,\n\u{1b}[2;32m│   \u{1b}[0m\u{1b}[3;91mFalse\u{1b}[0m\n\u{1b}[1m]\u{1b}[0m\n",
  )
  assert_eq(
    render_pretty(value, width=50, indent_guides=false),
    "\u{1b}[1m[\u{1b}[0m\u{1b}[1;36m1\u{1b}[0m, \u{1b}[1;36m2\u{1b}[0m, \u{1b}[1;36m3\u{1b}[0m, \u{1b}[32m'four'\u{1b}[0m, \u{1b}[1;36m5.5\u{1b}[0m, \u{1b}[3;35mNone\u{1b}[0m, \u{1b}[3;92mTrue\u{1b}[0m, \u{1b}[3;91mFalse\u{1b}[0m\u{1b}[1m]\u{1b}[0m\n",
  )
}

