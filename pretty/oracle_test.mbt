    "{\n    'version': '1.1',\n    'method': 'confirmFruitPurchase',\n    'params': [\n        [\n            'apple',\n            'orange',\n            'mangoes',\n            'pomelo'\n        ],\n        1.123\n    ],\n    'id': '194521489'\n}",
  )
  assert_eq(
    @pretty.pretty_repr(value, max_width=60),
    "{\n    'version': '1.1',\n    'method': 'confirmFruitPurchase',\n    'params': [\n        ['apple', 'orange', 'mangoes', 'pomelo'],\n        1.123\n    ],\n    'id': '194521489'\n}",
  )
