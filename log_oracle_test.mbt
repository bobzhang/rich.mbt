///|
test "log oracle style and markup" {
  let file = @rich.StringIO::new()
  let now = Ref(1700000000.0)
  let console = @rich.Console::new(
    file~,
    width=60,
    force_terminal=true,
    color_system=Some("truecolor"),
    legacy_windows=false,
    environ={},
    get_datetime=() => now.val,
  )
  now.val = 1700000000.0
  console.log("[bold]bold[/] text", style="on blue")
  now.val = 1700000000.0
  console.log("[bold]not markup", markup=false)
  now.val = 1700000000.0
  console.log(":smile: 123", emoji=false, highlight=false)
  now.val = 1700003723.0
  console.log_many(["a", "b", "c"], sep="-")
  check_log(file.getvalue(), 8)
}

