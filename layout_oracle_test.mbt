  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=60,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print_json(
    json="[1, -0, -0.0, 1e5, 1.0E-7, 123456789012345678901234567890, 2.5e-300]",
    indent=Some(0),
    sort_keys=true,
    ensure_ascii=false,
  )
  assert_eq(
    file.getvalue(),
    "\u{1b}[1m[\u{1b}[0m\n\u{1b}[1;36m1\u{1b}[0m,\n\u{1b}[1;36m0\u{1b}[0m,\n\u{1b}[1;36m-0.0\u{1b}[0m,\n\u{1b}[1;36m100000.0\u{1b}[0m,\n\u{1b}[1;36m1e-07\u{1b}[0m,\n\u{1b}[1;36m123456789012345678901234567890\u{1b}[0m,\n\u{1b}[1;36m2.5e-300\u{1b}[0m\n\u{1b}[1m]\u{1b}[0m\n",
  )
}

