///|
test "oracle print long word fold" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=20,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(
    "Supercalifragilisticexpialidocious-and-even-longer-wordsSupercalifragilisticexpialidocious-and-even-longer-words",
  )
  assert_eq(
    file.getvalue(),
    "Supercalifragilistic\nexpialidocious-and-e\nven-longer-wordsSupe\nrcalifragilisticexpi\nalidocious-and-even-\nlonger-words\n",
  )
}

