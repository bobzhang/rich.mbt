///|
test "oracle table cjk and emoji" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=30,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let table = @rich.Table::new()
  table.add_column(header="名前")
  table.add_column(header="Emoji :smile:")
  table.add_row(["日本語のテキスト", ":thumbs_up: ok"])
  table.add_row(["中文", "💩💩💩"])
  console.print(table)
  assert_eq(
    file.getvalue(),
    "┏━━━━━━━━━━━━━━━━━┳━━━━━━━━━━┓\n┃\u{1b}[1m \u{1b}[0m\u{1b}[1m名前           \u{1b}[0m\u{1b}[1m \u{1b}[0m┃\u{1b}[1m \u{1b}[0m\u{1b}[1mEmoji 😄\u{1b}[0m\u{1b}[1m \u{1b}[0m┃\n┡━━━━━━━━━━━━━━━━━╇━━━━━━━━━━┩\n│ 日本語のテキス… │ 👍 ok    │\n│ 中文            │ 💩💩💩   │\n└─────────────────┴──────────┘\n",
  )
}

///|
test "oracle table markup and highlight" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=50,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let table = @rich.Table::new()
  table.add_column(header="[bold]Key")
  table.add_column(header="Value", highlight=true)
  table.add_row(["[red]alpha", "123 'str' None"])
  table.add_row(["beta", "[1, 2.5, True]"])
  console.print(table)
  assert_eq(
    file.getvalue(),
    "┏━━━━━━━┳━━━━━━━━━━━━━━━━┓\n┃\u{1b}[1m \u{1b}[0m\u{1b}[1mKey\u{1b}[0m\u{1b}[1m  \u{1b}[0m\u{1b}[1m \u{1b}[0m┃\u{1b}[1m \u{1b}[0m\u{1b}[1mValue         \u{1b}[0m\u{1b}[1m \u{1b}[0m┃\n┡━━━━━━━╇━━━━━━━━━━━━━━━━┩\n│ \u{1b}[31malpha\u{1b}[0m │ \u{1b}[1;36m123\u{1b}[0m \u{1b}[32m'str'\u{1b}[0m \u{1b}[3;35mNone\u{1b}[0m │\n│ beta  │ \u{1b}[1m[\u{1b}[0m\u{1b}[1;36m1\u{1b}[0m, \u{1b}[1;36m2.5\u{1b}[0m, \u{1b}[3;92mTrue\u{1b}[0m\u{1b}[1m]\u{1b}[0m │\n└───────┴────────────────┘\n",
  )
}

///|
