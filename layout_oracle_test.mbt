    legacy_windows=false,
    environ={},
  )
  console.print(
    @rich.Rule::new(
      title="A very long title that will not fit",
      align=Left,
      characters="🎉",
    ),
  )
  assert_eq(file.getvalue(), "A very long title that… \u{1b}[92m \u{1b}[0m\n")
}

