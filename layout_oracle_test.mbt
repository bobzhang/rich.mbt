///|
test "oracle json 6 indent 2 sort False ascii False" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=60,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print_json(
    json="[NaN, Infinity, -Infinity, 3.141592653589793, 0.1, 1e22, 1e16, 12345678.9]",
    indent=Some(2),
    sort_keys=false,
    ensure_ascii=false,
  )
  assert_eq(
    file.getvalue(),
    "\u{1b}[1m[\u{1b}[0m\n  NaN,\n  Infinity,\n  -Infinity,\n  \u{1b}[1;36m3.141592653589793\u{1b}[0m,\n  \u{1b}[1;36m0.1\u{1b}[0m,\n  \u{1b}[1;36m1e+22\u{1b}[0m,\n  \u{1b}[1;36m1e+16\u{1b}[0m,\n  \u{1b}[1;36m12345678.9\u{1b}[0m\n\u{1b}[1m]\u{1b}[0m\n",
  )
}

