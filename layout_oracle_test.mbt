test "oracle table vertical top" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=40,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let table = @rich.Table::new()
  table.add_column(header="A", vertical=Top)
  table.add_column(header="B")
  table.add_column(header="C", vertical=Bottom)
  table.add_row(["x", "one\ntwo\nthree\nfour", "y"])
  table.add_row([
