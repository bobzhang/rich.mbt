    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print_json(
    json="\"just a string with \\\"quotes\\\" and \\\\ backslash \\n newline \\t tab\"",
    indent=Some(0),
    sort_keys=true,
    ensure_ascii=true,
