///|
test "oracle json 1 no highlight" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=60,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print_json(
    json="[1, -0, -0.0, 1e5, 1.0E-7, 123456789012345678901234567890, 2.5e-300]",
    highlight=false,
  )
  assert_eq(
    file.getvalue(),
    "[\n  1,\n  0,\n  -0.0,\n  100000.0,\n  1e-07,\n  123456789012345678901234567890,\n  2.5e-300\n]\n",
  )
}

///|
test "oracle json 2 indent 2 sort False ascii False" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=60,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print_json(
    json="{\"b\": 1, \"aa\": 2, \"B\": 3, \"\\u00e9\": 4, \"\\ud83d\\udca9\": 5, \"\\ue000\": 6, \"\": 7}",
    indent=Some(2),
    sort_keys=false,
    ensure_ascii=false,
  )
  assert_eq(
    file.getvalue(),
    "\u{1b}[1m{\u{1b}[0m\n  \u{1b}[1;34m\"b\"\u{1b}[0m: \u{1b}[1;36m1\u{1b}[0m,\n  \u{1b}[1;34m\"aa\"\u{1b}[0m: \u{1b}[1;36m2\u{1b}[0m,\n  \u{1b}[1;34m\"B\"\u{1b}[0m: \u{1b}[1;36m3\u{1b}[0m,\n  \u{1b}[1;34m\"é\"\u{1b}[0m: \u{1b}[1;36m4\u{1b}[0m,\n  \u{1b}[1;34m\"💩\"\u{1b}[0m: \u{1b}[1;36m5\u{1b}[0m,\n  \u{1b}[1;34m\"\"\u{1b}[0m: \u{1b}[1;36m6\u{1b}[0m,\n  \u{1b}[1;34m\"\"\u{1b}[0m: \u{1b}[1;36m7\u{1b}[0m\n\u{1b}[1m}\u{1b}[0m\n",
  )
}

