  )
  let table = @rich.Table::new(box_=@rich.box_simple, row_styles=[
    "on blue", "dim", "bold on red",
  ])
  table.add_column(header="Released", footer="Total", justify=Left)
  table.add_column(header="Title", footer="", justify=Center)
  table.add_column(header="Box Office", footer="$4,429,254,000", justify=Right)
  table.add_row([
    "Dec 20, 2019", "Star Wars: The Rise of Skywalker", "$952,110,690",
  ])
  table.add_row(["May 25, 2018", "Solo: A Star Wars Story", "$393,151,347"])
  table.add_row([
    "Dec 15, 2017", "Star Wars Ep. V111: The Last Jedi", "$1,332,539,889",
  ])
  table.add_row([
    "Dec 16, 2016", "Rogue One: A Star Wars Story", "$1,332,439,889",
  ])
  console.print(table)
  assert_eq(
    file.getvalue(),
    "                                                                     \n \u{1b}[1m \u{1b}[0m\u{1b}[1mReleased    \u{1b}[0m\u{1b}[1m \u{1b}[0m \u{1b}[1m \u{1b}[0m\u{1b}[1m              Title              \u{1b}[0m\u{1b}[1m \u{1b}[0m \u{1b}[1m \u{1b}[0m\u{1b}[1m    Box Office\u{1b}[0m\u{1b}[1m \u{1b}[0m \n ─────────────────────────────────────────────────────────────────── \n \u{1b}[44m \u{1b}[0m\u{1b}[44mDec 20, 2019\u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44mStar Wars: The Rise of Skywalker \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m  $952,110,690\u{1b}[0m\u{1b}[44m \u{1b}[0m \n \u{1b}[2m \u{1b}[0m\u{1b}[2mMay 25, 2018\u{1b}[0m\u{1b}[2m \u{1b}[0m \u{1b}[2m \u{1b}[0m\u{1b}[2m     Solo: A Star Wars Story     \u{1b}[0m\u{1b}[2m \u{1b}[0m \u{1b}[2m \u{1b}[0m\u{1b}[2m  $393,151,347\u{1b}[0m\u{1b}[2m \u{1b}[0m \n \u{1b}[1;41m \u{1b}[0m\u{1b}[1;41mDec 15, 2017\u{1b}[0m\u{1b}[1;41m \u{1b}[0m\u{1b}[41m \u{1b}[0m\u{1b}[1;41m \u{1b}[0m\u{1b}[1;41mStar Wars Ep. V111: The Last Jedi\u{1b}[0m\u{1b}[1;41m \u{1b}[0m\u{1b}[41m \u{1b}[0m\u{1b}[1;41m \u{1b}[0m\u{1b}[1;41m$1,332,539,889\u{1b}[0m\u{1b}[1;41m \u{1b}[0m \n \u{1b}[44m \u{1b}[0m\u{1b}[44mDec 16, 2016\u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m  Rogue One: A Star Wars Story   \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m \u{1b}[0m\u{1b}[44m$1,332,439,889\u{1b}[0m\u{1b}[44m \u{1b}[0m \n                                                                     \n",
