  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=20,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(@rich.Align::new("foo\nbarbaz", Center, vertical=Bottom))
  assert_eq(file.getvalue(), "       foo          \n       barbaz       \n")
}

///|
test "oracle align center bottom height None style on blue" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=20,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(
    @rich.Align::new("foo\nbarbaz", Center, vertical=Bottom, style="on blue"),
  )
  assert_eq(
    file.getvalue(),
    "\u{1b}[44m       \u{1b}[0m\u{1b}[44mfoo\u{1b}[0m\u{1b}[44m   \u{1b}[0m\u{1b}[44m       \u{1b}[0m\n\u{1b}[44m       \u{1b}[0m\u{1b}[44mbarbaz\u{1b}[0m\u{1b}[44m       \u{1b}[0m\n",
  )
}

