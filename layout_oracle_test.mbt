///|
test "oracle table styles" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=70,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let table = @rich.Table::new(
    style="on grey11",
    header_style="underline",
    footer_style="italic",
    border_style="red",
    title_style="bold yellow",
    caption_style="dim",
    show_footer=true,
    title="Title",
    caption="Caption",
  )
  table.add_column(
    header="Released",
    footer="Total",
    style="magenta",
    header_style="bold cyan",
    justify=Left,
  )
  table.add_column(
    header="Title",
    footer="",
    style="magenta",
    header_style="bold cyan",
    justify=Center,
  )
  table.add_column(
    header="Box Office",
    footer="$4,429,254,000",
    style="magenta",
    header_style="bold cyan",
    justify=Right,
  )
  table.add_row([
    "Dec 20, 2019", "Star Wars: The Rise of Skywalker", "$952,110,690",
  ])
  table.add_row(["May 25, 2018", "Solo: A Star Wars Story", "$393,151,347"])
  console.print(table)
  assert_eq(
    file.getvalue(),
    "\u{1b}[1;33m                               Title                                \u{1b}[0m\n\u{1b}[31;48;5;234m┏━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━┓\u{1b}[0m\n\u{1b}[31;48;5;234m┃\u{1b}[0m\u{1b}[1;4;36m \u{1b}[0m\u{1b}[1;4;36mReleased    \u{1b}[0m\u{1b}[1;4;36m \u{1b}[0m\u{1b}[31;48;5;234m┃\u{1b}[0m\u{1b}[1;4;36m \u{1b}[0m\u{1b}[1;4;36m             Title              \u{1b}[0m\u{1b}[1;4;36m \u{1b}[0m\u{1b}[31;48;5;234m┃\u{1b}[0m\u{1b}[1;4;36m \u{1b}[0m\u{1b}[1;4;36m    Box Office\u{1b}[0m\u{1b}[1;4;36m \u{1b}[0m\u{1b}[31;48;5;234m┃\u{1b}[0m\n\u{1b}[31;48;5;234m┡━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━┩\u{1b}[0m\n\u{1b}[31;48;5;234m│\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[35mDec 20, 2019\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[31;48;5;234m│\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[35mStar Wars: The Rise of Skywalker\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[31;48;5;234m│\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[35m  $952,110,690\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[31;48;5;234m│\u{1b}[0m\n\u{1b}[31;48;5;234m│\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[35mMay 25, 2018\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[31;48;5;234m│\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[35m    Solo: A Star Wars Story     \u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[31;48;5;234m│\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[35m  $393,151,347\u{1b}[0m\u{1b}[35m \u{1b}[0m\u{1b}[31;48;5;234m│\u{1b}[0m\n\u{1b}[31;48;5;234m├──────────────┼──────────────────────────────────┼────────────────┤\u{1b}[0m\n\u{1b}[31;48;5;234m│\u{1b}[0m\u{1b}[3m \u{1b}[0m\u{1b}[3mTotal       \u{1b}[0m\u{1b}[3m \u{1b}[0m\u{1b}[31;48;5;234m│\u{1b}[0m\u{1b}[3m \u{1b}[0m\u{1b}[3m                                \u{1b}[0m\u{1b}[3m \u{1b}[0m\u{1b}[31;48;5;234m│\u{1b}[0m\u{1b}[3m \u{1b}[0m\u{1b}[3m$4,429,254,000\u{1b}[0m\u{1b}[3m \u{1b}[0m\u{1b}[31;48;5;234m│\u{1b}[0m\n\u{1b}[31;48;5;234m└──────────────┴──────────────────────────────────┴────────────────┘\u{1b}[0m\n\u{1b}[2m                              Caption                           