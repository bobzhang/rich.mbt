///|
test "oracle table grid" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=40,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let table = @rich.Table::grid(padding=[0, 1], expand=false)
  table.add_column()
  table.add_column(justify=Right)
  table.add_row(["left", "right"])
  table.add_row(["a longer left cell", "r"])
  console.print(table)
  assert_eq(
    file.getvalue(),
    "left               right\na longer left cell     r\n",
  )
}

///|
test "oracle table grid expand" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=40,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let table = @rich.Table::grid(padding=[0], expand=true)
  table.add_column(ratio=1)
  table.add_column(justify=Right)
  table.add_row(["left", "right"])
  console.print(table)
  assert_eq(file.getvalue(), "left                               right\n")
}

///|
test "oracle table print justify left" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=80,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let table = @rich.Table::new()
  table.add_column(header="Released", footer="Total", justify=Left)
  table.add_column(header="Title", footer="", justify=Center)
  table.add_row([
    "Dec 20, 2019", "Star Wars: The Rise of Skywalker", "$952,110,690",
  ])
  console.print(table, justify=Left)
  assert_eq(
    file.getvalue(),
    "┏━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━┓              \n┃\u{1b}[1m \u{1b}[0m\u{1b}[1mReleased    \u{1b}[0m\u{1b}[1m \u{1b}[0m┃\u{1b}[1m \u{1b}[0m\u{1b}[1m             Title              \u{1b}[0m\u{1b}[1m \u{1b}[0m┃\u{1b}[1m \u{1b}[0m\u{1b}[1m            \u{1b}[0m\u{1b}[1m \u{1b}[0m┃              \n┡━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━┩              \n│ Dec 20, 2019 │ Star Wars: The Rise of Skywalker │ $952,110,690 │              \n└──────────────┴──────────────────────────────────┴──────────────┘              \n",
  )
}

