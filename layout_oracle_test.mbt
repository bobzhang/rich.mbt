    file.getvalue(),
    "\u{1b}[1m{\u{1b}[0m\u{1b}[1;34m\"dup\"\u{1b}[0m: \u{1b}[1;36m3\u{1b}[0m, \u{1b}[1;34m\"x\"\u{1b}[0m: \u{1b}[1;36m2\u{1b}[0m\u{1b}[1m}\u{1b}[0m\n",
  )
}

