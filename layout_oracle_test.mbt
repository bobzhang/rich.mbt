  )
  console.print("[#fe0000]x[/] [on #00fe00]y")
  assert_eq(
    file.getvalue(),
    "\u{1b}[38;5;196mx\u{1b}[0m \u{1b}[48;5;46my\u{1b}[0m\n",
  )
}

///|
test "oracle print link" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=40,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(
    "[link=https://example.com]click[/link] [link=https://x.org]x[/]",
  )
  assert_eq(
    normalize_link_ids(file.getvalue()),
    "\u{1b}]8;id=0;https://example.com\u{1b}\\click\u{1b}]8;;\u{1b}\\ \u{1b}]8;id=0;https://x.org\u{1b}\\x\u{1b}]8;;\u{1b}\\\n",
  )
}

