///|
test "oracle table row style and end_section" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=70,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let table = @rich.Table::new()
  table.add_column(header="Released", footer="Total", justify=Left)
  table.add_column(header="Title", footer="", justify=Center)
  table.add_column(header="Box Office", footer="$4,429,254,000", justify=Right)
  table.add_row(
    ["Dec 20, 2019", "Star Wars: The Rise of Skywalker", "$952,110,690"],
    style="on green",
  )
  table.add_row(
    ["May 25, 2018", "Solo: A Star Wars Story", "$393,151,347"],
    end_section=true,
  )
  table.add_row(
    ["Dec 15, 2017", "Star Wars Ep. V111: The Last Jedi", "$1,332,539,889"],
    style="italic",
  )
  table.add_row([
    "Dec 16, 2016", "Rogue One: A Star Wars Story", "$1,332,439,889",
  ])
  console.print(table)
  assert_eq(
    file.getvalue(),
