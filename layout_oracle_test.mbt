  assert_eq(
    file.getvalue(),
    "┏━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━┓\n┃\u{1b}[1m \u{1b}[0m\u{1b}[1mA                \u{1b}[0m\u{1b}[1m \u{1b}[0m┃\u{1b}[1m \u{1b}[0m\u{1b}[1mB               \u{1b}[0m\u{1b}[1m \u{1b}[0m┃\n┡━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━┩\n│ x                 │ \u{1b}[92m───── \u{1b}[0mmid\u{1b}[92m ──────\u{1b}[0m │\n│ y                 │ z                │\n└───────────────────┴──────────────────┘\n",
  )
}

