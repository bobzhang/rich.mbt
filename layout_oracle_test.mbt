///|
test "oracle print justify default overflow fold" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=40,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(
    "Lorem ipsum dolor sit amet, [bold]consectetur[/bold] adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Supercalifragilisticexpialidocious-and-even-longer-words",
    justify=Default,
    overflow=Fold,
  )
  assert_eq(
    file.getvalue(),
    "Lorem ipsum dolor sit amet, \u{1b}[1mconsectetur\u{1b}[0m \nadipiscing elit, sed do eiusmod tempor \nincididunt ut labore et dolore magna \naliqua. \nSupercalifragilisticexpialidocious-and-e\nven-longer-words\n",
  )
}

