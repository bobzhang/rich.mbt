///|
test "oracle align width height" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=30,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(
    @rich.Align::new(
      "hello",
      Center,
      width=10,
      height=3,
      vertical=Middle,
      style="on red",
    ),
  )
  assert_eq(
    file.getvalue(),
    "\u{1b}[41m          \u{1b}[0m\n\u{1b}[41m            \u{1b}[0m\u{1b}[41mhello\u{1b}[0m\u{1b}[41m             \u{1b}[0m\n\u{1b}[41m          \u{1b}[0m\n",
  )
}

///|
test "oracle align no pad" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=30,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(
    @rich.Align::new("hello", Center, pad=false, vertical=Bottom, height=3),
  )
  assert_eq(file.getvalue(), "\n\n            hello\n")
}

///|
test "oracle align table" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=30,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(
    {
      let table = @rich.Table::new()
      table.add_column(header="Released", footer="Total", justify=Left)
      table.add_row(["x"])
      @rich.Align::new(table, Right)
    },
  )
  assert_eq(
    file.getvalue(),
    "                  ┏━━━━━━━━━━┓\n                  ┃\u{1b}[1m \u{1b}[0m\u{1b}[1mReleased\u{1b}[0m\u{1b}[1m \u{1b}[0m┃\n                  ┡━━━━━━━━━━┩\n                  │ x        │\n                  └──────────┘\n",
  )
}

///|
test "oracle padding (0,) expand True style None" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=20,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(@rich.Padding::new("Hello\nWorld!", pad=[0], expand=true))
  assert_eq(file.getvalue(), "Hello               \nWorld!              \n")
}

///|
test "oracle padding (0,) expand True style on magenta" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=20,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(
    @rich.Padding::new(
      "Hello\nWorld!",
      pad=[0],
      expand=true,
      style="on magenta",
    ),
  )
  assert_eq(
    file.getvalue(),
    "\u{1b}[45mHello\u{1b}[0m\u{1b}[45m               \u{1b}[0m\n\u{1b}[45mWorld!\u{1b}[0m\u{1b}[45m              \u{1b}[0m\n",
  )
}

