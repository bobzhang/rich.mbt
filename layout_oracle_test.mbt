///|
test "oracle table box ASCII" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=70,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  let table = @rich.Table::new(box_=@rich.box_ascii, show_footer=true)
  table.add_column(header="Released", footer="Total", justify=Left)
  table.add_column(header="Title", footer="", justify=Center)
  table.add_column(header="Box Office", footer="$4,429,254,000", justify=Right)
  table.add_row([
    "Dec 20, 2019", "Star Wars: The Rise of Skywalker", "$952,110,690",
  ])
  table.add_row(["May 25, 2018", "Solo: A Star Wars Story", "$393,151,347"])
  console.print(table)
  assert_eq(
    file.getvalue(),
    "+------------------------------------------------------------------+\n|\u{1b}[1m \u{1b}[0m\u{1b}[1mReleased    \u{1b}[0m\u{1b}[1m \u{1b}[0m|\u{1b}[1m \u{1b}[0m\u{1b}[1m             Title              \u{1b}[0m\u{1b}[1m \u{1b}[0m|\u{1b}[1m \u{1b}[0m\u{1b}[1m    Box Office\u{1b}[0m\u{1b}[1m \u{1b}[0m|\n|--------------+----------------------------------+----------------|\n| Dec 20, 2019 | Star Wars: The Rise of Skywalker |   $952,110,690 |\n| May 25, 2018 |     Solo: A Star Wars Story      |   $393,151,347 |\n|--------------+----------------------------------+----------------|\n|\u{1b}[1m \u{1b}[0m\u{1b}[1mTotal       \u{1b}[0m\u{1b}[1m \u{1b}[0m|\u{1b}[1m \u{1b}[0m\u{1b}[1m                                \u{1b}[0m\u{1b}[1m \u{1b}[0m|\u{1b}[1m \u{1b}[0m\u{1b}[1m$4,429,254,000\u{1b}[0m\u{1b}[1m \u{1b}[0m|\n+------------------------------------------------------------------+\n",
