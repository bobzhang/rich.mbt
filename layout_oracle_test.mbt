///|
test "oracle rule style" {
  let file = @rich.StringIO::new()
  let console = @rich.Console::new(
    file~,
    width=20,
    color_system=Some("truecolor"),
    force_terminal=true,
    legacy_windows=false,
    environ={},
  )
  console.print(@rich.Rule::new(title="x", style="bold red", end=""))
  assert_eq(
    file.getvalue(),
    "\u{1b}[1;31m──────── \u{1b}[0mx\u{1b}[1;31m ─────────\u{1b}[0m",
  )
}

///|
