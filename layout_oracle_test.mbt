    record=true,
  )
  console.print(
    "[red]red[/] [#ff8800 on #002244]hex[/] [color(200)]c200[/] [on bright_green]bg[/] [default on default]def[/] [reverse red on blue]rb[/] [dim green]dg[/] [reverse]r2[/] [dim on red]dimbg[/] [bright_black]bb[/]",
  )
