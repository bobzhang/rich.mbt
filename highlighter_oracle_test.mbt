///|
test "json highlighter oracle" {
  let cases : Array[(String, Array[(Int, Int, String)])] = [
    (
      "{\n  \"name\": \"apple\",\n  \"count\": 1\n}",
      [
        (0, 1, "json.brace"),
        (4, 10, "json.str"),
        (12, 19, "json.str"),
        (23, 30, "json.str"),
        (32, 33, "json.number"),
        (34, 35, "json.brace"),
        (4, 10, "json.key"),
        (23, 30, "json.key"),
      ],
    ),
    (
      "[1, 2.5, -30000000000.0, true, false, null, \"s\"]",
      [
        (0, 1, "json.brace"),
        (1, 2, "json.number"),
        (4, 7, "json.number"),
        (9, 23, "json.number"),
        (25, 29, "json.bool_true"),
        (31, 36, "json.bool_false"),
        (38, 42, "json.null"),
        (44, 47, "json.str"),
        (47, 48, "json.brace"),
      ],
    ),
    (
      "{\n    \"nested\": {\n        \"a\": [\n            1,\n            {\n                \"b\": \"c\"\n            }\n        ]\n    }\n}",
      [
        (0, 1, "json.brace"),
        (6, 14, "json.str"),
        (16, 17, "json.brace"),
        (26, 29, "json.str"),
        (31, 32, "json.brace"),
        (45, 46, "json.number"),
        (60, 61, "json.brace"),
        (78, 81, "json.str"),
        (83, 86, "json.str"),
        (99, 100, "json.brace"),
        (109, 110, "json.brace"),
        (115, 116, "json.brace"),
        (117, 118, "json.brace"),
        (6, 14, "json.key"),
        (26, 29, "json.key"),
        (78, 81, "json.key"),
      ],
    ),
    (
      "{\"key with spaces\": \"value: colon\", \"k2\": \"\\\"quoted\\\"\"}",
      [
        (0, 1, "json.brace"),
        (1, 18, "json.str"),
        (20, 34, "json.str"),
        (36, 40, "json.str"),
        (42, 54, "json.str"),
        (54, 55, "json.brace"),
        (1, 18, "json.key"),
        (36, 40, "json.key"),
      ],
    ),
    (
      "{\"a\" : 1, \"b\"\n:\t2}",
      [
        (0, 1, "json.brace"),
        (1, 4, "json.str"),
        (7, 8, "json.number"),
        (10, 13, "json.str"),
        (16, 17, "json.number"),
        (17, 18, "json.brace"),
        (1, 4, "json.key"),
        (10, 13, "json.key"),
      ],
    ),
    ("\"just a string\"", [(0, 15, "json.str")]),
    ("123", [(0, 3, "json.number")]),
    ("null", [(0, 4, "json.null")]),
    (
      "{\"emoji\": \"😀\", \"unicode\": \"ünï\"}",
      [
        (0, 1, "json.brace"),
        (1, 8, "json.str"),
        (10, 14, "json.str"),
        (16, 25, "json.str"),
        (27, 32, "json.str"),
        (32, 33, "json.brace"),
        (1, 8, "json.key"),
        (16, 25, "json.key"),
      ],
    ),
    (
      "[\"a\", \"b\": \"c\"]",
      [
        (0, 1, "json.brace"),
        (1, 4, "json.str"),
        (6, 9, "json.str"),
        (11, 14, "json.str"),
        (14, 15, "json.brace"),
        (6, 9, "json.key"),
      ],
    ),
    (
      "{\"escaped \\\" quote\": 1}",
      [
        (0, 1, "json.brace"),
        (1, 19, "json.str"),
        (21, 22, "json.number"),
        (22, 23, "json.brace"),
        (1, 19, "json.key"),
      ],
    ),
  ]
  for case in cases {
    assert_eq(highlight_spans(JSON, case.0), case.1)
  }
}

