test "iso8601 highlighter oracle" {
  let cases : Array[(String, Array[(Int, Int, String)])] = [
    (
      "2008",
      [(0, 4, "iso8601.time"), (0, 2, "iso8601.hour"), (2, 4, "iso8601.minute")],
    ),
    ("2008-08", [(0, 4, "iso8601.year"), (5, 7, "iso8601.month")]),
    (
      "200808",
      [
        (0, 6, "iso8601.time"),
        (0, 2, "iso8601.hour"),
        (2, 4, "iso8601.minute"),
        (4, 6, "iso8601.second"),
      ],
    ),
    (
      "2008-08-30",
      [
        (0, 10, "iso8601.date"),
        (0, 4, "iso8601.year"),
        (5, 7, "iso8601.month"),
        (8, 10, "iso8601.day"),
      ],
    ),
    (
      "20080830",
      [
        (0, 8, "iso8601.date"),
        (0, 4, "iso8601.year"),
        (4, 6, "iso8601.month"),
        (6, 8, "iso8601.day"),
      ],
    ),
    (
      "2008-243",
      [(0, 8, "iso8601.date"), (0, 4, "iso8601.year"), (5, 8, "iso8601.day")],
    ),
    (
      "2008243",
      [(0, 7, "iso8601.date"), (0, 4, "iso8601.year"), (4, 7, "iso8601.day")],
    ),
    (
      "2008-W35",
      [(0, 8, "iso8601.date"), (0, 4, "iso8601.year"), (6, 8, "iso8601.week")],
    ),
    (
      "2008W35",
      [(0, 7, "iso8601.date"), (0, 4, "iso8601.year"), (5, 7, "iso8601.week")],
    ),
    (
      "2008-W35-6",
      [
        (0, 10, "iso8601.date"),
        (0, 4, "iso8601.year"),
        (6, 8, "iso8601.week"),
        (9, 10, "iso8601.day"),
      ],
    ),
    (
      "2008W356",
      [
        (0, 8, "iso8601.date"),
        (0, 4, "iso8601.year"),
        (5, 7, "iso8601.week"),
        (7, 8, "iso8601.day"),
      ],
    ),
    (
      "17:18",
