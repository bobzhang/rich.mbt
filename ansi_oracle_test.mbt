// Generated by scripts/gen_ansi_tests.py from the Python oracle.

///|
test "ansi decoder oracle cases" {
  let cases : Array[(String, Array[String])] = [
    ("plain", ["'plain' []"]),
    (
      "\u{1b}[1mbold\u{1b}[22m normal",
      ["'bold normal' [Span(0, 4, 'bold'), Span(4, 11, 'not bold not dim')]"],
    ),
    (
      "\u{1b}[2;3;4mdim italic underline\u{1b}[0m",
      ["'dim italic underline' [Span(0, 20, 'dim italic underline')]"],
    ),
    (
      "\u{1b}[38;5;196mred256\u{1b}[39m default",
      ["'red256 default' [Span(0, 6, 'color(196)'), Span(6, 14, 'default')]"],
    ),
    ("\u{1b}[48;5;21mbg\u{1b}[49m", ["'bg' [Span(0, 2, 'on color(21)')]"]),
    (
      "\u{1b}[38;2;10;20;30mrgb\u{1b}[48;2;1;2;3mboth\u{1b}[m",
      ["'rgbboth' [Span(0, 3, '#0a141e'), Span(3, 7, '#0a141e on #010203')]"],
    ),
    (
      "\u{1b}[90mbright\u{1b}[107mon bright white\u{1b}[0m",
      [
        "'brighton bright white' [Span(0, 6, 'color(8)'), Span(6, 21, 'color(8) on color(15)')]",
      ],
    ),
    (
      "\u{1b}[31;1mred bold\u{1b}[0;32mgreen",
      ["'red boldgreen' [Span(0, 8, 'bold color(1)'), Span(8, 13, 'color(2)')]"],
    ),
    (
      "\u{1b}[1;;3mreset in middle",
      ["'reset in middle' [Span(0, 15, 'italic')]"],
    ),
    ("\u{1b}[38;5mtruncated", ["'truncated' []"]),
    ("\u{1b}[38;2;1;2mtruncated rgb", ["'truncated rgb' []"]),
    ("\u{1b}[999mbig code", ["'big code' []"]),
    (
      "\u{1b}[5;6;7;8;9;21mattrs\u{1b}[25;26;27;28;29;24;23m off",
      [
        "'attrs off' [Span(0, 5, 'blink blink2 reverse conceal strike underline2'), Span(5, 9, 'not italic not underline not blink not blink2 not reverse not conceal not strike underline2')]",
      ],
    ),
    (
      "\u{1b}[51;52;53mframe\u{1b}[54;55m",
      ["'frame' [Span(0, 5, 'frame encircle overline')]"],
    ),
    (
      "\u{1b}]8;id=1;https://example.org\u{1b}\\link\u{1b}]8;;\u{1b}\\ nolink",
      [
        "'link nolink' [Span(0, 4, 'link https://example.org'), Span(4, 11, 'none')]",
      ],
    ),
    (
      "\u{1b}]8;;http://a.b\u{1b}\\x\u{1b}]8;;\u{1b}\\",
      ["'x' [Span(0, 1, 'link http://a.b')]"],
    ),
    ("\u{1b}]0;title\u{1b}\\after osc", ["'after osc' []"]),
    ("abc\u{d}def", ["'def' []"]),
    ("line1\nline2\u{d}\nline3", ["'line1' []", "'' []", "'line3' []"]),
    (
      "\u{1b}[1mmulti\nline\u{1b}[0m\nend",
      [
        "'multi' [Span(0, 5, 'bold')]", "'line' [Span(0, 4, 'bold')]", "'end' []",
      ],
    ),
    ("\u{1b}[Kerase\u{1b}[2Jclear\u{1b}[?25lcursor", ["'eraseclearcursor' []"]),
    ("\u{1b}7save\u{1b}8restore", ["'saverestore' []"]),
    (
      "\u{1b}[31m😀 emoji\u{1b}[0m 你好",
      ["'😀 emoji 你好' [Span(0, 8, 'color(1)')]"],
    ),
    ("\u{1b}[38;5;256mclamped", ["'clamped' [Span(0, 7, 'color(255)')]"]),
    ("\u{1b}[1;x;3mjunk codes", ["';3mjunk codes' []"]),
    (
      "\u{1b}[30;40mblack\u{1b}[37;47mwhite",
      [
        "'blackwhite' [Span(0, 5, 'color(0) on color(0)'), Span(5, 10, 'color(7) on color(7)')]",
      ],
    ),
    ("\u{1b}[4:3mcolon", ["'colon' []"]),
    ("text\u{1b}", ["'text\\x1b' []"]),
    ("\u{1b}[", ["'\\x1b[' []"]),
    ("\u{1b}[1m\u{1b}[0m", ["'' []"]),
  ]
  for case in cases {
    let decoder = @rich.AnsiDecoder::new()
    assert_eq(decoder.decode(case.0).map(ansi_text_repr), case.1)
  }
}
