    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 68 \u{1b}[0m\u{1b}[94mdef\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[92mfile_syntax_error\u{1b}[0m():                                                                   \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u{1b}[0m\n" +
    "\u{1b}[91m╭──────────────────────────────────────────────────────────────────────────────────────────────────╮\u{1b}[0m\n" +
    "\u{1b}[91m│\u{1b}[0m \u{1b}[1m(\u{1b}[0m\u{1b}[1;36m2\u{1b}[0m+\u{1b}[1;36m2\u{1b}[0m                                                                                             \u{1b}[91m│\u{1b}[0m\n" +
    "\u{1b}[91m│\u{1b}[0m \u{1b}[1;91m▲\u{1b}[0m                                                                                                \u{1b}[91m│\u{1b}[0m\n" +
    "\u{1b}[91m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u{1b}[0m\n" +
    "\u{1b}[1;91mSyntaxError: \u{1b}[0m\u{1b}[32m'\u{1b}[0m\u{1b}[32m(\u{1b}[0m\u{1b}[32m'\u{1b}[0m was never closed\n"
  assert_eq(file.getvalue(), expected)
}

