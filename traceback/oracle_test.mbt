  "    except BaseException:\n" +
  "        return sys.exc_info()\n" +
  "\n" +
  "\n" +
  "def divide(a, b):\n" +
  "    return a / b\n" +
  "\n" +
  "\n" +
  "def level2(x):\n" +
  "    total = x * 2\n" +
  "    return divide(total, 0)\n" +
  "\n" +
  "\n" +
  "def level1():\n" +
  "    data = {\"key\": [1, 2, 3], \"name\": \"value\"}\n" +
  "    flag = True\n" +
  "    return level2(21)\n" +
  "\n" +
  "\n" +
  "def zero_division():\n" +
