  let data : String = "{\"stacks\": [{\"exc_type\": \"SyntaxError\", \"exc_value\": \"invalid syntax (bad.py, line 1)\", \"syntax_error\": {\"offset\": 5, \"filename\": \"/project/bad.py\", \"line\": \"x = = 1\\n\", \"lineno\": 1, \"msg\": \"invalid syntax\", \"notes\": []}, \"is_cause\": false, \"frames\": [{\"filename\": \"/project/app.py\", \"lineno\": 8, \"name\": \"capture\", \"line\": \"\", \"locals\": null, \"last_instruction\": [[10, 8], [10, 29]]}, {\"filename\": \"/project/app.py\", \"lineno\": 69, \"name\": \"file_syntax_error\", \"line\": \"\", \"locals\": null, \"last_instruction\": [[69, 4], [69, 51]]}], \"notes\": [], \"is_group\": false, \"exceptions\": []}]}"
  let trace = @traceback.Trace::from_json(@json.parse(data))
  let (console, file) = oracle_console(
    width=100,
    color_system=Some("truecolor"),
  )
  console.print(@traceback.Traceback::new(trace, source_reader=read_source))
  let expected : String = "\u{1b}[31m╭─\u{1b}[0m\u{1b}[31m──────────────────────────────\u{1b}[0m\u{1b}[31m \u{1b}[0m\u{1b}[1;31mTraceback \u{1b}[0m\u{1b}[1;2;31m(most recent call last)\u{1b}[0m\u{1b}[31m \u{1b}[0m\u{1b}[31m───────────────────────────────\u{1b}[0m\u{1b}[31m─╮\u{1b}[0m\n" +
