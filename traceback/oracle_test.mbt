test "oracle 5: syntax_error {} {} {'width': 100, 'color_system': 'truecolor'}" {
  let data : String = "{\"stacks\": [{\"exc_type\": \"SyntaxError\", \"exc_value\": \"'(' was never closed (<string>, line 1)\", \"syntax_error\": {\"offset\": 1, \"filename\": \"<string>\", \"line\": \"(2+2\", \"lineno\": 1, \"msg\": \"'(' was never closed\", \"notes\": []}, \"is_cause\": false, \"frames\": [{\"filename\": \"/project/app.py\", \"lineno\": 8, \"name\": \"capture\", \"line\": \"\", \"locals\": null, \"last_instruction\": [[10, 8], [10, 29]]}, {\"filename\": \"/project/app.py\", \"lineno\": 65, \"name\": \"syntax_error\", \"line\": \"\", \"locals\": null, \"last_instruction\": [[65, 4], [65, 16]]}], \"notes\": [], \"is_group\": false, \"exceptions\": []}]}"
  let trace = @traceback.Trace::from_json(@json.parse(data))
  let (console, file) = oracle_console(
    width=100,
    color_system=Some("truecolor"),
  )
  console.print(@traceback.Traceback::new(trace, source_reader=read_source))
  let expected : String = "\u{1b}[31m╭─\u{1b}[0m\u{1b}[31m──────────────────────────────\u{1b}[0m\u{1b}[31m \u{1b}[0m\u{1b}[1;31mTraceback \u{1b}[0m\u{1b}[1;2;31m(most recent call last)\u{1b}[0m\u{1b}[31m \u{1b}[0m\u{1b}[31m───────────────────────────────\u{1b}[0m\u{1b}[31m─╮\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m \u{1b}[2m/project/\u{1b}[0m\u{1b}[1mapp.py\u{1b}[0m:8 in capture                                                                     \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m                                                                                                  \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m  5 \u{1b}[0m                                                                                           \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m  6 \u{1b}[0m\u{1b}[94mdef\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[92mcapture\u{1b}[0m(name):                                                                         \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m  7 \u{1b}[0m\u{1b}[2m│   \u{1b}[0m\u{1b}[94mtry\u{1b}[0m:                                                                                   \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m \u{1b}[31m❱ \u{1b}[0m  8 \u{1b}[2m│   │   \u{1b}[0m\u{1b}[96mglobals\u{1b}[0m()[name]()                                                                  \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m  9 \u{1b}[0m\u{1b}[2m│   \u{1b}[0m\u{1b}[94mexcept\u{1b}[0m \u{1b}[96mBaseException\u{1b}[0m:                                                                  \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 10 \u{1b}[0m\u{1b}[2m│   │   \u{1b}[0m\u{1b}[1;4;94mreturn\u{1b}[0m\u{1b}[1;4m sys.exc_info()\u{1b}[0m                                                              \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 11 \u{1b}[0m                                                                                           \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m                                                                                                  \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m \u{1b}[2m/project/\u{1b}[0m\u{1b}[1mapp.py\u{1b}[0m:65 in syntax_error                                                               \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m                                                                                                  \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 62 \u{1b}[0m                                                                                           \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 63 \u{1b}[0m                                                                                           \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 64 \u{1b}[0m\u{1b}[94mdef\u{1b}[0m\u{1b}[90m \u{1b}[0m\u{1b}[92msyntax_error\u{1b}[0m():                                                                        \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m \u{1b}[31m❱ \u{1b}[0m 65 \u{1b}[2m│   \u{1b}[0m\u{1b}[1;4;96meval\u{1b}[0m\u{1b}[1;4m(\u{1b}[0m\u{1b}[1;4;33m\"\u{1b}[0m\u{1b}[1;4;33m(2+2\u{1b}[0m\u{1b}[1;4;33m\"\u{1b}[0m\u{1b}[1;4m)\u{1b}[0m                                                                           \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 66 \u{1b}[0m                                                                                           \u{1b}[31m│\u{1b}[0m\n" +
