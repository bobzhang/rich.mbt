  let expected : String = "\u{1b}[31m╭─\u{1b}[0m\u{1b}[31m────────────────────\u{1b}[0m\u{1b}[31m \u{1b}[0m\u{1b}[38;2;123;234;123mTraceback \u{1b}[0m\u{1b}[2;38;2;123;234;123m(most recent call last)\u{1b}[0m\u{1b}[31m \u{1b}[0m\u{1b}[31m─────────────────────\u{1b}[0m\u{1b}[31m─╮\u{1b}[0m\n" +
