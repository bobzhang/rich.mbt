    "\u{1b}[31m│\u{1b}[0m \u{1b}[31m❱ \u{1b}[0m 52 \u{1b}[2m│   │   \u{1b}[0m\u{1b}[1;4;94mraise\u{1b}[0m\u{1b}[1;4m \u{1b}[0m\u{1b}[1;4;96mRecursionError\u{1b}[0m\u{1b}[1;4m(\u{1b}[0m\u{1b}[1;4;33m\"\u{1b}[0m\u{1b}[1;4;33mmaximum recursion depth exceeded\u{1b}[0m\u{1b}[1;4;33m\"\u{1b}[0m\u{1b}[1;4m)\u{1b}[0m                           \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 53 \u{1b}[0m\u{1b}[2m│   \u{1b}[0m\u{1b}[94mreturn\u{1b}[0m recursive2(n + \u{1b}[94m1\u{1b}[0m)                                                               \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 54 \u{1b}[0m                                                                                           \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m│\u{1b}[0m   \u{1b}[2m 55 \u{1b}[0m                                                                                           \u{1b}[31m│\u{1b}[0m\n" +
    "\u{1b}[31m╰──────────────────────────────────────────────────────────────────────────────────────────────────╯\u{1b}[0m\n" +
    "\u{1b}[1;91mRecursionError: \u{1b}[0mmaximum recursion depth exceeded\n"
  assert_eq(file.getvalue(), expected)
}

