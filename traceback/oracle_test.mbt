  "\n" +
  "\n" +
  "def no_message():\n" +
  "    raise RuntimeError\n" +
  "\n" +
  "\n" +
  "def nested():\n" +
  "    try:\n" +
  "        level1()\n" +
  "    except ZeroDivisionError:\n" +
  "        raise ValueError(\"ValueError because of ZeroDivisionError\")\n" +
  "\n" +
  "\n" +
  "def caused():\n" +
  "    try:\n" +
  "        level1()\n" +
  "    except ZeroDivisionError as e:\n" +
