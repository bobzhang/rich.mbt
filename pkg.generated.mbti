// Type aliases

// Traits
pub(open) trait ConsoleFile {
  fn write(Self, String) -> Unit raise
  fn flush(Self) -> Unit raise = _
  fn isatty(Self) -> Bool = _
  fn encoding(Self) -> String = _
}

pub(open) trait Highlighter {
  fn highlight(Self, Text) -> Unit raise
}
pub fn &Highlighter::apply(Self, &IntoText) -> Text raise

pub(open) trait IntoColumn {
  fn into_column(Self) -> Column
  fn into_table_column(Self, highlight~ : Bool) -> Column = _
}
pub impl IntoColumn for String

pub(open) trait IntoStyle {
  fn into_style_type(Self) -> StyleType
}
pub impl IntoStyle for String

pub(open) trait IntoText {
  fn into_text_type(Self) -> TextType
}
pub impl IntoText for String

pub(open) trait Pager {
  fn show(Self, String) -> Unit raise
}

pub(open) trait RenderHook {
  fn process_renderables(Self, Array[&Renderable]) -> Array[&Renderable] raise
}

pub(open) trait Renderable {
  fn rich_console(Self, Console, ConsoleOptions) -> Array[RenderItem] raise
  fn rich_measure(Self, Console, ConsoleOptions) -> Measurement? raise = _
  fn text_kind(Self) -> TextKind = _
  fn vertical_align(Self) -> VerticalAlignMethod? = _
}
pub impl Renderable for String
pub impl Renderable for @color.Color
pub impl Renderable for @color.Palette

pub(open) trait TextPart {
  fn append_to(Self, Text) -> Unit
}
pub impl TextPart for String
pub impl[S : IntoStyle] TextPart for (String, S)
